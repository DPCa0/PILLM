```javascript
class AsyncProcessor {
  constructor(data) {
    this.data = data;
  }

  async *generateChunks() {
    for (let i = 0; i < this.data.length; i += 2) {
      yield new Promise((resolve) =>
        setTimeout(() => resolve(this.data.slice(i, i + 2)), 500)
      );
    }
  }

  async processData() {
    const results = [];
    for await (const chunkPromise of this.generateChunks()) {
      const chunk = await chunkPromise;
      const transformedChunk = chunk.map((item) =>
        item.toUpperCase().split('').reverse().join('')
      );
      results.push(...transformedChunk);
    }
    return results;
  }
}

(async () => {
  const data = ['hello', 'world', 'advanced', 'javascript', 'features'];
  const processor = new AsyncProcessor(data);
  const result = await processor.processData();
  console.log(result);
})();
