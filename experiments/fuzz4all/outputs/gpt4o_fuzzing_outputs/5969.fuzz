```javascript
 
async function fetchDataAndProcess() {
   
  console.log(`Fetching data at ${new Date().toLocaleTimeString()}`);

  try {
     
    let response = await fetch('https://jsonplaceholder.typicode.com/todos');
    let data = await response.json();

     
    const processedData = data.map(({ userId, id, title, completed }) => ({
      userId,
      id,
      title: title.toUpperCase(),  
      isCompleted: completed
    }));

     
    const enrichedData = processedData.map(item => ({
      ...item,
      timeStamp: new Date().toISOString()
    }));

     
    const uniqueUserIds = new Set(enrichedData.map(item => item.userId));

     
    const completedCount = enrichedData.reduce((count, item) => {
      return item.isCompleted ? count + 1 : count;
    }, 0);

     
    console.log(`Data Processed:
      Unique User IDs: ${[...uniqueUserIds]}
      Completed Tasks: ${completedCount}
    `);
  } catch (error) {
    console.error(`An error occurred: ${error.message}`);
  }
}

 
(async () => {
  await fetchDataAndProcess();
})();
```