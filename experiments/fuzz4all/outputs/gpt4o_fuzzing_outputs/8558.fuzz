```javascript
class ComplexDataProcessor {
  #data;
  
  constructor(data) {
    this.#data = data;
  }

  async processData() {
    const promises = this.#data.map(async (item, index) => {
      const processed = await this.#complexCalculation(item, index);
      return { original: item, processed };
    });
    
    const results = await Promise.allSettled(promises);
    return results.filter(result => result.status === 'fulfilled').map(result => result.value);
  }

  #complexCalculation(item, index) {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (index % 2 === 0) {
          resolve(item * 2);
        } else {
          reject(new Error('Odd index error'));
        }
      }, 1000);
    });
  }
}

(async () => {
  const data = [1, 2, 3, 4, 5];
  const processor = new ComplexDataProcessor(data);
  
  try {
    const results = await processor.processData();
    console.log('Processed Data:', results);
  } catch (error) {
    console.error('Processing error:', error);
  }
})();
```