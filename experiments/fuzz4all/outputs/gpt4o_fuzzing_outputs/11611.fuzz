print('Hello, world!');
```javascript
 
async function fetchData(url) {
    const response = await fetch(url);
    const data = await response.json();
    return data;
}

const url = 'https://jsonplaceholder.typicode.com/posts';

fetchData(url).then(data => {
     
    const posts = data.map(({ userId, id, title, body }) => ({
        userId,
        id,
        title,
        body
    }));

     
    const postsByUser = new Map();
    posts.forEach(post => {
        if (!postsByUser.has(post.userId)) {
            postsByUser.set(post.userId, []);
        }
        postsByUser.get(post.userId).push(post);
    });

     
    for (const [userId, userPosts] of postsByUser.entries()) {
        console.log(`User ${userId} has posts:`);
        userPosts.forEach(({ id, title }) => {
            console.log(`  Post ${id}: ${title}`);
        });
    }
}).catch(error => console.error('Error fetching data:', error));
```