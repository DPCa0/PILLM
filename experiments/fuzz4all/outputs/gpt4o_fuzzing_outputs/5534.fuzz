```javascript
 

 
const simulateApiCall = (url, delay) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      Math.random() > 0.2 ? resolve(`Fetched data from ${url}`) : reject(`Failed to fetch ${url}`);
    }, delay);
  });
};

 
const fetchDataFromApis = async () => {
  const apiUrls = [
    { url: 'https://api.example.com/data1', delay: 1000 },
    { url: 'https://api.example.com/data2', delay: 2000 },
    { url: 'https://api.example.com/data3', delay: 1500 }
  ];

  try {
    const results = await Promise.allSettled(apiUrls.map(({ url, delay }) => simulateApiCall(url, delay)));

    const data = results.map(({ status, value, reason }, index) => {
      if (status === 'fulfilled') {
        return { [apiUrls[index].url]: value };
      } else {
        return { [apiUrls[index].url]: reason };
      }
    });

    console.log('API fetch results:', data);
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

 
(async () => {
  await fetchDataFromApis();
})();
```