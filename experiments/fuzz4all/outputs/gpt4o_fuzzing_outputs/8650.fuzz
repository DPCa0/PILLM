class DataPipeline {
  constructor(data) {
    this.data = data;
  }

  static async fetchData(url) {
    const response = await fetch(url);
    return response.json();
  }

  *filterData(predicate) {
    for (const item of this.data) {
      if (predicate(item)) {
        yield item;
      }
    }
  }

  mapData(transform) {
    return new DataPipeline(this.data.map(transform));
  }

  reduceData(reducer, initialValue) {
    return this.data.reduce(reducer, initialValue);
  }

  async processAsync(asyncFunc) {
    const results = await Promise.all(this.data.map(asyncFunc));
    return new DataPipeline(results);
  }
}

(async () => {
  try {
    const rawData = await DataPipeline.fetchData('https://jsonplaceholder.typicode.com/posts');
    const pipeline = new DataPipeline(rawData);

    const filteredData = Array.from(pipeline.filterData(post => post.userId === 1));
    const mappedData = pipeline.mapData(post => ({ ...post, title: post.title.toUpperCase() }));
    const reducedData = mappedData.reduceData((acc, post) => acc + post.title.length, 0);

    const processedData = await mappedData.processAsync(async post => {
      return { ...post, fetchedComments: await DataPipeline.fetchData(`https: 
    });

    console.log('Filtered Data:', filteredData);
    console.log('Mapped Data:', mappedData.data);
    console.log('Reduced Data:', reducedData);
    console.log('Processed Data:', processedData.data);
  } catch (error) {
    console.error('An error occurred:', error);
  }
})();
