class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) this.events.set(event, []);
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (!this.events.has(event)) return;
    for (const listener of this.events.get(event)) {
      listener(...args);
    }
  }

  once(event, listener) {
    const onceListener = (...args) => {
      listener(...args);
      this.off(event, onceListener);
    };
    this.on(event, onceListener);
  }

  off(event, listener) {
    if (!this.events.has(event)) return;
    this.events.set(event, this.events.get(event).filter(l => l !== listener));
  }
}

const asyncOperation = (result, delay = 1000) => 
  new Promise(resolve => setTimeout(() => resolve(result), delay));

async function* generator() {
  yield await asyncOperation('Step 1 Completed');
  yield await asyncOperation('Step 2 Completed');
  yield await asyncOperation('Step 3 Completed');
}

(async () => {
  const eventEmitter = new EventEmitter();

  eventEmitter.on('stepCompleted', message => console.log(message));
  eventEmitter.once('done', () => console.log('All steps completed'));

  for await (const message of generator()) {
    eventEmitter.emit('stepCompleted', message);
  }

  eventEmitter.emit('done');
})();
