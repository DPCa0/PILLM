import fetch from 'node-fetch';

 
(async () => {
     
    const params = new URLSearchParams({
        userId: 1,
    });

    try {
         
        const response = await fetch(`https: 
        const posts = await response.json();

         
        const titles = posts.map(({ title }) => title);
        console.log(`Titles of posts by user 1:\n${titles.join('\n')}`);

         
        const uniqueWords = new Set(titles.flatMap(title => title.split(' ')));
        console.log(`Unique words in titles:\n${[...uniqueWords].join(', ')}`);

         
        const wordFrequency = titles.flatMap(title => title.split(' '))
            .reduce((acc, word) => {
                acc[word] = (acc[word] || 0) + 1;
                return acc;
            }, {});

        console.log('Word frequencies:', wordFrequency);

         
        const firstWordFreq = wordFrequency?.[Object.keys(wordFrequency)[0]] ?? 'N/A';
        console.log(`Frequency of the first word: ${firstWordFreq}`);
    } catch (error) {
        console.error('Error fetching posts:', error);
    }
})();
