print('Hello, world!');
```javascript
 

 
async function fetchData() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve(['Apple', 'Banana', 'Cherry']);
        }, 1000);
    });
}

 
const loggerHandler = {
    get(target, prop) {
        if (prop in target) {
            console.log(`Accessing property '${prop}': ${target[prop]}`);
            return target[prop];
        } else {
            console.log(`Property '${prop}' does not exist.`);
            return undefined;
        }
    },
    set(target, prop, value) {
        console.log(`Setting property '${prop}' to ${value}`);
        target[prop] = value;
        return true;
    }
};

const fruits = new Proxy({}, loggerHandler);

 
(async () => {
    const fetchedData = await fetchData();
    const [firstFruit, ...otherFruits] = fetchedData;  

    console.log(`First fruit: ${firstFruit}`);
    
    const fruitsMap = new Map();
    fruitsMap.set('favorite', firstFruit);
    fruitsMap.set('others', otherFruits);

    for (const [key, value] of fruitsMap) {
        console.log(`${key}: ${value}`);
    }

    const fruitSet = new Set(fetchedData);
    fruitSet.add('Banana');  
    
    console.log('Unique fruits:', fruitSet);

    fruitsMap.forEach((value, key) => {
        fruits[key] = value;  
    });

    console.log('Final Fruits:', fruits);
})();
```