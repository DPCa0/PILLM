```javascript
 
const fetchData = async (...urls) => {
  try {
     
    const responses = await Promise.all(urls.map(url => fetch(url)));
     
    const data = await Promise.all(responses.map(response => response.json()));

     
    const summary = data.reduce((acc, item, index) => {
      acc[`DataFromURL${index + 1}`] = item;
      return acc;
    }, {});

     
    if (Object.keys(summary).length > 0) {
      const { analyzeData } = await import('./analyzeData.js');
      const analysis = analyzeData(summary);
      console.log('Data Analysis:', analysis);
    }
  } catch (error) {
     
    console.error(`An error occurred: ${error.message}`);
  }
};

 
fetchData('https://api.example.com/data1', 'https://api.example.com/data2')
  ?.catch(error => console.error(`Fetch failed: ${error?.message ?? 'Unknown Error'}`));
```