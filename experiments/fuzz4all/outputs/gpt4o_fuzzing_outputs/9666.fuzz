```javascript
 

 
function fetchData() {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve({
        user: { name: 'Alice', age: 30 },
        posts: [
          { title: 'Async JavaScript', likes: 20 },
          { title: 'Understanding Promises', likes: 15 }
        ]
      });
    }, 2000);
  });
}

async function displayUserData() {
  try {
     
    const { user, posts } = await fetchData();

     
    const { name, age } = user;
    
     
    console.log(`User Info:
    Name: ${name}
    Age: ${age}`);
    
     
    posts.forEach(({ title, likes }) => {
      console.log(`Title: "${title}", Likes: ${likes}`);
    });
    
  } catch (error) {
    console.error('Error fetching data:', error);
  }
}

 
displayUserData();
```