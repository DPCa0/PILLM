```javascript
 

 
export function add(a, b) {
  return a + b;
}

 
export const capitalize = str => str.charAt(0).toUpperCase() + str.slice(1);

 
import { add } from './mathOperations.js';
import { capitalize } from './stringOperations.js';

 
class Calculator {
  static multiply(a, b) {
    return a * b;
  }

  constructor(value) {
    this.value = value;
  }

  divide(num) {
    if (num === 0) throw new Error("Cannot divide by zero");
    this.value /= num;
    return this;
  }
}

 
function* numberSequence() {
  let num = 0;
  while (true) yield num++;
}

 
const target = {
  message1: "Hello",
  message2: "World"
};

const handler = {
  get: (obj, prop) => prop in obj ? obj[prop] : "Property does not exist"
};

const proxy = new Proxy(target, handler);

 
async function fetchData(url) {
  try {
    let response = await fetch(url);
    let data = await response.json();
    return data;
  } catch (error) {
    console.error('Error fetching data:', error);
  }
}

 
const user = { name: "John Doe", age: 30, email: "johndoe@example.com" };
const { name, email } = user;

 
(async () => {
   
  let data = await fetchData('https://jsonplaceholder.typicode.com/posts/1');
  console.log('Fetched Data:', data);

   
  const calc = new Calculator(10);
  console.log('Division Result:', calc.divide(2).value);

   
  console.log('Proxy Example:', proxy.message1, proxy.message3);

   
  const gen = numberSequence();
  console.log('Generator Output:', gen.next().value, gen.next().value);

   
  console.log('Add Result:', add(5, 3));
  console.log('Capitalize Result:', capitalize