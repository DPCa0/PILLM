```javascript
class Observer {
  constructor() {
    this.subscribers = new Map();
  }
  
  subscribe(event, fn) {
    if (!this.subscribers.has(event)) {
      this.subscribers.set(event, []);
    }
    this.subscribers.get(event).push(fn);
  }
  
  unsubscribe(event, fn) {
    if (this.subscribers.has(event)) {
      this.subscribers.set(event, this.subscribers.get(event).filter(sub => sub !== fn));
    }
  }
  
  notify(event, data) {
    if (this.subscribers.has(event)) {
      this.subscribers.get(event).forEach(fn => fn(data));
    }
  }
}

const observer = new Observer();

const logData = (data) => console.log(`Logged: ${data}`);
const transformData = (data) => console.log(`Transformed: ${data.toUpperCase()}`);

observer.subscribe('dataReceived', logData);
observer.subscribe('dataReceived', transformData);

async function fetchData() {
  try {
    const response = await fetch('https://jsonplaceholder.typicode.com/posts/1');
    const data = await response.json();
    observer.notify('dataReceived', data.title);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
}

fetchData();

setTimeout(() => {
  observer.unsubscribe('dataReceived', transformData);
  observer.notify('dataReceived', 'Some additional data');
}, 5000);
```