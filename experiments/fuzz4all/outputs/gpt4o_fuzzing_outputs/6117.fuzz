```javascript
 
import fetch from 'node-fetch';

 
(async function fetchData() {
    try {
         
        const response = await fetch('https://jsonplaceholder.typicode.com/posts');
        const posts = await response.json();

         
        posts.slice(0, 5).forEach(({ id, title, body }) => {
            console.log(`Post ID: ${id}\nTitle: ${title}\nBody: ${body}\n`);
        });

         
        const userIds = new Set(posts.map(post => post.userId));
        console.log(`Unique User IDs: ${[...userIds].join(', ')}`);

         
        const postsByUser = new Map();
        posts.forEach(post => {
            if (!postsByUser.has(post.userId)) {
                postsByUser.set(post.userId, []);
            }
            postsByUser.get(post.userId).push(post.title);
        });

         
        userIds.forEach(userId => {
            console.log(`User ${userId} Posts:`);
            console.log(postsByUser.get(userId)?.join(', ') || 'No posts found');
        });

    } catch (error) {
         
        console.error(`Failed to fetch data: ${error.message}`);
    }
})();
```