print('Hello, world!');
```javascript
 

class Complex {
    constructor(value) {
        this._value = value;
    }

    async double() {
         
        return new Promise((resolve) => {
            setTimeout(() => resolve(this._value * 2), 1000);
        });
    }
}

const handler = {
    get: (target, property, receiver) => {
        if (property === 'value') {
            console.log(`Accessing value: ${Reflect.get(target, '_value')}`);
            return Reflect.get(target, '_value');
        }
        return Reflect.get(target, property, receiver);
    },
    set: (target, property, value, receiver) => {
        if (property === 'value') {
            console.log(`Setting value: ${value}`);
            return Reflect.set(target, '_value', value, receiver);
        }
        return Reflect.set(target, property, value, receiver);
    }
};

const complexObject = new Proxy(new Complex(10), handler);

(async function() {
    console.log(`Original value: ${complexObject.value}`);
    complexObject.value = await complexObject.double();
    console.log(`Doubled value: ${complexObject.value}`);
})();
```