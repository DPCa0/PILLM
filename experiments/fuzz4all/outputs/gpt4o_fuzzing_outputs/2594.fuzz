```javascript
 

class ApiService {
  constructor(baseUrl) {
    this.baseUrl = baseUrl;
  }

  async fetchData(endpoint) {
    const response = await fetch(`${this.baseUrl}${endpoint}`);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    return data;
  }
}

const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

async function fetchWithRetry(apiService, endpoint, retries = 3) {
  for (let i = 0; i < retries; i++) {
    try {
      const data = await apiService.fetchData(endpoint);
      console.log('Data fetched successfully:', data);
      return data;
    } catch (error) {
      console.error(`Attempt ${i + 1} failed. Retrying in 1 second...`);
      await delay(1000);
    }
  }
  throw new Error('All retries failed');
}

const [endpoint] = ['/data'];
const apiService = new ApiService('https://jsonplaceholder.typicode.com');

(async () => {
  try {
    const data = await fetchWithRetry(apiService, endpoint);
    const { title, body } = data;
    console.log(`Title: ${title}\nBody: ${body}`);
  } catch (error) {
    console.error('Failed to fetch data:', error);
  }
})();
```