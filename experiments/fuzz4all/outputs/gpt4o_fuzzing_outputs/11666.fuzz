```javascript
 
import fetch from 'node-fetch';
import { promises as fsPromises } from 'fs';

 
(async () => {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();

     
    const wordCount = data.reduce((acc, post) => {
      const words = post.body.split(/\s+/).length;
      acc.push({ id: post.id, wordCount: words });
      return acc;
    }, []);

     
    const uniqueIds = new Set(data.map(post => post.userId));

     
    await Promise.all([
      fsPromises.writeFile('posts.json', JSON.stringify(data, null, 2)),
      fsPromises.writeFile('word_count.json', JSON.stringify(wordCount, null, 2)),
      fsPromises.writeFile('unique_ids.json', JSON.stringify([...uniqueIds], null, 2))
    ]);

    console.log('Files written successfully!');
  } catch (error) {
    console.error('Error:', error);
  }
})();
```