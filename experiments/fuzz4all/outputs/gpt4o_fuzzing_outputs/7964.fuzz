class Fibonacci {
  constructor(limit) {
    this.limit = limit;
    this.memo = new Map();
  }

  *[Symbol.iterator]() {
    let [a, b] = [0, 1];
    for (let i = 0; i < this.limit; i++) {
      [a, b] = [b, a + b];
      yield a;
    }
  }

  static memoizedFib(n, memo = new Map()) {
    if (n <= 1) return n;
    if (memo.has(n)) return memo.get(n);
    let result = Fibonacci.memoizedFib(n - 1, memo) + Fibonacci.memoizedFib(n - 2, memo);
    memo.set(n, result);
    return result;
  }
}

const fetchAndLog = async (url) => {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    console.log(`Fetched data: ${JSON.stringify(data)}`);
  } catch (error) {
    console.error('Fetching error:', error);
  }
};

const fibSequence = new Fibonacci(10);
const fibValues = [...fibSequence];
console.log('Fibonacci Sequence:', fibValues);

const memoizedValue = Fibonacci.memoizedFib(10);
console.log('Memoized Fibonacci:', memoizedValue);

const fetchUrl = 'https://jsonplaceholder.typicode.com/todos/1';
fetchAndLog(fetchUrl);
