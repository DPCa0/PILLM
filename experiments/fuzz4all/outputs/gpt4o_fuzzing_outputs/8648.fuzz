```javascript
const crypto = require('crypto');

class ComplexSystem {
  #secretKey;
  
  constructor() {
    this.#secretKey = crypto.randomBytes(32).toString('hex');
    this.data = new Map();
  }

  async fetchData(url) {
    const response = await fetch(url);
    const data = await response.json();
    this.#secureDataProcessing(data);
  }

  #secureDataProcessing(data) {
    const hash = crypto.createHmac('sha256', this.#secretKey)
                       .update(JSON.stringify(data))
                       .digest('hex');
    this.data.set(hash, data);
    this.#logDataProcessing(data, hash);
  }
  
  #logDataProcessing(data, hash) {
    console.group('Data Processed');
    console.log('Hash:', hash);
    console.dir(data);
    console.groupEnd();
  }

  async *dataGenerator() {
    for (const [key, value] of this.data) {
      yield { key, value };
    }
  }

  displayData() {
    (async () => {
      for await (const entry of this.dataGenerator()) {
        console.log(entry);
      }
    })();
  }
}

(async function run() {
  const system = new ComplexSystem();
  await system.fetchData('https://jsonplaceholder.typicode.com/posts');
  system.displayData();
})();
```