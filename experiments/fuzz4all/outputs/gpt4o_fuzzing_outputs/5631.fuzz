class Observable {
  constructor() {
    this.listeners = new Set();
  }
  
  subscribe(listener) {
    this.listeners.add(listener);
    return () => this.listeners.delete(listener);
  }
  
  notify(data) {
    this.listeners.forEach(listener => listener(data));
  }
}

const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return response.json();
};

const processData = (data) => {
  return data.map(item => ({
    ...item,
    processedAt: new Date().toISOString(),
  }));
};

const memoize = (fn) => {
  const cache = new Map();
  return (...args) => {
    const key = JSON.stringify(args);
    if (cache.has(key)) {
      return cache.get(key);
    }
    const result = fn(...args);
    cache.set(key, result);
    return result;
  };
};

const memoizedProcessData = memoize(processData);

(async () => {
  const dataObservable = new Observable();
  
  const unsubscribe = dataObservable.subscribe(data => {
    console.log('Received data:', data);
  });
  
  try {
    const rawData = await fetchData('https://jsonplaceholder.typicode.com/posts');
    const processedData = memoizedProcessData(rawData);
    dataObservable.notify(processedData);
  } catch (error) {
    console.error('Error fetching data:', error);
  } finally {
    unsubscribe();
  }
})();
```