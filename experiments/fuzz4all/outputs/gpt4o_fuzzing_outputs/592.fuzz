class EventEmitter {
  constructor() {
    this.events = {};
  }

  on(event, listener) {
    if (!this.events[event]) {
      this.events[event] = [];
    }
    this.events[event].push(listener);
  }

  emit(event, ...args) {
    if (this.events[event]) {
      this.events[event].forEach(listener => listener(...args));
    }
  }
}

const fetchData = url => new Promise((resolve, reject) => {
  fetch(url)
    .then(response => response.json())
    .then(data => resolve(data))
    .catch(error => reject(error));
});

const processData = async (data) => {
  const processedData = await Promise.all(data.map(async item => {
    const additionalData = await fetchData(`https: 
    return { ...item, ...additionalData };
  }));
  return processedData;
};

const run = async () => {
  const dataEmitter = new EventEmitter();
  
  dataEmitter.on('dataProcessed', (data) => {
    console.log('Data has been processed:', data);
  });

  try {
    const data = await fetchData('https://api.example.com/initialData');
    const processedData = await processData(data);
    dataEmitter.emit('dataProcessed', processedData);
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

run();
