class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.events.has(event)) {
      this.events.get(event).forEach(listener => listener(...args));
    }
  }
}

async function* asyncDataGenerator(urls) {
  for (const url of urls) {
    const response = await fetch(url);
    if (response.ok) {
      yield await response.json();
    }
  }
}

const fetchDataAndLog = async (urls) => {
  const dataEmitter = new EventEmitter();

  dataEmitter.on('data', (data) => console.log('Received data:', data));
  dataEmitter.on('error', (error) => console.error('Error occurred:', error));

  try {
    for await (const data of asyncDataGenerator(urls)) {
      dataEmitter.emit('data', data);
    }
  } catch (error) {
    dataEmitter.emit('error', error);
  }
};

 
fetchDataAndLog(['https://api.example.com/data1', 'https://api.example.com/data2']);
