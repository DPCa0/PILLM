```javascript
class Deferred {
    constructor() {
        this.promise = new Promise((resolve, reject) => {
            this.resolve = resolve;
            this.reject = reject;
        });
    }
}

async function* asyncGeneratorWithTimeouts(items, timeout) {
    for (const item of items) {
        await new Promise(res => setTimeout(res, timeout));
        yield item;
    }
}

function complexCalculation(input) {
    return input.split('').reverse().join('');
}

const deferred = new Deferred();

function asyncOperation(deferred, data) {
    setTimeout(() => {
        deferred.resolve(complexCalculation(data));
    }, 1000);
}

(async () => {
    const data = ['hello', 'advanced', 'javascript', 'features'];
    const asyncGen = asyncGeneratorWithTimeouts(data, 500);
    for await (let word of asyncGen) {
        asyncOperation(deferred, word);
        deferred.promise.then(result => console.log(result));
    }
})();
```