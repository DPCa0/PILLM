```javascript
 
const fetchData = async () => {
  try {
    const url = 'https://jsonplaceholder.typicode.com/posts';
    const response = await fetch(url);
    const data = await response.json();

    const filteredData = data
      .filter(({ id }) => id % 2 === 0)
      .map(({ userId, title }) => ({ userId, title }));

     
    const userDataPromises = filteredData.map(async ({ userId, title }) => {
      const userResponse = await fetch(`https: 
      const userData = await userResponse.json();
      return { username: userData.username, title };
    });

    const enrichedData = await Promise.all(userDataPromises);

     
    const result = enrichedData.reduce((acc, { username, title }) => {
      acc[username] = acc[username] || [];
      acc[username].push(title);
      return acc;
    }, {});

    console.log(result);
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

fetchData();
