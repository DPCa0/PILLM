class AsyncQueue {
  constructor() {
    this.queue = [];
    this.running = false;
  }

  enqueue(promiseFunc) {
    this.queue.push(promiseFunc);
    if (!this.running) {
      this.running = true;
      this.dequeue();
    }
  }

  async dequeue() {
    while (this.queue.length > 0) {
      const promiseFunc = this.queue.shift();
      try {
        await promiseFunc();
      } catch (error) {
        console.error('Error executing promise:', error);
      }
    }
    this.running = false;
  }
}

const delay = ms => new Promise(res => setTimeout(res, ms));

const fetchData = url => {
  return fetch(url)
    .then(response => response.json())
    .then(data => console.log(data))
    .catch(err => console.error('Fetch error:', err));
};

const apiQueue = new AsyncQueue();

apiQueue.enqueue(() => delay(1000).then(() => fetchData('https://jsonplaceholder.typicode.com/todos/1')));
apiQueue.enqueue(() => delay(2000).then(() => fetchData('https://jsonplaceholder.typicode.com/todos/2')));
apiQueue.enqueue(() => delay(1500).then(() => fetchData('https://jsonplaceholder.typicode.com/todos/3')));

const combineAsyncFunctions = async (...fns) => {
  const results = [];
  for (const fn of fns) {
    results.push(await fn());
  }
  return results;
};

combineAsyncFunctions(
  () => fetch('https://jsonplaceholder.typicode.com/posts/1').then(res => res.json()),
  () => fetch('https://jsonplaceholder.typicode.com/posts/2').then(res => res.json())
).then(results => {
  console.log('Combined results:', results);
});
