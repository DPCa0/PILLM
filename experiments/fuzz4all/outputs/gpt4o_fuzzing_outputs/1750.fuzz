Certainly! Below is a JavaScript program that utilizes advanced features such as Promises, async/await, destructuring, template literals, and ES6 modules. It simulates fetching user data and posts from an API and combines them:

```javascript
 
export const getUser = async (id) => {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve({ id, name: 'John Doe', email: 'john.doe@example.com' });
        }, 1000);
    });
};

export const getUserPosts = async (userId) => {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve([
                { userId, id: 1, title: 'Post 1', body: 'Content of post 1' },
                { userId, id: 2, title: 'Post 2', body: 'Content of post 2' }
            ]);
        }, 1000);
    });
};

 
import { getUser, getUserPosts } from './userData.js';

(async () => {
    try {
        const userId = 1;
        const [user, posts] = await Promise.all([
            getUser(userId),
            getUserPosts(userId)
        ]);

        const { name, email } = user;
        console.log(`User Details:\nName: ${name}\nEmail: ${email}`);

        console.log('\nUser Posts:');
        posts.forEach(({ id, title, body }) => {
            console.log(`\nPost ID: ${id}\nTitle: ${title}\nBody: ${body}`);
        });
    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```

To run this code, ensure you have a module system or a JavaScript environment that supports ES6 modules, like Node.js with ES module support or a modern browser.