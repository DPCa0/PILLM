```javascript
 
async function* fetchDataWithRetries(url, retries = 3) {
  for (let i = 0; i < retries; i++) {
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('Network response was not ok');
      const data = await response.json();
      yield data;  
      return;  
    } catch (error) {
      console.error(`Attempt ${i + 1} failed: ${error.message}`);
      if (i === retries - 1) throw error;  
    }
  }
}

 
const logHandler = {
  get: (obj, prop) => {
    console.log(`Property "${prop}" has been accessed.`);
    return Reflect.get(obj, prop);
  },
};

const targetObject = { a: 1, b: 2, c: 3 };
const proxiedObject = new Proxy(targetObject, logHandler);

 
(async () => {
  try {
    const generator = fetchDataWithRetries('https://jsonplaceholder.typicode.com/todos/1');
    for await (const data of generator) {
      console.log('Fetched Data:', data);
    }
  } catch (error) {
    console.error('Data fetching failed:', error);
  }

   
  console.log('Accessing property a:', proxiedObject.a);
  console.log('Accessing property b:', proxiedObject.b);
})();
```