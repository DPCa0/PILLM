print('Hello, world!');
```javascript
 
import { promises as fs } from 'fs';
import path from 'path';

 
(async function main() {
     
    const handler = {
        get(target, property) {
            if (property === 'greet') {
                return () => `Hello, ${target.name}!`;
            }
            return Reflect.get(target, property);
        },
    };

    const person = new Proxy({ name: 'World' }, handler);

     
    const { greet = () => 'Hello, Stranger!' } = person;

     
    const asyncIterable = {
        [Symbol.asyncIterator]: async function* () {
            yield* ['a', 'b', 'c'];
        },
    };

    console.log(greet());  

     
    const config = null;
    console.log(config?.settings?.language ?? 'Default Language');  

     
    for await (const char of asyncIterable) {
        console.log(`Character from async generator: ${char}`);
    }

     
    const { default: os } = await import('os');

     
    console.log(`System Info: OS - ${os.type()} | Platform - ${os.platform()}`);

     
    try {
        const filePath = path.join(__dirname, 'example.txt');
        await fs.writeFile(filePath, 'Hello, advanced JavaScript!\n', 'utf-8');
        const data = await fs.readFile(filePath, 'utf-8');
        console.log(`File Content:\n${data}`);
    } catch (error) {
        console.error('File operation error:', error);
    }
})();
```