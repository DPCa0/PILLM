print('Hello, world!');
```javascript
 
(async () => {
  try {
     
    const { promises: fs } = await import('fs');

     
    const settings = {
      path: './example.txt',
      content: 'Hello, advanced JavaScript!',
      encoding: 'utf8',
    };

     
    const writeSettings = { ...settings };
    const { path, content, encoding } = writeSettings;

     
    await fs.writeFile(path, content, encoding);
    console.log(`File written successfully to ${path}`);

     
    const data = await fs.readFile(path, encoding);
    console.log(`File content: ${data}`);

     
    const highlight = (strings, ...values) => strings.map((str, i) => `${str}\x1b[32m${values[i] || ''}\x1b[0m`).join('');
    console.log(highlight`Tagged Template Usage: File read from ${path}`);

     
    const handler = {
      get: (target, property) => {
        console.log(`Accessed property: ${property}`);
        return target[property];
      }
    };
    
    const proxy = new Proxy(settings, handler);
    console.log(`Proxy access: path is ${proxy.path}`);

  } catch (error) {
    console.error(`Error: ${error.message}`);
  }
})();
```