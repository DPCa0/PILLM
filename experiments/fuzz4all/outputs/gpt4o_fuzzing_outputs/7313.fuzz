class AsyncQueue {
    constructor() {
        this.queue = [];
        this.running = false;
    }

    async processTask(task) {
        try {
            await task();
        } catch (error) {
            console.error('Error processing task:', error);
        } finally {
            this.next();
        }
    }

    addTask(task) {
        this.queue.push(() => this.processTask(task));
        if (!this.running) {
            this.running = true;
            this.next();
        }
    }

    next() {
        if (this.queue.length === 0) {
            this.running = false;
            return;
        }
        const nextTask = this.queue.shift();
        nextTask();
    }
}

const delay = (ms) => new Promise(res => setTimeout(res, ms));

class EnhancedLogger {
    static #logs = new Map();
    static #counter = 0;

    static log(message) {
        const id = this.#counter++;
        this.#logs.set(id, message);
        console.log(`Log[${id}]: ${message}`);
    }

    static retrieve(id) {
        return this.#logs.get(id) || 'Log not found';
    }
}

const asyncQueue = new AsyncQueue();

asyncQueue.addTask(async () => {
    EnhancedLogger.log("Task 1 started");
    await delay(1000);
    EnhancedLogger.log("Task 1 finished");
});

asyncQueue.addTask(async () => {
    EnhancedLogger.log("Task 2 started");
    await delay(2000);
    EnhancedLogger.log("Task 2 finished");
});

asyncQueue.addTask(async () => {
    EnhancedLogger.log("Task 3 started");
    await delay(1500);
    EnhancedLogger.log("Task 3 finished");
});

 
console.log(EnhancedLogger.retrieve(1));
