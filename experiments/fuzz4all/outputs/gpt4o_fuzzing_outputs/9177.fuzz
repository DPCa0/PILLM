class Observable {
  constructor() {
    this.subscribers = new Set();
  }
  
  subscribe(fn) {
    this.subscribers.add(fn);
  }
  
  unsubscribe(fn) {
    this.subscribers.delete(fn);
  }
  
  notify(data) {
    this.subscribers.forEach(fn => fn(data));
  }
}

const fetchWithTimeout = (url, options, timeout = 3000) => 
  Promise.race([
    fetch(url, options),
    new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), timeout))
  ]);

async function fetchData(url) {
  try {
    let response = await fetchWithTimeout(url);
    if (!response.ok) throw new Error('Network response was not ok.');
    let data = await response.json();
    return data;
  } catch (error) {
    console.error('Fetch error:', error);
    throw error;
  }
}

(async () => {
  const url = 'https://api.example.com/data';
  
  const dataObservable = new Observable();
  
  const logSubscriber = data => console.log('Data received:', data);
  const doubleSubscriber = data => console.log('Double of data:', data * 2);
  
  dataObservable.subscribe(logSubscriber);
  dataObservable.subscribe(doubleSubscriber);
  
  try {
    const data = await fetchData(url);
    dataObservable.notify(data);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();
```