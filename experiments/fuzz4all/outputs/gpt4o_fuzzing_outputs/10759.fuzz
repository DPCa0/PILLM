```javascript
 

 
const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

 
async function fetchData() {
    console.log('Fetching data...');
    await delay(2000);  
    return { id: 1, name: 'John Doe', role: 'Developer' };
}

 
const handler = {
    get: (target, property) => {
        console.log(`Accessed property: ${property}`);
        return Reflect.get(target, property);
    },
    set: (target, property, value) => {
        console.log(`Updated property: ${property} to ${value}`);
        return Reflect.set(target, property, value);
    }
};

(async () => {
     
    const data = await fetchData();
    const proxiedData = new Proxy(data, handler);

     
    console.log(`Name: ${proxiedData.name}`);
    proxiedData.role = 'Senior Developer';
    console.log(`Updated Role: ${proxiedData.role}`);
})();
```