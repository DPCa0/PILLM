```javascript
const fetch = require('node-fetch');

 
const fetchData = async (url) => {
  try {
    const response = await fetch(url);
    const { data } = await response.json();
    return data;
  } catch (error) {
    console.error('Error fetching data:', error);
  }
};

 
class DataProcessor {
  static #instance;

  #data;

  constructor(data) {
    if (DataProcessor.#instance) {
      return DataProcessor.#instance;
    }
    this.#data = data;
    DataProcessor.#instance = this;
  }

  static async getInstance(url) {
    const data = await fetchData(url);
    return new DataProcessor(data);
  }

  processData() {
    return this.#data.map(({ id, attributes }) => ({
      id,
      name: attributes.name.toUpperCase(),
    }));
  }
}

 
const handler = {
  get: (target, prop) => {
    return prop in target ? target[prop] : `Property ${prop} not found`;
  },
};

(async () => {
  const url = 'https://jsonplaceholder.typicode.com/users';
  const dataProcessor = await DataProcessor.getInstance(url);
  const proxy = new Proxy(dataProcessor, handler);

  console.log(proxy.processData());
  console.log(proxy.nonExistentProperty);  
})();
```