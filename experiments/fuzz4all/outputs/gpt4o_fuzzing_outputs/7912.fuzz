class AsyncQueue {
    constructor() {
        this.queue = [];
        this.processing = false;
    }

    enqueue(task) {
        return new Promise((resolve, reject) => {
            this.queue.push({ task, resolve, reject });
            if (!this.processing) this.processNext();
        });
    }

    async processNext() {
        if (this.queue.length === 0) {
            this.processing = false;
            return;
        }

        this.processing = true;
        const { task, resolve, reject } = this.queue.shift();

        try {
            const result = await task();
            resolve(result);
        } catch (error) {
            reject(error);
        } finally {
            this.processNext();
        }
    }
}

const delayedLog = (message, delay) => () => new Promise(resolve =>
    setTimeout(() => {
        console.log(message);
        resolve();
    }, delay)
);

const queue = new AsyncQueue();

queue.enqueue(delayedLog('Task 1', 1000));
queue.enqueue(delayedLog('Task 2', 500));
queue.enqueue(delayedLog('Task 3', 1500));
queue.enqueue(delayedLog('Task 4', 300));
queue.enqueue(delayedLog('Task 5', 700));
```