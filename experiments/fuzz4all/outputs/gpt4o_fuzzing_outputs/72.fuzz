```javascript
 

const fetchData = (url) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
             
            const data = { userId: 1, title: "Advanced JavaScript" };
            Math.random() > 0.1 ? resolve(data) : reject("Fetch error");
        }, 1000);
    });
};

const processData = ({ userId, title }) => {
    return `${title} by user #${userId}`;
};

const main = async () => {
    try {
        const url = "https://api.example.com/data";
        const data = await fetchData(url);
        const message = processData(data);
        console.log(message);
    } catch (error) {
        console.error("Error:", error);
    }
};

main();
```