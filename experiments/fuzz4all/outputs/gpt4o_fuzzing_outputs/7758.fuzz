print('Hello, world!');
```javascript
 
import fs from 'fs/promises';

 
async function processData() {
    try {
         
        const data = await fs.readFile('./data.json', 'utf-8');
        
         
        const { users } = JSON.parse(data);

         
        const filteredUsers = users
            .map(user => ({ ...user, fullName: `${user.firstName} ${user.lastName}` }))
            .filter(user => user.age > 18);

         
        filteredUsers.forEach(user => {
            console.log(`User: ${user.fullName}, Age: ${user.age}`);
        });

         
        const extraUsers = [
            { firstName: 'Anna', lastName: 'Smith', age: 22 },
            { firstName: 'Tom', lastName: 'Hardy', age: 24 }
        ];

        const allUsers = [...filteredUsers, ...extraUsers];

         
        const uniqueAges = new Set(allUsers.map(({ age }) => age));
        console.log(`Unique Ages: ${[...uniqueAges]}`);

         
        const firstUserName = allUsers[0]?.fullName;
        console.log(`First User Name: ${firstUserName}`);

    } catch (error) {
         
        console.error('Error reading or processing data:', error);
    }
}

 
processData();
```

Note: This code assumes the existence of a `data.json` file with an appropriate structure to work correctly.