class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.events.has(event)) {
      this.events.get(event).forEach(listener => listener(...args));
    }
  }
}

const asyncOperation = () => new Promise((resolve) => setTimeout(() => resolve("Data received"), 1000));

async function complexProcess() {
  const eventEmitter = new EventEmitter();

  eventEmitter.on('start', () => console.log('Process started.'));
  eventEmitter.on('data', (data) => console.log(`Processing: ${data}`));
  eventEmitter.on('error', (err) => console.error(`Error: ${err}`));
  eventEmitter.on('end', () => console.log('Process ended.'));

  try {
    eventEmitter.emit('start');

    const data = await asyncOperation();
    eventEmitter.emit('data', data);

     
    const transformedData = [...data].reverse().join('');
    console.log(`Transformed Data: ${transformedData}`);

    eventEmitter.emit('end');
  } catch (error) {
    eventEmitter.emit('error', error);
  }
}

complexProcess();
```