```javascript
const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return response.json();
};

const processData = (data) => {
  return data.map(({ id, name, details }) => ({
    id,
    name: name.toUpperCase(),
    details: { ...details, active: true },
  }));
};

const renderData = (data) => {
  const list = document.createElement('ul');
  data.forEach(({ id, name, details }) => {
    const item = document.createElement('li');
    item.textContent = `${name} (ID: ${id}) - Active: ${details.active}`;
    list.appendChild(item);
  });
  document.body.appendChild(list);
};

(async () => {
  try {
    const rawData = await fetchData('https://jsonplaceholder.typicode.com/users');
    const processedData = processData(rawData);
    renderData(processedData);
  } catch (error) {
    console.error('Error fetching or processing data:', error);
  }
})();
```