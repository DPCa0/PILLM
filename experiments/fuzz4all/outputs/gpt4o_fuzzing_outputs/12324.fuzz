class EventEmitter {
    constructor() {
        this.events = new Map();
    }
    
    on(event, listener) {
        if (!this.events.has(event)) this.events.set(event, []);
        this.events.get(event).push(listener);
    }
    
    emit(event, ...args) {
        if (this.events.has(event)) {
            this.events.get(event).forEach(listener => listener(...args));
        }
    }
}

async function fetchData(url) {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    return response.json();
}

const withRetry = (fn, retries = 3) => async (...args) => {
    let lastError;
    for (let i = 0; i < retries; i++) {
        try {
            return await fn(...args);
        } catch (error) {
            lastError = error;
            console.warn(`Retrying (${i + 1}/${retries}) due to: ${error.message}`);
        }
    }
    throw lastError;
};

const enhancedFetchData = withRetry(fetchData);

const cacheProxyHandler = {
    get(target, prop) {
        if (target.cache.has(prop)) {
            console.log(`Fetching ${prop} from cache`);
            return target.cache.get(prop);
        }
        
        console.log(`Fetching ${prop} through fetchData`);
        const data = target.fetchFunction(prop);
        target.cache.set(prop, data);
        return data;
    }
};

const apiCache = new Proxy({ cache: new Map(), fetchFunction: enhancedFetchData }, cacheProxyHandler);

const eventEmitter = new EventEmitter();
eventEmitter.on('dataLoaded', (data) => {
    console.log('Data Loaded:', data);
});

(async () => {
    try {
        const dataUrl = 'https://jsonplaceholder.typicode.com/todos/1';
        const data = await apiCache[dataUrl];
        eventEmitter.emit('dataLoaded', data);
    } catch (error) {
        console.error('Failed to load data:', error);
    }
})();
```