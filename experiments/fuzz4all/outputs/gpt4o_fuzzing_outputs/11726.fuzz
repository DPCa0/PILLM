```javascript
 
const fetchData = async (url) => {
  return new Promise((resolve) =>
    setTimeout(() => resolve({ data: `Data from ${url}` }), 1000)
  );
};

 
const apiProxyHandler = {
  cache: new Map(),
  get(target, property) {
    if (!this.cache.has(property)) {
      this.cache.set(property, target(property));
    }
    return this.cache.get(property);
  },
};

const apiProxy = new Proxy(fetchData, apiProxyHandler);

 
const iterableData = {
  dataItems: ['item1', 'item2', 'item3'],
  *[Symbol.iterator]() {
    for (const item of this.dataItems) {
      yield apiProxy(item);
    }
  },
};

 
(async () => {
  console.log('Fetching data:');
  for await (const dataPromise of iterableData) {
    const response = await dataPromise;
    console.log(response.data);
  }
})();
```