```javascript
class Deferred {
    constructor() {
        this.promise = new Promise((resolve, reject) => {
            this.resolve = resolve;
            this.reject = reject;
        });
    }
}

async function* fibonacciGen(max) {
    let [prev, curr] = [0, 1];
    while (curr <= max) {
        yield curr;
        [prev, curr] = [curr, prev + curr];
    }
}

function memoize(fn) {
    const cache = new WeakMap();
    return function(...args) {
        if (cache.has(args[0])) {
            return cache.get(args[0]);
        }
        const result = fn(...args);
        cache.set(args[0], result);
        return result;
    };
}

const slowFunction = (num) => {
    const deferred = new Deferred();
    setTimeout(() => deferred.resolve(num * 2), 1000);
    return deferred.promise;
};

const fastFunction = memoize(slowFunction);

(async () => {
    const input = { value: 21 };
    console.log(`Calculating fastFunction(${input.value})...`);

    const result = await fastFunction(input);
    console.log(`Result: ${result}`);

    const fibGen = fibonacciGen(result);
    console.log('Fibonacci sequence:');
    for await (const num of fibGen) {
        console.log(num);
    }
})();
```