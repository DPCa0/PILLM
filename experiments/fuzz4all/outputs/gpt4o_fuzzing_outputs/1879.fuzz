class EventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, new Set());
        }
        this.events.get(event).add(listener);
    }

    emit(event, ...args) {
        if (this.events.has(event)) {
            for (let listener of this.events.get(event)) {
                listener(...args);
            }
        }
    }

    off(event, listener) {
        if (this.events.has(event)) {
            this.events.get(event).delete(listener);
        }
    }
}

async function asyncOperation(data) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (data) {
                resolve(`Processed: ${data}`);
            } else {
                reject('No data provided');
            }
        }, 1000);
    });
}

function* numberGenerator(max) {
    for (let i = 1; i <= max; i++) {
        yield i;
    }
}

const eventEmitter = new EventEmitter();

eventEmitter.on('data', async (data) => {
    try {
        const result = await asyncOperation(data);
        console.log(result);
    } catch (error) {
        console.error(error);
    }
});

const processNumbers = async () => {
    const generator = numberGenerator(5);
    for (let number of generator) {
        eventEmitter.emit('data', number);
    }
}

processNumbers();
```