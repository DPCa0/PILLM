```javascript
 
(async function() {
   
  const response = await fetch('https://api.spacexdata.com/v4/launches/latest');
  const data = await response.json();

   
  const { name, date_utc: launchDate, links: { webcast, patch: { small: patchImage } } } = data;

   
  const launchInfo = document.createElement('div');
  launchInfo.style = 'font-family: Arial, sans-serif; text-align: center; margin-top: 20px;';

   
  launchInfo.innerHTML = `
    <h1>Latest SpaceX Launch</h1>
    <img src="${patchImage}" alt="Mission Patch" style="width: 100px;">
    <h2>${name}</h2>
    <p>Launch Date: ${new Date(launchDate).toLocaleDateString()}</p>
    <a href="${webcast}" target="_blank">Watch the Launch</a>
  `;

   
  document.body.appendChild(launchInfo);
})();
```