```javascript
class DataProcessor {
    constructor(data) {
        this.data = data;
    }

    async processData() {
        const results = await Promise.all(this.data.map(this.processItem));
        return results.filter(result => result !== null);
    }

    async processItem(item) {
        try {
            let result = await this.simulateNetworkRequest(item);
            if (this.isValid(result)) {
                return this.transform(result);
            }
            return null;
        } catch (error) {
            console.error(`Error processing item: ${item}`, error);
            return null;
        }
    }

    simulateNetworkRequest(item) {
        return new Promise((resolve, reject) => {
            setTimeout(() => {
                Math.random() > 0.2 ? resolve(item * 2) : reject('Network Error');
            }, 100);
        });
    }

    isValid(result) {
        return result % 2 === 0;
    }

    transform(result) {
        return {
            original: result / 2,
            transformed: result,
            processedAt: new Date().toISOString()
        };
    }

    static async run() {
        const processor = new DataProcessor([1, 2, 3, 4, 5, 6]);
        const processedData = await processor.processData();
        console.log('Processed Data:', JSON.stringify(processedData, null, 2));
    }
}

DataProcessor.run();
```