```javascript
class AsyncQueue {
  constructor() {
    this.queue = [];
    this.isProcessing = false;
  }

  enqueue(promiseFn) {
    return new Promise((resolve, reject) => {
      this.queue.push({ promiseFn, resolve, reject });
      this.processQueue();
    });
  }

  async processQueue() {
    if (this.isProcessing || this.queue.length === 0) return;
    this.isProcessing = true;
    const { promiseFn, resolve, reject } = this.queue.shift();
    try {
      const result = await promiseFn();
      resolve(result);
    } catch (error) {
      reject(error);
    } finally {
      this.isProcessing = false;
      this.processQueue();
    }
  }
}

const delay = ms => new Promise(res => setTimeout(res, ms));
const logWithDelay = (message, ms) => async () => {
  await delay(ms);
  console.log(message);
};

(async () => {
  const queue = new AsyncQueue();

   
  await queue.enqueue(logWithDelay("Task 1 complete", 1000));
  await queue.enqueue(logWithDelay("Task 2 complete", 500));
  await queue.enqueue(logWithDelay("Task 3 complete", 1500));

  console.log("All tasks complete");
})();
```