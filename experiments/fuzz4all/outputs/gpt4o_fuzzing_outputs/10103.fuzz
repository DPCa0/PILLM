```javascript
 
import fetch from 'node-fetch';   
import fs from 'fs/promises';     

 
const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

 
async function fetchDataAndLog() {
  try {
    console.log("Fetching data...");

    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    const data = await response.json();

    console.log("Data fetched successfully, writing to file...");

     
    await fs.writeFile('posts.json', JSON.stringify(data, null, 2));

    console.log("Data written to file successfully.");

     
    await delay(2000);

    console.log("Reading from file...");

     
    const fileData = await fs.readFile('posts.json', 'utf8');
    const posts = JSON.parse(fileData);

     
    posts.slice(0, 5).forEach(({ id, title, body }) => {
      console.log(`Post ID: ${id}\nTitle: ${title}\nBody: ${body.slice(0, 50)}...\n`);
    });

  } catch (error) {
    console.error("An error occurred:", error);
  }
}

 
fetchDataAndLog();
```