print('Hello, world!');
```javascript
 

 
const fetchData = () => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve({ id: 1, value: 'data' });
    }, 1000);
  });
};

 
const dataHandler = {
  get(target, prop, receiver) {
    console.log(`Property '${prop}' accessed`);
    return Reflect.get(target, prop, receiver);
  },
  set(target, prop, value, receiver) {
    console.log(`Property '${prop}' set to '${value}'`);
    return Reflect.set(target, prop, value, receiver);
  },
};

 
(async () => {
  const dataProxy = new Proxy({}, dataHandler);

  console.log('Fetching data...');
  const data = await fetchData();

  Object.assign(dataProxy, data);
  console.log(`Fetched Data ID: ${dataProxy.id}`);
  console.log(`Fetched Data Value: ${dataProxy.value}`);

  dataProxy.value = 'new data';

   
  Reflect.set(dataProxy, 'extra', 'additional data');
  console.log(`Extra Property: ${Reflect.get(dataProxy, 'extra')}`);
})();
```