```javascript
 

const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  const data = await response.json();
  return data;
};

const processData = ({ name, email, ...rest }) => {
  return {
    name: name.toUpperCase(),
    email: email.toLowerCase(),
    details: { ...rest }
  };
};

const displayData = (user) => {
  const { name, email, details } = user;
  console.log(`Name: ${name}\nEmail: ${email}\nDetails: ${JSON.stringify(details, null, 2)}`);
};

const runApp = async () => {
  try {
    const data = await fetchData('https://jsonplaceholder.typicode.com/users/1');
    const user = processData(data);
    displayData(user);
  } catch (error) {
    console.error(`Error: ${error.message}`);
  }
};

runApp();
```