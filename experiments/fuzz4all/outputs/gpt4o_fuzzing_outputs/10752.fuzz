print('Hello, world!');
```javascript
 

const fetchData = (url) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === 'https://api.example.com/data') {
                resolve({ data: [1, 2, 3, 4, 5] });
            } else {
                reject(new Error('Invalid URL'));
            }
        }, 1000);
    });
};

const processArray = async (url) => {
    try {
        const response = await fetchData(url);
        const { data } = response;

        const transformedData = data.map((item) => item * 2)
                                    .filter((item) => item > 5)
                                    .reduce((acc, current) => acc + current, 0);
        
        console.log(`Transformed Data Sum: ${transformedData}`);
    } catch (error) {
        console.error(`Error fetching data: ${error.message}`);
    }
};

 
const loggerHandler = {
    get: function(target, prop) {
        console.log(`Accessing property '${prop}'`);
        return target[prop];
    }
};

const dataProxy = new Proxy({ url: 'https://api.example.com/data' }, loggerHandler);

processArray(dataProxy.url);

 
(async () => {
    const { add } = await import('./math.js');  
    console.log(`Dynamic import: 5 + 3 = ${add(5, 3)}`);
})();
```