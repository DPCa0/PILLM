print('Hello, world!');
```javascript
 

 
function* dataGenerator() {
    const dataChunks = ['Data 1', 'Data 2', 'Data 3'];
    for (const chunk of dataChunks) {
        yield new Promise(resolve => setTimeout(() => resolve(chunk), Math.random() * 1000));
    }
}

 
async function fetchData(gen) {
    let result = [];
    for (const promise of gen) {
        const data = await promise;
        result.push(data);
        console.log(`Fetched: ${data}`);
    }
    return result;
}

 
const dataHandler = {
    get(target, prop) {
        if (prop === 'length') {
            console.log(`Accessing length: ${target.length}`);
        }
        return Reflect.get(target, prop);
    },
    set(target, prop, value) {
        console.log(`Setting index ${prop} with value ${value}`);
        return Reflect.set(target, prop, value);
    }
};

 
(async () => {
    const generator = dataGenerator();
    const rawData = await fetchData(generator);
    
    const proxiedData = new Proxy(rawData, dataHandler);

     
    console.log(`Initial length: ${proxiedData.length}`);
    proxiedData.push('Data 4');
    console.log(`Updated length: ${proxiedData.length}`);
    console.log(`Final Data: ${proxiedData}`);
})();
```