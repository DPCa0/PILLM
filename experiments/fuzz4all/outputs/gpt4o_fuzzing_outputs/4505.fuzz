```javascript
class ComplexNumber {
  constructor(real, imaginary) {
    this.real = real;
    this.imaginary = imaginary;
  }

  add({ real, imaginary }) {
    return new ComplexNumber(this.real + real, this.imaginary + imaginary);
  }

  multiply({ real, imaginary }) {
    return new ComplexNumber(
      this.real * real - this.imaginary * imaginary,
      this.real * imaginary + this.imaginary * real
    );
  }

  toString() {
    return `${this.real} + ${this.imaginary}i`;
  }
}

const asyncComplexOperation = async (num1, num2) => {
  return new Promise((resolve) => {
    setTimeout(() => {
      const result = num1.multiply(num2).add(num1);
      resolve(result);
    }, 1000);
  });
};

(async () => {
  try {
    const complex1 = new ComplexNumber(2, 3);
    const complex2 = new ComplexNumber(1, 4);

    const result = await asyncComplexOperation(complex1, complex2);

    console.log(`The result of complex operation is: ${result}`);
  } catch (error) {
    console.error('An error occurred:', error);
  }
})();
```