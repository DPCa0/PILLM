async function fetchUserData(userId) {
    try {
         
        const { default: fetch } = await import('node-fetch'); 

         
        const response = await fetch(`https: 
        
        if (!response.ok) throw new Error(`User not found: ${response.status}`);

        const user = await response.json();

         
        const { name, email, address: { city } } = user;

         
        const formatUser = (strings, name, email, city) => 
            `${strings[0]}${name}${strings[1]}${email}${strings[2]}${city}.`;

        console.log(formatUser`User ${name} with email ${email} lives in ${city}`);
        
    } catch (error) {
         
        console.error('Error:', error?.message || 'Unknown Error');
    }
}

 
const userIdHandler = {
    set: function (obj, prop, value) {
        if (prop === 'value' && typeof value === 'number') {
            fetchUserData(value);
        }
        obj[prop] = value;
        return true;
    }
};

const userIdInput = new Proxy({ value: 1 }, userIdHandler);

 
userIdInput.value = 3;
userIdInput.value = 5;
```

**Note:** This code assumes the use of a Node.js environment that supports ES modules and import of `node-fetch`. Adjustments may be needed to run in other environments, such as using alternative fetch methods or including polyfills for browser environments.