print('Hello, world!');
```javascript
 
async function fetchData(url) {
    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Network response was not ok');
        const data = await response.json();

         
        const { user: { name, email }, items } = data;

         
        const processedItems = items
            .filter(item => item.isActive)
            .map(({ id, value }) => ({ id, value: value * 2 }));

         
        console.log(`User: ${name} (${email})`);
        console.log('Processed Items:', processedItems);

         
        const uniqueValues = new Set(processedItems.map(item => item.value));
        console.log('Unique Values:', Array.from(uniqueValues));

         
        const iterableObject = {
            *[Symbol.iterator]() {
                for (const item of processedItems) {
                    yield item;
                }
            }
        };

         
        console.log('Iterating over processed items:');
        for (const item of iterableObject) {
            console.log(item);
        }
    } catch (error) {
        console.error('Fetch error:', error);
    }
}

 
fetchData('https://api.example.com/data');
```