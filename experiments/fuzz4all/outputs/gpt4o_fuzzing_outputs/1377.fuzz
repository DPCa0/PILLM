```javascript
 

 
async function* fetchData(ids) {
  for (const id of ids) {
     
    const data = await new Promise((resolve) => 
      setTimeout(() => resolve({ id, value: Math.random() * 100 }), 100)
    );
    yield data;
  }
}

 
async function processData(ids) {
  const results = new Map();

   
  for await (const { id, value } of fetchData(ids)) {
     
    results.set(id, value);
    console.log(`Fetched data for ID ${id}: ${value.toFixed(2)}`);
  }

  return results;
}

 
(async () => {
  const ids = [1, 2, 3, 4, 5];
  const dataMap = await processData(ids);

   
  console.log("Final results:", [...dataMap.entries()].map(([id, val]) => `ID ${id}: ${val.toFixed(2)}`));
})();
```