print('Hello, world!');
```javascript
const fetch = require('node-fetch');

(async () => {
    try {
         
        const userResponse = await fetch('https://jsonplaceholder.typicode.com/users');
        const users = await userResponse.json();

         
        const emailDomains = users.map(user => user.email.split('@')[1]);
        const domainCounts = emailDomains.reduce((acc, domain) => {
            acc[domain] = (acc[domain] || 0) + 1;
            return acc;
        }, {});

         
        console.log(`Fetched ${users.length} users`);
        console.log(`Domain counts:`, domainCounts);

         
        const sum = (...numbers) => numbers.reduce((acc, val) => acc + val, 0);

         
        const uniqueDomains = [...new Set(emailDomains)];
        console.log(`Unique email domains: ${uniqueDomains.join(', ')}`);

         
        const companyName = users[0]?.company?.name ?? 'No company found';
        console.log(`First user's company: ${companyName}`);

    } catch (error) {
        console.error('Error fetching users:', error);
    }
})();
```