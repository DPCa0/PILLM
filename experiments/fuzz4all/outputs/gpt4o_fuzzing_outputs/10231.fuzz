```javascript
class TaskQueue {
  constructor(concurrency) {
    this.concurrency = concurrency;
    this.running = 0;
    this.queue = [];
  }

  enqueue(task) {
    return new Promise((resolve, reject) => {
      this.queue.push(() => task().then(resolve, reject));
      this.dequeue();
    });
  }

  dequeue() {
    if (this.running >= this.concurrency || this.queue.length === 0) {
      return;
    }

    const task = this.queue.shift();
    this.running++;
    task().finally(() => {
      this.running--;
      this.dequeue();
    });
  }
}

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

(async () => {
  const queue = new TaskQueue(2);

  const tasks = [
    () => delay(1000).then(() => console.log("Task 1 completed")),
    () => delay(500).then(() => console.log("Task 2 completed")),
    () => delay(300).then(() => console.log("Task 3 completed")),
    () => delay(400).then(() => console.log("Task 4 completed")),
  ];

  const results = await Promise.all(tasks.map(task => queue.enqueue(task)));

  console.log("All tasks completed", results);
})();
```