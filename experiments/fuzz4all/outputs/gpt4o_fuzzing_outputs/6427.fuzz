```javascript
 
async function fetchData(url) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (Math.random() > 0.5) {
                resolve({ data: `Data from ${url}` });
            } else {
                reject(new Error('Fetch error'));
            }
        }, 1000);
    });
}

 
const dataHandler = {
    get: (obj, prop) => {
        console.log(`Accessing property "${prop}"`);
        return prop in obj ? obj[prop] : `No such property: "${prop}"`;
    }
};

 
function* dataGenerator(urls) {
    for (const url of urls) {
        try {
            const result = yield fetchData(url);
            yield result.data;
        } catch (err) {
            yield err.message;
        }
    }
}

 
(async function() {
    const urls = ['http://api.example.com/data1', 'http://api.example.com/data2'];
    const results = [];
    const generator = dataGenerator(urls);

    for (let fetchResult of generator) {
        fetchResult = fetchResult instanceof Promise ? await fetchResult : fetchResult;
        const output = generator.next(fetchResult);
        results.push(output.value);
    }

    const proxy = new Proxy({ results }, dataHandler);

    console.log(proxy.results);  
})();
```