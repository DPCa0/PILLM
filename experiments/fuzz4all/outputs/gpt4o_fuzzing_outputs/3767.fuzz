```javascript
const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error(`Failed to fetch data: ${response.status}`);
  return response.json();
};

const processData = (data) => {
  const transformed = data.map(({ id, name, details: { info } }) => ({
    id,
    name,
    info,
    summary: `${name}: ${info.substring(0, 20)}...`
  }));
  return transformed.reduce((acc, item) => {
    acc[item.id] = item;
    return acc;
  }, {});
};

const displayData = (data) => {
  const container = document.createElement('div');
  Object.values(data).forEach(({ id, name, summary }) => {
    const item = document.createElement('p');
    item.innerHTML = `<strong>${name} (${id})</strong>: ${summary}`;
    container.appendChild(item);
  });
  document.body.appendChild(container);
};

(async () => {
  try {
    const data = await fetchData('https://jsonplaceholder.typicode.com/users');
    const processedData = processData(data);
    displayData(processedData);
  } catch (error) {
    console.error('Error:', error.message);
  }
})();
```

This JavaScript program fetches user data from an API, processes it to extract specific fields, and displays them in a web page. It uses `async/await` for handling asynchronous requests, destructuring for handling data, and dynamic HTML generation to display the results.