class Fibonacci {
    *[Symbol.iterator]() {
        let [prev, curr] = [0, 1];
        for (;;) {
            yield curr;
            [prev, curr] = [curr, prev + curr];
        }
    }
}

const asyncFetch = async (url) => {
    try {
        let response = await fetch(url);
        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
        let data = await response.json();
        return data;
    } catch (error) {
        console.error("Fetch error: ", error);
    }
};

(async () => {
    const fib = new Fibonacci();
    for (const n of fib) {
        if (n > 1000) break;
        console.log(n);
    }

    const url = 'https://jsonplaceholder.typicode.com/todos/1';
    const data = await asyncFetch(url);
    console.log("Fetched Data: ", data);

    const person = {
        firstName: 'John',
        lastName: 'Doe',
        get fullName() {
            return `${this.firstName} ${this.lastName}`;
        },
        *getInitials() {
            yield* [this.firstName[0], this.lastName[0]];
        }
    };

    console.log('Full Name: ', person.fullName);
    console.log('Initials: ', [...person.getInitials()].join(''));

    const proxyHandler = {
        get(target, property) {
            return property in target ? target[property] : `Property '${property}' not found.`;
        },
        set(target, property, value) {
            if (property === 'age' && typeof value !== 'number') {
                throw new TypeError('Age must be a number');
            }
            target[property] = value;
        }
    };

    const proxiedPerson = new Proxy(person, proxyHandler);
    console.log(proxiedPerson.firstName);
    try {
        proxiedPerson.age = 'twenty five';
    } catch (error) {
        console.error(error.message);
    }
})();
```