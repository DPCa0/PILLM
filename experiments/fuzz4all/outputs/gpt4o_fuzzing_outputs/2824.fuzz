class AsyncEventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  off(event, listener) {
    if (this.events.has(event)) {
      this.events.set(event, this.events.get(event).filter(l => l !== listener));
    }
  }

  async emit(event, ...args) {
    if (this.events.has(event)) {
      await Promise.all(this.events.get(event).map(listener => listener(...args)));
    }
  }
}

async function fetchData(url) {
  const response = await fetch(url);
  const data = await response.json();
  return data;
}

const emitter = new AsyncEventEmitter();

const logDataListener = async (data) => {
  console.log('Data received:', data);
};

emitter.on('data', logDataListener);

(async () => {
  const data = await fetchData('https://jsonplaceholder.typicode.com/posts/1');
  await emitter.emit('data', data);
})();

emitter.off('data', logDataListener);
```