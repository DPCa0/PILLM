```javascript
 

 
const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

 
async function fetchData() {
  console.log('Fetching data...');
  await delay(1000);  
  const data = { userId: 1, title: 'JavaScript Complexity', content: 'Advanced features demonstration' };
  console.log('Data fetched:', data);
  return data;
}

 
const handler = {
  get(target, property) {
    console.log(`Accessing property "${property}"`);
    return target[property];
  }
};

 
async function main() {
  try {
    const data = await fetchData();
    const proxiedData = new Proxy(data, handler);

     
    const { userId, title, content } = proxiedData;
    console.log(`User (${userId}): ${title}`);
    console.log(`Content: ${content}`);

     
    Promise.resolve(data)
      .then(d => {
        console.log('Processing data...');
        return { ...d, processed: true };  
      })
      .then(d => {
        console.log('Processed Data:', d);
      });

  } catch (error) {
    console.error('An error occurred:', error);
  }
}

 
main();
```