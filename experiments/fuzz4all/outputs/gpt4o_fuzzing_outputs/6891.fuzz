print('Hello, world!');
```javascript
 

 
const fetchData = () => {
  return new Promise((resolve) => {
    setTimeout(() => resolve({ data: [1, 2, 3, 4, 5] }), 1000);
  });
};

 
const processData = async () => {
  const response = await fetchData();
  const { data } = response;

   
  const doubledData = data.map((num) => num * 2);

   
  const handler = {
    get: (target, property) => {
      console.log(`Accessing property "${property}"`);
      return target[property];
    },
  };

  const proxyData = new Proxy(doubledData, handler);

   
  console.log(proxyData[0]);  
  console.log(proxyData[1]);  
  console.log(proxyData[2]);  

  return proxyData;
};

 
processData().then((result) => console.log('Processed Data:', result));
```