```javascript
 
const memoize = (fn) => {
  const cache = new Map();
  return (...args) => {
    const key = JSON.stringify(args);
    if (cache.has(key)) {
      console.log('Fetching from cache:', key);
      return cache.get(key);
    }
    console.log('Calculating result for:', key);
    const result = fn(...args);
    cache.set(key, result);
    return result;
  };
};

 
const fibonacci = memoize((n) => {
  if (n <= 1) return n;
  return fibonacci(n - 1) + fibonacci(n - 2);
});

 
(async () => {
  const num = 10;
  console.log(`Fibonacci sequence up to ${num}:`);
  for (let i = 0; i <= num; i++) {
    console.log(`Fib(${i}) = ${await Promise.resolve(fibonacci(i))}`);
  }
})();

 
const target = {
  message1: "hello",
  message2: "world",
};

const handler = {
  get: (obj, prop) => {
    console.log(`Property '${prop}' has been accessed`);
    return Reflect.get(...arguments);
  },
  set: (obj, prop, value) => {
    console.log(`Property '${prop}' has been set to '${value}'`);
    return Reflect.set(...arguments);
  },
};

const proxy = new Proxy(target, handler);
proxy.message1 = "hi";
console.log(proxy.message1);
console.log(proxy.message2);
```