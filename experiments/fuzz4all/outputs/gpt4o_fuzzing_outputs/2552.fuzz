```javascript
class Matrix {
    constructor(rows, cols, fill = 0) {
        this.data = Array.from({ length: rows }, () => 
            Array.from({ length: cols }, () => fill)
        );
    }

    static fromArray(arr) {
        return new Matrix(arr.length, arr[0].length, null).map((_, i, j) => arr[i][j]);
    }

    map(fn) {
        return this.data.map((row, i) =>
            row.map((value, j) => fn(value, i, j))
        );
    }

    forEach(fn) {
        this.data.forEach((row, i) => 
            row.forEach((value, j) => fn(value, i, j))
        );
    }

    static multiply(a, b) {
        if (a[0].length !== b.length) throw new Error('Invalid matrices for multiplication');
        return new Matrix(a.length, b[0].length, null).map((_, i, j) =>
            a[i].reduce((sum, element, k) => sum + element * b[k][j], 0)
        );
    }

    [Symbol.iterator]() {
        let i = 0, j = 0;
        return {
            next: () => {
                if (i < this.data.length) {
                    const value = this.data[i][j];
                    if (++j >= this.data[i].length) { j = 0; i++; }
                    return { value, done: false };
                } else {
                    return { done: true };
                }
            }
        };
    }
}

const m1 = Matrix.fromArray([
    [1, 2],
    [3, 4]
]);
const m2 = Matrix.fromArray([
    [5, 6],
    [7, 8]
]);

const m3 = Matrix.multiply(m1.data, m2.data);

for (const value of m3) {
    console.log(value);
}
```