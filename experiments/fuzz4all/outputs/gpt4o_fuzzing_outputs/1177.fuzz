class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.events.has(event)) {
      this.events.get(event).forEach(listener => listener(...args));
    }
  }

  once(event, listener) {
    const wrapper = (...args) => {
      listener(...args);
      this.off(event, wrapper);
    };
    this.on(event, wrapper);
  }

  off(event, listener) {
    if (this.events.has(event)) {
      this.events.set(event, this.events.get(event).filter(l => l !== listener));
    }
  }
}

const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

async function* asyncGenerator() {
  let i = 0;
  while (i < 5) {
    yield await delay(1000).then(() => `Tick: ${++i}`);
  }
}

(async () => {
  const eventEmitter = new EventEmitter();
  eventEmitter.on('tick', msg => console.log(msg));
  
  for await (let msg of asyncGenerator()) {
    eventEmitter.emit('tick', msg);
  }

  eventEmitter.once('complete', () => console.log('All done!'));
  eventEmitter.emit('complete');
})();
```