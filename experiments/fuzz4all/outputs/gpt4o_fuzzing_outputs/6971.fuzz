class AsyncEventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    const listeners = this.events.get(event);
    if (listeners) {
      return Promise.all(listeners.map(listener => listener(...args)));
    }
  }

  off(event, listenerToRemove) {
    if (this.events.has(event)) {
      const listeners = this.events.get(event);
      this.events.set(
        event,
        listeners.filter(listener => listener !== listenerToRemove)
      );
    }
  }
}

 
const fetchData = async (url) => {
  const delay = Math.random() * 2000 + 500;
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve(`Data from ${url}`);
    }, delay);
  });
};

 
const apiProxy = new Proxy(fetchData, {
  apply: async (target, thisArg, args) => {
    console.log(`Fetching data from ${args[0]}...`);
    const data = await target.apply(thisArg, args);
    console.log(`Received: ${data}`);
    return data;
  }
});

const emitter = new AsyncEventEmitter();

emitter.on('data', async (url) => {
  const data = await apiProxy(url);
  console.log(`Event Handler 1: Processed ${data}`);
});

emitter.on('data', async (url) => {
  const data = await apiProxy(url);
  console.log(`Event Handler 2: Logged ${data}`);
});

(async () => {
  await emitter.emit('data', 'https://api.example.com/resource1');
  await emitter.emit('data', 'https://api.example.com/resource2');
})();
```