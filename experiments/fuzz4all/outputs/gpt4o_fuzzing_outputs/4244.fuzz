```javascript
class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.events.has(event)) {
      this.events.get(event).forEach(listener => listener(...args));
    }
  }
}

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

const asyncFunction = async () => {
  console.log('Starting async task...');
  await delay(1000);
  console.log('Async task completed!');
};

const withLogging = (func) => {
  return function(...args) {
    console.log(`Calling ${func.name} with arguments:`, args);
    const result = func(...args);
    console.log(`Result from ${func.name}:`, result);
    return result;
  };
};

const add = (a, b) => a + b;

const addWithLogging = withLogging(add);

(async () => {
  const emitter = new EventEmitter();

  emitter.on('data', async (data) => {
    console.log('Received data:', data);
    await asyncFunction();
    console.log('Processing completed for data:', data);
  });

  emitter.emit('data', { id: 1, message: 'Hello' });

  console.log('Add result:', addWithLogging(3, 5));
})();
```