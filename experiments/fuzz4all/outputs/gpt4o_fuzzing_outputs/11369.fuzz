class EventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) this.events.set(event, []);
        this.events.get(event).push(listener);
    }

    emit(event, ...args) {
        if (this.events.has(event)) {
            for (const listener of this.events.get(event)) {
                listener(...args);
            }
        }
    }
}

const pipeline = (...fns) => fns.reduce((f, g) => (...args) => g(f(...args)));

const debounce = (func, wait) => {
    let timeout;
    return function(...args) {
        clearTimeout(timeout);
        timeout = setTimeout(() => func.apply(this, args), wait);
    };
};

const asyncRequest = url => 
    new Promise((resolve, reject) => {
        setTimeout(() => {
            if (Math.random() > 0.3) resolve(`Data from ${url}`);
            else reject(`Error fetching ${url}`);
        }, 1000);
    });

const main = async () => {
    const emitter = new EventEmitter();

    emitter.on('data', debounce((msg) => console.log('Received:', msg), 300));

    try {
        const fetchAndEmit = pipeline(
            asyncRequest,
            data => { emitter.emit('data', data); return data; },
        );

        await Promise.all([
            fetchAndEmit('https://api.example.com/1'),
            fetchAndEmit('https://api.example.com/2'),
            fetchAndEmit('https://api.example.com/3')
        ]);

    } catch (error) {
        console.error(error);
    }
};

main();
