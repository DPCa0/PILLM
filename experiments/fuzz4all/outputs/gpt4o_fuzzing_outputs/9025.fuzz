Certainly! Here is a JavaScript program that utilizes advanced features such as Promises, async/await, generators, destructuring, and the spread operator:

```javascript
 
function fetchData(id) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (id > 0) {
                resolve({ id, name: `Item ${id}`, value: Math.random() * 100 });
            } else {
                reject('Invalid ID');
            }
        }, 1000);
    });
}

 
async function* asyncDataGenerator(ids) {
    for (const id of ids) {
        try {
            const data = await fetchData(id);
            yield data;
        } catch (error) {
            yield { error };
        }
    }
}

 
async function processItems(ids) {
    const results = [];
    for await (const { id, name, value, error } of asyncDataGenerator(ids)) {
        if (error) {
            console.log(`Error: ${error}`);
        } else {
            console.log(`Processed: ${name} with value: ${value.toFixed(2)}`);
            results.push({ id, name, value });
        }
    }
    return results;
}

 
const ids = [1, 2, 3, -1, 5];
const [first, ...rest] = ids;

 
(async () => {
    console.log(`Starting with first item ID: ${first}`);
    const result = await processItems(rest);
    console.log('Final Results:', result);
})();
```

This script demonstrates various advanced JavaScript features and async programming techniques. It processes a list of item IDs, fetching simulated data for each, handling errors, and finally collecting successful results.