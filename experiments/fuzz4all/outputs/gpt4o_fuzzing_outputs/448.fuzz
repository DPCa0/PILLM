print('Hello, world!');
```javascript
 

 
function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

 
async function* generateSequence() {
  for (let i = 1; i <= 5; i++) {
    await delay(1000);
    yield i;
  }
}

 
const handler = {
  get(target, property) {
    console.log(`Getting ${property}`);
    return target[property];
  },
  set(target, property, value) {
    console.log(`Setting ${property} to ${value}`);
    target[property] = value;
    return true;
  }
};

 
const targetObject = { a: 1, b: 2, c: 3 };
const proxiedObject = new Proxy(targetObject, handler);

 
async function run() {
  for await (let value of generateSequence()) {
    console.log(`Generated value: ${value}`);
    proxiedObject[`prop${value}`] = value * 10;
    console.log(`Proxied property: prop${value} = ${proxiedObject[`prop${value}`]}`);
  }
}

run();
```