Certainly! Here's a JavaScript program that uses advanced features like Promises, async/await, Map, Set, and Destructuring:

```javascript
// Simulating an asynchronous operation with Promises
function fetchData() {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve([
                { id: 1, name: 'Alice', tags: ['developer', 'javascript'] },
                { id: 2, name: 'Bob', tags: ['developer', 'python'] },
                { id: 3, name: 'Charlie', tags: ['designer', 'css'] }
            ]);
        }, 1000);
    });
}

// Using async/await to handle asynchronous operations
async function processData() {
    try {
        const data = await fetchData();

        // Using Map to transform data
        const userMap = new Map(data.map(user => [user.id, user]));

        // Using Set to store unique tags
        const tagSet = new Set();
        data.forEach(user => user.tags.forEach(tag => tagSet.add(tag)));

        // Destructuring to extract specific users
        const [firstUser, , thirdUser] = data;

        console.log('User Map:', userMap);
        console.log('Unique Tags:', [...tagSet]);
        console.log('First User:', firstUser);
        console.log('Third User:', thirdUser);

    } catch (error) {
        console.error('Error processing data:', error);
    }
}

processData();
```

This program demonstrates how to work with asynchronous data fetching, transforming data with `Map`, extracting unique elements with `Set`, and accessing specific elements using destructuring.