Certainly! Below is a JavaScript program that utilizes advanced features like async/await, destructuring, and the spread operator:

```javascript
 
const fetchData = (endpoint) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (endpoint === "user") {
                resolve({
                    id: 1,
                    name: "Alice",
                    roles: ["admin", "editor"],
                    metadata: { active: true, plan: "premium" },
                });
            } else if (endpoint === "settings") {
                resolve({
                    theme: "dark",
                    notifications: { email: true, sms: false },
                });
            } else {
                reject(new Error("Invalid endpoint"));
            }
        }, 1000);
    });
};

 
const getUserProfile = async () => {
    try {
        const [user, settings] = await Promise.all([
            fetchData("user"),
            fetchData("settings"),
        ]);

         
        const {
            name,
            roles: [primaryRole, ...otherRoles],
            metadata: { active, plan },
        } = user;
        
        const profile = {
            name,
            primaryRole,
            otherRoles,
            active,
            plan,
            ...settings,  
        };

        console.log(profile);
    } catch (error) {
        console.error("Error fetching data:", error.message);
    }
};

 
getUserProfile();
```

This script demonstrates complex usage of JavaScript features by fetching and combining data using `Promise.all`, destructuring arrays and objects, and merging data with the spread operator.