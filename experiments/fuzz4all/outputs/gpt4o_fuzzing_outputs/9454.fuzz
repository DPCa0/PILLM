```javascript
 

 
function fetchData() {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      const data = { user: { name: 'Alice', age: 25 } };
      resolve(data);
    }, 1000);
  });
}

 
const userHandler = {
  set(target, property, value) {
    if (property === 'age' && (typeof value !== 'number' || value < 0)) {
      throw new Error('Age must be a positive number');
    }
    target[property] = value;
    return true;
  }
};

 
async function manipulateUserData() {
  try {
    const response = await fetchData();
    const user = new Proxy(response.user, userHandler);

    console.log('Original User Data:', user);
    
     
    try {
      user.age = -5;  
    } catch (error) {
      console.error('Error setting age:', error.message);
    }

     
    user.age = 30;
    console.log('Updated User Data:', user);
  } catch (error) {
    console.error('An error occurred:', error);
  }
}

manipulateUserData();
```