print('Hello, world!');
```javascript
 
const createMultiplier = (factor) => (...nums) => nums.map(num => num * factor);

 
const user = {
  name: 'Alice',
  age: 25
};

const handler = {
  get(target, prop, receiver) {
    if (prop === 'age') {
      console.log('Accessing the age property');
    }
    return Reflect.get(...arguments);
  },
  set(target, prop, value) {
    if (prop === 'name' && typeof value !== 'string') {
      throw new Error('Name must be a string');
    }
    target[prop] = value;
    return true;
  }
};

const proxiedUser = new Proxy(user, handler);

 
function* fibonacci() {
  let [prev, curr] = [0, 1];
  while (true) {
    yield curr;
    [prev, curr] = [curr, prev + curr];
  }
}

 
const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

async function greetAfterDelay(message, ms) {
  await delay(ms);
  console.log(message);
}

 
const multiplier = createMultiplier(2);
console.log(multiplier(1, 2, 3));  

console.log(proxiedUser.name);  
proxiedUser.age = 26;  

const fib = fibonacci();
console.log(fib.next().value);  
console.log(fib.next().value);  
console.log(fib.next().value);  

greetAfterDelay('Hello after delay', 1000);  
```