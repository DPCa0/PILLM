class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) this.events.set(event, []);
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (!this.events.has(event)) return;
    for (const listener of this.events.get(event)) {
      listener(...args);
    }
  }

  off(event, listenerToRemove) {
    if (!this.events.has(event)) return;
    const filteredListeners = this.events.get(event).filter(listener => listener !== listenerToRemove);
    this.events.set(event, filteredListeners);
  }
}

async function asyncTask(id) {
  return new Promise((resolve) => {
    setTimeout(() => {
      console.log(`Task ${id} complete`);
      resolve(`Result from task ${id}`);
    }, Math.random() * 1000);
  });
}

async function performTasksInParallel(tasks) {
  const results = await Promise.all(tasks.map(task => task()));
  console.log('All tasks completed:', results);
}

const ee = new EventEmitter();
const taskCompleteListener = result => console.log('Received:', result);

ee.on('taskComplete', taskCompleteListener);

performTasksInParallel([() => asyncTask(1), () => asyncTask(2), () => asyncTask(3)])
  .then(results => results.forEach(result => ee.emit('taskComplete', result)))
  .finally(() => ee.off('taskComplete', taskCompleteListener));
```