```javascript
 
const uniqueKey = Symbol('unique');

 
class DataProcessor {
  #privateData = [];
  
  static logActivity = [];

  constructor(data) {
    this.#privateData = data.map(DataProcessor.#validateAndProcess);
  }

  static #validateAndProcess(item) {
    return typeof item === 'number' ? item * 2 : item;
  }

  get data() {
    return this.#privateData;
  }

  static log(message) {
    DataProcessor.logActivity.push({ message, timestamp: new Date() });
  }

  @capitalizeKeys
  processData() {
    return this.#privateData.reduce((acc, val, idx) => {
      acc[`Item${idx}`] = val;
      return acc;
    }, {});
  }
}

 
function capitalizeKeys(target, property, descriptor) {
  const originalMethod = descriptor.value;
  descriptor.value = function(...args) {
    const result = originalMethod.apply(this, args);
    return Object.fromEntries(
      Object.entries(result).map(([key, value]) => [key.toUpperCase(), value])
    );
  };
}

 
async function fetchData() {
  return new Promise(resolve => {
    setTimeout(() => {
      resolve([1, 'a', 3, 'b']);
    }, 1000);
  });
}

(async () => {
  const rawData = await fetchData();
  
  const processor = new DataProcessor(rawData);
  DataProcessor.log('Data processed');

  const processedData = processor.processData();

  console.log(processedData);
  console.log(DataProcessor.logActivity);

  const dataMap = new Map([[uniqueKey, processedData]]);
  console.log('Data by unique key:', dataMap.get(uniqueKey));
})();
```