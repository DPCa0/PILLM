```javascript
 

 
class Particle {
   
  #id;

  constructor(type, mass) {
    this.type = type;
    this.mass = mass;
    this.#id = Symbol(type);
  }

   
  #logInfo() {
    console.log(`Particle ID: ${this.#id.toString()}, Type: ${this.type}, Mass: ${this.mass}`);
  }

  display() {
    this.#logInfo();
  }

  static description() {
    return "This class represents a particle in a physical system.";
  }
}

 
function* particleGenerator(types) {
  let id = 0;
  while (true) {
    const type = types[id % types.length];
    yield new Particle(type, Math.random() * 100);
    id++;
  }
}

 
async function simulateParticles() {
  const particles = [];
  const types = ['Electron', 'Proton', 'Neutron'];
  const generator = particleGenerator(types);

  for (let i = 0; i < 5; i++) {
    particles.push(generator.next().value);
  }

  console.log(Particle.description());
  await Promise.all(particles.map(async particle => {
     
    await new Promise(res => setTimeout(res, 100 * Math.random()));
    particle.display();
  }));
}

 
const handler = {
  get: (obj, prop) => (prop in obj ? obj[prop] : 'Property does not exist')
};

const proxy = new Proxy({ environment: 'Quantum Realm' }, handler);

console.log(proxy.environment);  
console.log(proxy.location);  

simulateParticles();
```