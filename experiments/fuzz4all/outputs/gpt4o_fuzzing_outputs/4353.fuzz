class WeatherFetcher {
    constructor(apiUrl) {
        this.apiUrl = apiUrl;
    }

    async fetchWeather(city) {
        try {
            const response = await fetch(`${this.apiUrl}?q=${city}&appid=${this.apiKey}`);
            if (!response.ok) throw new Error('Network response was not ok');
            const weatherData = await response.json();
            return weatherData;
        } catch (error) {
            console.error('Error fetching weather data:', error);
            throw error;
        }
    }

    async getCityWeather(city) {
        const weather = await this.fetchWeather(city);
        return `${city}: ${weather.weather[0].description}, ${weather.main.temp}°C`;
    }

    setApiKey(apiKey) {
        this.apiKey = apiKey;
    }
}

 
const weatherLoggerHandler = {
    get(target, prop) {
        if (typeof target[prop] === 'function') {
            return function(...args) {
                console.log(`Calling ${prop} with`, args);
                return target[prop].apply(this, args);
            }
        }
        return target[prop];
    }
};

 
(async () => {
    const apiUrl = 'https://api.openweathermap.org/data/2.5/weather';
    const apiKey = 'YOUR_API_KEY';  
    const city = 'London';

    const weatherFetcher = new WeatherFetcher(apiUrl);
    weatherFetcher.setApiKey(apiKey);

    const proxyWeatherFetcher = new Proxy(weatherFetcher, weatherLoggerHandler);

    try {
        const weatherInfo = await proxyWeatherFetcher.getCityWeather(city);
        console.log(weatherInfo);
    } catch (error) {
        console.error('Failed to retrieve weather information.');
    }
})();
