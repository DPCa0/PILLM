```javascript
 
import fetch from 'node-fetch';

 
async function fetchData() {
    try {
         
        let response = await fetch('https://jsonplaceholder.typicode.com/posts');
        
         
        let { json } = response;

         
        let data = await json();
        
         
        let titles = data.map(({ title }) => title.toUpperCase());
        
         
        for (let [index, title] of titles.entries()) {
            console.log(`${index + 1}: ${title}`);
        }

    } catch (error) {
        console.error('Error fetching data:', error);
    }
}

 
function style(strings, ...values) {
    return strings.reduce((result, string, i) => 
        result + string + (values[i] ? `\x1b[32m${values[i]}\x1b[0m` : ''), '');
}

console.log(style`Fetching and processing data from \x1b[34mjsonplaceholder\x1b[0m API:\n`);
fetchData();
```