```javascript
 
async function fetchDataAndProcess() {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    const posts = await response.json();

     
    const wordFrequencies = new Map();

     
    posts.forEach(({ title }) => {
      const words = title.split(' ');

      words.forEach(word => {
        word = word.toLowerCase();
        wordFrequencies.set(word, (wordFrequencies.get(word) || 0) + 1);
      });
    });

     
    const sortedWords = [...wordFrequencies.entries()].sort((a, b) => b[1] - a[1]);

     
    sortedWords.slice(0, 5).forEach(([word, frequency]) => {
      console.log(`The word "${word}" appears ${frequency} times.`);
    });

  } catch (error) {
     
    console.error(`Failed to fetch data: ${error?.message ?? 'Unknown error'}`);
  }
}

 
fetchDataAndProcess();
```