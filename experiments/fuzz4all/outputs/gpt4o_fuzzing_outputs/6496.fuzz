print('Hello, world!');
```javascript
 

async function fetchData(url) {
    const response = await fetch(url);
    const data = await response.json();
    return data;
}

const handler = {
    get(target, prop) {
        return prop in target ? target[prop] : `Property ${prop} not found`;
    },
    set(target, prop, value) {
        console.log(`Setting ${prop} to ${value}`);
        target[prop] = value;
        return true;
    }
};

const createProxy = (object) => new Proxy(object, handler);

(async () => {
    try {
        const data = await fetchData('https://jsonplaceholder.typicode.com/users/1');
        const { name, email, address: { street, city } } = data;
        
        const user = createProxy({
            name,
            email,
            address: `${street}, ${city}`
        });

        console.log(`User info: Name - ${user.name}, Email - ${user.email}, Address - ${user.address}`);

        user.phone = '123-456-7890';   
        console.log(user.phone);       

    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```