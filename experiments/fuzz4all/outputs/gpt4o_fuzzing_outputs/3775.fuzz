```javascript
 

const getJsonPlaceholderData = async () => {
  try {
    const response = await fetch('https://jsonplaceholder.typicode.com/users');
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }
    const users = await response.json();

     
    const userInformation = users.map(({ id, name, email }) => {
      return `User ID: ${id}, Name: ${name}, Email: ${email}`;
    });

     
    const uniqueEmails = [...new Set(users.map(user => user.email))];

     
    const userPromises = users.map(user => {
      return new Promise(resolve => {
        setTimeout(() => {
          resolve(`Processed user: ${user.name}`);
        }, 1000);
      });
    });

     
    const processedUsers = await Promise.all(userPromises);

    console.log('User Information:', userInformation.join('\n'));
    console.log('Unique Emails:', uniqueEmails);
    console.log('Processed Users:', processedUsers);
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

getJsonPlaceholderData();
```