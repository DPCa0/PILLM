```javascript
 

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

async function* asyncGenerator() {
    for (let i = 1; i <= 5; i++) {
        await delay(1000);  
        yield `Yielded value ${i}`;
    }
}

async function runAsyncGenerator() {
    const values = [];
    for await (const value of asyncGenerator()) {
        console.log(value);
        values.push(value);
    }
    return values;
}

function* fibonacci(n) {
    let [prev, curr] = [0, 1];
    for (let i = 0; i < n; i++) {
        yield curr;
        [prev, curr] = [curr, prev + curr];
    }
}

async function main() {
    console.log("Starting async generator...");
    const asyncValues = await runAsyncGenerator();

    console.log("\nGenerating Fibonacci sequence...");
    const fibSequence = Array.from(fibonacci(10));
    console.log(fibSequence);

    console.log("\nCombining results...");
    const combined = [...new Set([...asyncValues, ...fibSequence.map(n => `Fibonacci: ${n}`)])];
    console.log(combined);
}

main();
```