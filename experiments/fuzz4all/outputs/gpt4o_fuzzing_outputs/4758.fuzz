```javascript
 

 
const fetchData = async () => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve([
        { name: 'Alice', age: 30 },
        { name: 'Bob', age: 25 },
        { name: 'Charlie', age: 35 }
      ]);
    }, 1000);
  });
};

 
function* processData(data) {
  for (let item of data) {
    yield `${item.name} is ${item.age} years old.`;
  }
}

 
(async () => {
  try {
     
    const data = await fetchData();
    
     
    const mapData = new Map(data.map(({ name, age }) => [name, age]));

     
    const personData = {
      ...Object.fromEntries(mapData),
      [Symbol.iterator]: function* () {
        yield* processData(data);
      }
    };

     
    for (const info of personData) {
      console.log(info);
    }
    
  } catch (error) {
    console.error('An error occurred:', error);
  }
})();
```