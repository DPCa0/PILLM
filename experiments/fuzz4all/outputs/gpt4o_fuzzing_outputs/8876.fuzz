```javascript
 
class DataProcessor {
  #data;

  constructor(data) {
    this.#data = data;
  }

   
  static create(data) {
    return new Proxy(new DataProcessor(data), {
      set(target, prop, value) {
        if (prop === '#data' && !Array.isArray(value)) {
          throw new TypeError('Data must be an array');
        }
        target[prop] = value;
        return true;
      },
    });
  }

   
  *filterData(criteria) {
    for (const item of this.#data) {
      if (criteria(item)) {
        yield item;
      }
    }
  }

   
  async processDataAsync(operation) {
    const promises = this.#data.map(item => operation(item));
    return Promise.all(promises);
  }

   
  [Symbol.iterator]() {
    let index = 0;
    const data = this.#data;
    return {
      next: () => ({
        value: data[index++],
        done: index > data.length,
      }),
    };
  }
}

 
const processor = DataProcessor.create([1, 2, 3, 4, 5]);

 
for (const item of processor.filterData(num => num % 2 === 0)) {
  console.log('Filtered Item:', item);
}

 
processor.processDataAsync(async num => num * 2).then(processedData => {
  console.log('Processed Data:', processedData);
});

 
for (const item of processor) {
  console.log('Iterable Item:', item);
}
```