```javascript
class Fibonacci {
    constructor(limit) {
        this.limit = limit;
        this.memo = new Map();
    }

    *[Symbol.iterator]() {
        let [prev, curr] = [0, 1];
        for (let i = 0; i < this.limit; i++) {
            yield prev;
            [prev, curr] = [curr, this.memoizeFibo(i)];
        }
    }

    memoizeFibo(n) {
        if (this.memo.has(n)) return this.memo.get(n);
        const value = (n <= 1) ? n : this.memoizeFibo(n - 1) + this.memoizeFibo(n - 2);
        this.memo.set(n, value);
        return value;
    }
}

(async () => {
    const delay = ms => new Promise(res => setTimeout(res, ms));
    const fiboSequence = new Fibonacci(10);

    for await (let num of fiboSequence) {
        console.log(num);
        await delay(500);  
    }
})().catch(console.error);
