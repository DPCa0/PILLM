```javascript
 
(async () => {
  const { log } = await import('console');

   
  const handler = {
    get: (target, prop, receiver) => {
      if (prop === 'secret') {
        return 'Shh... This is a secret!';
      }
      return Reflect.get(...arguments);
    }
  };

  const data = new Proxy({ name: 'Alice', age: 30 }, handler);

   
  const fetchData = async () => {
     
    return new Promise((resolve, reject) => {
      setTimeout(() => resolve({ city: 'Wonderland' }), 1000);
    });
  };

   
  const fruits = ['apple', 'banana', 'grape'];
  const [first, ...rest] = fruits;

   
  const uniqueNumbers = new Set([1, 2, 3, 2, 1]);
  const userRoles = new Map([
    ['Alice', 'admin'],
    ['Bob', 'user']
  ]);

   
  const privateDataKey = Symbol('private');
  const person = {
    name: 'Charlie',
    [privateDataKey]: 'Sensitive Information'
  };

   
  function tag(strings, ...values) {
    return strings.reduce((acc, str, i) => `${acc}${str}<b>${values[i] || ''}</b>`, '');
  }
  const userName = 'Dave';
  const welcomeMessage = tag`Welcome, ${userName}!`;

   
  (async function main() {
    const cityData = await fetchData();
    log(welcomeMessage);
    log(`Name: ${data.name}, Age: ${data.age}, City: ${cityData.city}`);
    log(`Fruits: First - ${first}, Rest - ${rest.join(', ')}`);
    log(`Unique Numbers: ${[...uniqueNumbers].join(', ')}`);
    log(`User Roles: ${[...userRoles.entries()].map(([k, v]) => `${k}: ${v}`).join(', ')}`);
    log(`Symbol Data: ${person[privateDataKey]}`);
    log(`Proxy Secret: ${data.secret}`);
  })();

})();
```