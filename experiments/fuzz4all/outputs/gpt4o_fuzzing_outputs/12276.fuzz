print('Hello, world!');
```javascript
class Robot {
  #name;   
  static instances = 0;  

  constructor(name) {
    this.#name = name;
    Robot.instances++;
  }

  get name() {
    return this.#name;
  }

  static *generateNames() {
    const names = ["Robo1", "Robo2", "Robo3"];
    for (const name of names) {
      yield name;
    }
  }

  async greet() {
    const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
    await delay(1000);
    console.log(`Hello, I am ${this.name}`);
  }

  static async manageRobots() {
    const robots = [];
    for (const name of this.generateNames()) {
      const robot = new Robot(name);
      robots.push(robot);
      await robot.greet();
    }
    return robots;
  }

  [Symbol.iterator]() {
    let count = 0;
    const self = this;
    return {
      next() {
        return count < self.name.length 
          ? { value: self.name[count++], done: false } 
          : { done: true };
      }
    };
  }
}

 
(async () => {
  console.log(`Creating robots...`);
  const robots = await Robot.manageRobots();
  console.log(`Total robots created: ${Robot.instances}`);

  for (const robot of robots) {
    console.log(`Iterating through name of ${robot.name}:`);
    for (const char of robot) {
      console.log(char);
    }
  }
})();
```