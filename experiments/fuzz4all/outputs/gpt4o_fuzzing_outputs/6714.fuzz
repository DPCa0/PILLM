```javascript
 

 
const fibonacci = {
    *[Symbol.iterator]() {
        let [prev, curr] = [0, 1];
        while (true) {
            [prev, curr] = [curr, prev + curr];
            yield curr;
        }
    }
};

 
const fibCache = new Map();

function memoizedFibonacci(n) {
    if (fibCache.has(n)) {
        return fibCache.get(n);
    }
    let result = [...fibonacci].slice(0, n).pop();
    fibCache.set(n, result);
    return result;
}

 
async function asyncOperation(n) {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve(`Fibonacci(${n}) = ${memoizedFibonacci(n)}`);
        }, 1000);
    });
}

 
async function runCalculations() {
    const results = await Promise.all([asyncOperation(5), asyncOperation(10), asyncOperation(15)]);
    results.forEach(result => console.log(result));
}

 
const handler = {
    get(target, prop) {
        console.log(`Accessing property: ${prop}`);
        return target[prop];
    },
    set(target, prop, value) {
        console.log(`Setting property: ${prop} to ${value}`);
        target[prop] = value;
        return true;
    }
};

 
const obj = new Proxy({ name: "Fibonacci Calculator" }, handler);
console.log(obj.name);
obj.version = "1.0.0";

 
runCalculations();
```