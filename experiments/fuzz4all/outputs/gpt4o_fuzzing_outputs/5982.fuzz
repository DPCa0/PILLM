```javascript
 

class DataProcessor {
  constructor(data) {
    this.data = data;
  }

  async processData() {
    try {
      const processedData = await this.transformData(this.data);
      return this.summarizeData(processedData);
    } catch (error) {
      console.error('Error processing data:', error);
    }
  }

  async transformData(data) {
     
    return new Promise((resolve) => {
      setTimeout(() => {
        const transformed = data
          .map(({ id, value }) => ({
            id,
            value: value * 2,
            timestamp: new Date().toISOString()
          }))
          .filter(item => item.value > 10);
        resolve(transformed);
      }, 1000);
    });
  }

  summarizeData(data) {
    const totalValue = data.reduce((sum, { value }) => sum + value, 0);
    return {
      count: data.length,
      totalValue
    };
  }
}

(async () => {
  const rawData = [
    { id: 1, value: 5 },
    { id: 2, value: 15 },
    { id: 3, value: 7 }
  ];

  const processor = new DataProcessor(rawData);
  const result = await processor.processData();
  console.log('Processed data summary:', result);
})();
```