```javascript
class Matrix {
  constructor(rows, cols) {
    this.rows = rows;
    this.cols = cols;
    this.data = Array.from({ length: rows }, () => Array.from({ length: cols }, () => Math.random()));
  }

   
  static add(m1, m2) {
    if (m1.rows !== m2.rows || m1.cols !== m2.cols) throw new Error('Matrices must have the same dimensions');
    return new Matrix(m1.rows, m1.cols).map((_, i, j) => m1.data[i][j] + m2.data[i][j]);
  }

  map(fn) {
    this.data = this.data.map((row, i) => row.map((val, j) => fn(val, i, j)));
    return this;
  }

  *[Symbol.iterator]() {
    for (let row of this.data) yield row;
  }

  print() {
    console.table(this.data);
  }
}

 
const matrixHandler = {
  get(target, property) {
    if (property === 'rows' || property === 'cols') {
      return Reflect.get(target, property);
    }
    throw new Error('Attempt to access protected property');
  }
};

 
(async () => {
  const m1 = new Proxy(new Matrix(2, 2), matrixHandler);
  const m2 = new Proxy(new Matrix(2, 2), matrixHandler);

  const result = Matrix.add(m1, m2);

  const display = (matrix) => new Promise(resolve => {
    setTimeout(() => {
      console.log(`Matrix:\n${matrix}`);
      resolve();
    }, 1000);
  });

  await display(JSON.stringify([...result]));
})();
```