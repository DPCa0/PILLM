```javascript
class Matrix {
  constructor(data) {
    this.data = data;
  }

  static identity(size) {
    return new Matrix(Array.from({ length: size }, (_, i) =>
      Array.from({ length: size }, (_, j) => (i === j ? 1 : 0))
    ));
  }

  multiply(other) {
    if (this.data[0].length !== other.data.length) {
      throw new Error("Incompatible matrices");
    }

    let result = Array(this.data.length)
      .fill(null)
      .map(() => Array(other.data[0].length).fill(0));

    return new Matrix(
      result.map((row, i) =>
        row.map((_, j) =>
          this.data[i].reduce((sum, _, n) => sum + this.data[i][n] * other.data[n][j], 0)
        )
      )
    );
  }
}

(async () => {
  const delay = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

  const executeTasks = async (tasks) => {
    for await (const task of tasks) {
      await task();
    }
  };

  const tasks = [
    async () => {
      console.log("Task 1: Create Identity Matrix");
      const identityMatrix = Matrix.identity(3);
      console.table(identityMatrix.data);
      await delay(1000);
    },
    async () => {
      console.log("Task 2: Multiply Matrices");
      const m1 = new Matrix([
        [2, 3],
        [4, 5],
      ]);
      const m2 = new Matrix([
        [6, 7],
        [8, 9],
      ]);
      const product = m1.multiply(m2);
      console.table(product.data);
      await delay(1000);
    },
  ];

  console.log("Starting tasks...");
  await executeTasks(tasks);
  console.log("All tasks completed.");
})();
```