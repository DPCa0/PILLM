Certainly! Below is a JavaScript program that demonstrates the use of advanced features like Promises, async/await, and destructuring assignment.

```javascript
 
const fetchData = (url) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === 'https://api.example.com/data') {
        resolve({
          id: 1,
          name: 'John Doe',
          details: { age: 30, occupation: 'Software Developer' }
        });
      } else {
        reject('Invalid URL');
      }
    }, 1000);
  });
};

 
async function processData(url) {
  try {
    const { id, name, details: { age, occupation } } = await fetchData(url);
    
     
    const userInfo = {
      id,
      name,
      description: `${name} is a ${age} year-old ${occupation}.`
    };

    console.log(userInfo);
  } catch (error) {
    console.error(`Error fetching data: ${error}`);
  }
}

 
const displayResults = (resultFunc, ...urls) => {
  urls.forEach(url => resultFunc(url));
};

 
displayResults(processData, 'https://api.example.com/data', 'https://invalid.url');
```

This program uses a combination of modern JavaScript features to handle asynchronous operations and data manipulation.