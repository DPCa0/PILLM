```javascript
 
import fs from 'fs/promises';
import crypto from 'crypto';

async function complexOperation() {
  try {
     
    const buffer = crypto.randomBytes(64);
    
     
    const hexString = buffer.toString('hex');

     
    await fs.writeFile('randomHex.txt', hexString);

    console.log('Hex string written to file.');

     
    const data = await fs.readFile('randomHex.txt', 'utf8');
    
    console.log('Read from file:', data);

     
    const user = {
      name: 'Jane Doe',
      details: {
        age: 30,
        location: 'Unknown',
      },
    };

    const {
      name,
      details: { age, location },
    } = user;
    
    console.log(`User Info: Name - ${name}, Age - ${age}, Location - ${location}`);

     
    function* numberGenerator() {
      yield* [1, 2, 3, 4, 5];
    }

    const [first, second, ...rest] = numberGenerator();
    console.log(`First: ${first}, Second: ${second}, Rest: ${rest}`);

  } catch (error) {
    console.error('An error occurred:', error);
  }
}

complexOperation();
```