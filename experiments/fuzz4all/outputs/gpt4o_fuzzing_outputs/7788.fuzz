```javascript
 
const fetchData = async (url) => {
  try {
    let response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    let data = await response.json();

    return new Promise((resolve) => {
      setTimeout(() => resolve(data), 1000);  
    });
  } catch (error) {
    console.error(`Error fetching data: ${error}`);
    throw error;
  }
};

const processData = (data) => {
  const { name, age, hobbies } = data;
  const getHobbies = (hobbiesArray) =>
    hobbiesArray.map((hobby) => hobby.toUpperCase()).join(', ');

  return `${name}, aged ${age}, enjoys: ${getHobbies(hobbies)}`;
};

(async () => {
  try {
    const userData = await fetchData('https://api.example.com/user/123');
    const result = processData(userData);
    console.log(result);
  } catch (error) {
    console.error('Failed to process user data:', error);
  }
})();
```