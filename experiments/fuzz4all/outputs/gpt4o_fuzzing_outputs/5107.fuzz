class FibonacciSequence {
  constructor(limit) {
    this.limit = limit;
    this.memo = new Map([[0, 0], [1, 1]]);
  }
  
  *[Symbol.iterator]() {
    let [prev, curr] = [0, 1];
    for (let i = 0; i < this.limit; i++) {
      yield prev;
      [prev, curr] = [curr, prev + curr];
    }
  }

  memoizedFibonacci(n) {
    if (this.memo.has(n)) return this.memo.get(n);
    const value = this.memoizedFibonacci(n - 1) + this.memoizedFibonacci(n - 2);
    this.memo.set(n, value);
    return value;
  }
}

const limit = 10;
const fibonacciSequence = new FibonacciSequence(limit);

 
console.log(`Fibonacci sequence up to limit ${limit}:`);
for (const value of fibonacciSequence) {
  console.log(value);
}

 
console.log(`10th Fibonacci number using memoization: ${fibonacciSequence.memoizedFibonacci(10)}`);

 
async function fetchData(url) {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    console.log('Fetched data:', data);
  } catch (error) {
    console.error('Fetching error:', error);
  }
}

const dummyUrl = 'https://jsonplaceholder.typicode.com/posts/1';
fetchData(dummyUrl);

 
