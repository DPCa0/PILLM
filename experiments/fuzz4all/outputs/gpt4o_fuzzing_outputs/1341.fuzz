```javascript
 

 
async function fetchData(url) {
    return new Promise((resolve) => {
        setTimeout(() => {
            resolve(`Data from ${url}`);
        }, 1000);
    });
}

 
async function processData(urls) {
    const dataSet = new Set();
    const dataMap = new Map();

    for (const url of urls) {
        const data = await fetchData(url);
        dataSet.add(data);
        dataMap.set(url, data);
    }

    return { dataSet, dataMap };
}

 
const handler = {
    get(target, prop) {
        if (prop in target) {
            console.log(`Accessed property "${prop}":`, target[prop]);
            return target[prop];
        } else {
            console.error(`Property "${prop}" does not exist.`);
        }
    }
};

 
(async () => {
    const urls = ['https://api.example.com/data1', 'https://api.example.com/data2', 'https://api.example.com/data3'];
    const { dataSet, dataMap } = await processData(urls);

     
    const proxyDataMap = new Proxy(dataMap, handler);

     
    proxyDataMap.get(urls[0]);
    proxyDataMap.get(urls[1]);
    proxyDataMap.get('nonExistentURL');

     
    console.log('Unique data entries:', [...dataSet]);
})();
```