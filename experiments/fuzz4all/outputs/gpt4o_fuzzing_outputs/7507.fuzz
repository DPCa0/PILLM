class AsyncEventEmitter {
  constructor() {
    this.events = {};
  }

  on(event, listener) {
    if (!this.events[event]) {
      this.events[event] = new Set();
    }
    this.events[event].add(listener);
  }

  off(event, listener) {
    if (this.events[event]) {
      this.events[event].delete(listener);
    }
  }

  async emit(event, ...args) {
    if (this.events[event]) {
      await Promise.all([...this.events[event]].map(listener => listener(...args)));
    }
  }
}

async function fetchData(url) {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return await response.json();
}

function debounce(fn, delay) {
  let timer;
  return function (...args) {
    clearTimeout(timer);
    timer = setTimeout(() => fn(...args), delay);
  };
}

const eventEmitter = new AsyncEventEmitter();

eventEmitter.on('dataFetched', debounce(async (data) => {
  console.log('Debounced Data:', data);
}, 200));

(async function() {
  try {
    const data = await fetchData('https://jsonplaceholder.typicode.com/posts');
    eventEmitter.emit('dataFetched', data);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();

