const [first, ...rest] = [10, 20, 30, 40];
console.log(first);   
console.log(rest);   

const obj = { x: 1, y: 2, z: 3 };
const { x, ...otherProps } = obj;
console.log(x);   
console.log(otherProps);   

 
function* generator() {
    yield 1;
    yield 2;
    yield 3;
}

const gen = generator();
console.log(gen.next().value);