```javascript
const fetchData = async (url) => {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
    return await response.json();
  } catch (error) {
    console.error("Fetch error: ", error);
  }
};

class EventEmitter {
  constructor() {
    this.events = {};
  }
  
  on(event, listener) {
    if (!this.events[event]) this.events[event] = [];
    this.events[event].push(listener);
  }
  
  emit(event, ...args) {
    if (this.events[event]) this.events[event].forEach(listener => listener(...args));
  }
}

const performComplexCalculation = (x, y, callback) => {
  const result = x ** y + y ** x;
  callback(result);
};

 
const createValidatedObject = (initialData) => {
  return new Proxy(initialData, {
    get(target, prop) {
      console.log(`Getting ${prop}`);
      return prop in target ? target[prop] : undefined;
    },
    set(target, prop, value) {
      if (typeof value === 'number') {
        console.log(`Setting ${prop} to ${value}`);
        target[prop] = value;
        return true;
      }
      console.error(`Invalid type for ${prop}`);
      return false;
    }
  });
};

(async () => {
  const apiUrl = "https://jsonplaceholder.typicode.com/posts/1";
  const data = await fetchData(apiUrl);
  console.log(data);

  const emitter = new EventEmitter();
  emitter.on('calculate', (result) => console.log('Calculated result:', result));
  
  performComplexCalculation(3, 4, (result) => {
    emitter.emit('calculate', result);
  });
  
  const obj = createValidatedObject({ a: 1 });
  obj.a = 42;
  console.log(obj.a);
  obj.b = "Invalid";   
})();
