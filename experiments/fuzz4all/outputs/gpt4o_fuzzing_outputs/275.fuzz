print('Hello, world!');
```javascript
 

 
const fetchData = async (id) => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve({ id, name: `Item ${id}`, value: Math.random() * 100 });
    }, Math.random() * 2000);
  });
};

 
const processItems = async (items) => {
   
  const detailedItems = await Promise.all(items.map(item => fetchData(item)));

   
  const filteredItems = detailedItems
    .map(({ id, name, value }) => ({ id, name, value }))
    .filter(item => item.value > 50);

   
  filteredItems.sort((a, b) => b.value - a.value);

  return filteredItems;
};

 
(async () => {
  try {
    const initialItems = Array.from({ length: 5 }, (_, i) => i + 1);  
    const result = await processItems(initialItems);
    console.log('Filtered and sorted items:', result);
  } catch (error) {
    console.error('Error processing items:', error);
  }
})();
```