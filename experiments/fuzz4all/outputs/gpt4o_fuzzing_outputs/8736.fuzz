```javascript
 

class DataProcessor {
  constructor(data) {
    this.data = data;
  }

  process() {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        try {
          const processed = this.data.map(item => ({ ...item, processed: true }));
          resolve(processed);
        } catch (error) {
          reject('Processing failed');
        }
      }, 1000);
    });
  }
}

async function fetchData() {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve([
        { id: 1, value: 42 },
        { id: 2, value: 84 },
      ]);
    }, 1000);
  });
}

(async function main() {
  try {
    const rawData = await fetchData();
    console.log('Fetched data:', rawData);

    const processor = new DataProcessor(rawData);
    const processedData = await processor.process();

    console.log('Processed data:', processedData);

    const [{ id: firstId }, { value: secondValue }] = processedData;
    console.log(`First ID: ${firstId}, Second Value: ${secondValue}`);
  } catch (error) {
    console.error('Error:', error);
  }
})();
```