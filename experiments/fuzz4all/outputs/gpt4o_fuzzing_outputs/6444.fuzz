```javascript
 
async function fetchJoke() {
  try {
    const response = await fetch('https://official-joke-api.appspot.com/random_joke');
    if (!response.ok) throw new Error('Network response was not ok');
    const joke = await response.json();

     
    const { setup, punchline } = joke;

     
    const jokeElement = document.createElement('div');
    jokeElement.innerHTML = `
      <h2>Random Joke</h2>
      <p><strong>Setup:</strong> ${setup}</p>
      <p><strong>Punchline:</strong> ${punchline}</p>
    `;

     
    document.body.appendChild(jokeElement);

  } catch (error) {
    console.error('Fetching joke failed:', error);
  }
}

 
(async () => {
  await fetchJoke();
})();

 
document.body.addEventListener('click', (event) => {
  if (event.target.tagName === 'P') {
    event.target.style.color = 'blue';
  }
});

 
const state = {
  darkMode: false,
};

const handler = {
  set(target, property, value) {
    console.log(`Property ${property} set to ${value}`);
    if (property === 'darkMode') {
      document.body.style.backgroundColor = value ? '#333' : '#fff';
      document.body.style.color = value ? '#fff' : '#000';
    }
    target[property] = value;
    return true;
  },
};

const stateProxy = new Proxy(state, handler);

 
setTimeout(() => {
  stateProxy.darkMode = !stateProxy.darkMode;
}, 5000);
```