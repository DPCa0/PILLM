```javascript
 
class DataFetcher {
  constructor(url) {
    this.url = url;
  }

  async fetchData() {
    try {
      const response = await fetch(this.url);
      if (!response.ok) throw new Error('Network response was not ok');
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('Failed to fetch data:', error);
    }
  }

  async processData() {
    const data = await this.fetchData();
    if (!data) return;

    const { results } = data;
    return results.map(({ name: { first, last }, email }) => ({
      fullName: `${first} ${last}`,
      email
    }));
  }
}

(async function() {
  const url = 'https://randomuser.me/api/?results=5';
  const dataFetcher = new DataFetcher(url);

  const processedData = await dataFetcher.processData();
  if (processedData) {
    processedData.forEach(({ fullName, email }) => {
      console.log(`Name: ${fullName}, Email: ${email}`);
    });
  }
})();
