```javascript
 
const asyncOperation = (num) => new Promise((resolve, reject) => {
  setTimeout(() => {
    if (num % 2 === 0) {
      resolve(num * 2);
    } else {
      reject('Odd number not allowed');
    }
  }, 1000);
});

 
class AdvancedCalculator {
  #value = 0;  

  constructor(initialValue) {
    this.#value = initialValue;
  }

   
  increment = () => {
    this.#value++;
    return this.#value;
  }

  static async computeAsync(numbers) {
    const results = [];

    for (const num of numbers) {
      try {
         
        const result = await asyncOperation(num);
        results.push(result);
      } catch (error) {
        results.push(error);
      }
    }

    return results;
  }
}

 
const handler = {
  get(target, prop) {
    if (prop in target) {
      return target[prop];
    } else {
      return `Property ${prop} doesn't exist`;
    }
  }
};

const calculatorProxy = new Proxy(new AdvancedCalculator(5), handler);

// IIFE (Immediately Invoked Function Expression) using async/await
(async () => {
  const numbers = [1, 2, 3, 4, 5];
  const results = await AdvancedCalculator.computeAsync(numbers);
  
  console.log('Async Results:', results);

  console.log('Initial Value:', calculatorProxy.#value); // Private access via proxy will fail
  console.log('Incremented Value:', calculatorProxy.increment());
  console.log('Non-existent Property:', calculatorProxy.nonExistentProp);
})();
```