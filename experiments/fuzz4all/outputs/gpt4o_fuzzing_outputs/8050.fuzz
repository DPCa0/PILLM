```javascript
 
async function fetchRandomAdvice() {
  try {
    const response = await fetch('https://api.adviceslip.com/advice');
    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
    const data = await response.json();
    console.log(`Advice #${data.slip.id}: ${data.slip.advice}`);
  } catch (error) {
    console.error('Error fetching advice:', error);
  }
}

 
const loggingHandler = {
  get(target, property, receiver) {
    console.log(`Property '${property}' has been accessed`);
    return Reflect.get(target, property, receiver);
  }
};

 
const user = {
  name: 'Alice',
  age: 30
};
const proxiedUser = new Proxy(user, loggingHandler);
console.log(proxiedUser.name);  
console.log(proxiedUser.age);   

 
(() => {
  console.log('Running an IIFE using an Arrow Function');
})();

 
function* fibonacciGenerator(n) {
  let a = 0, b = 1;
  while (n--) {
    yield a;
    [a, b] = [b, a + b];
  }
}

const fibSeq = fibonacciGenerator(10);
for (const num of fibSeq) {
  console.log(num);
}

 
const teams = new Map([
  ['Team A', ['Alice', 'Bob']],
  ['Team B', ['Charlie', 'Dave']]
]);

const members = new Set();
teams.forEach(teamMembers => teamMembers.forEach(member => members.add(member)));
console.log('All Team Members:', Array.from(members));

 
fetchRandomAdvice();
