print('Hello, world!');
```javascript
 

 
const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

 
async function fetchData() {
    await delay(1000);  
    return { id: 1, name: 'John Doe', age: 28, hobbies: ['reading', 'coding', 'hiking'] };
}

 
const handler = {
    get: (target, prop) => {
        console.log(`Property '${prop}' has been accessed.`);
        return prop in target ? target[prop] : `Property '${prop}' does not exist.`;
    }
};

 
(async function main() {
    try {
         
        const userData = await fetchData();

         
        const { name, age, hobbies: [firstHobby, ...otherHobbies] } = userData;
        console.log(`User: ${name}, Age: ${age}`);
        console.log(`First Hobby: ${firstHobby}`);
        console.log(`Other Hobbies: ${otherHobbies.join(', ')}`);

         
        const userClone = { ...userData };

         
        const proxiedUser = new Proxy(userClone, handler);

         
        console.log(`Accessing name: ${proxiedUser.name}`);
        console.log(`Accessing non-existing property: ${proxiedUser.nonExistent}`);
    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```