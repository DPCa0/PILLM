```javascript
 
async function fetchData(url) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === "https://api.example.com/data") {
        resolve({ data: [1, 2, 3, 4, 5] });
      } else {
        reject("Invalid URL");
      }
    }, 1000);
  });
}

 
function* processData(data) {
  for (let item of data) {
    yield item * 2;
  }
}

 
(async () => {
  try {
     
    const { data } = await fetchData("https://api.example.com/data");

     
    const processedData = [...processData(data)];

     
    const dataMap = new Map();
    const dataSet = new Set(processedData);

    processedData.forEach((value, index) => {
      dataMap.set(index, value);
    });

     
    const logMessage = (strings, ...values) =>
      strings.raw.reduce((acc, str, i) => `${acc}${str}${values[i] || ""}`, "");

    console.log(logMessage`Original data: ${data}`);
    console.log(logMessage`Processed data: ${processedData}`);
    console.log(`Data map: ${JSON.stringify(Array.from(dataMap.entries()))}`);
    console.log(`Unique processed data (Set): ${JSON.stringify([...dataSet])}`);
  } catch (error) {
    console.error(`Error fetching data: ${error}`);
  }
})();
```