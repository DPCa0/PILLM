print('Hello, world!');
```javascript
 

 
const fetchData = () => new Promise((resolve) => {
  setTimeout(() => resolve({ data: 'Hello, World!' }), 1000);
});

 
const handler = {
  get: (target, property) => {
    console.log(`Property '${property}' accessed.`);
    return target[property];
  }
};

 
function* numberGenerator(start = 0) {
  let num = start;
  while (true) {
    yield num++;
  }
}

 
(async () => {
   
  const dataPromise = fetchData();
  
   
  const proxyObj = new Proxy(await dataPromise, handler);

   
  console.log(proxyObj.data);

   
  const numGen = numberGenerator();
  console.log(`Next number: ${numGen.next().value}`);
  console.log(`Next number: ${numGen.next().value}`);
})();
```