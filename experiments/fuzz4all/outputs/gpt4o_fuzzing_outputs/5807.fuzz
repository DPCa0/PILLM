print('Hello, world!');
```javascript
 

 
const fetchData = (ms, data) => new Promise(resolve => setTimeout(() => resolve(data), ms));

 
const getUsersAndPosts = async () => {
   
  const [users, posts] = await Promise.all([
    fetchData(1000, [{ id: 1, name: 'Alice' }, { id: 2, name: 'Bob' }]),
    fetchData(1500, [{ userId: 1, title: 'Hello World' }, { userId: 2, title: 'JS Rocks' }])
  ]);

  return { users, posts };
};

 
class DataService {
  constructor(data) {
    this.data = data;
  }

  static filterPostsByUserId(posts, userId) {
    return posts.filter(post => post.userId === userId);
  }

   
  findUserByIdAndPosts(id) {
    const { users, posts } = this.data;
    const user = users.find(u => u.id === id);

     
    const userPosts = [...DataService.filterPostsByUserId(posts, id)];
    return { user, posts: userPosts };
  }
}

 
(async () => {
  try {
    const data = await getUsersAndPosts();
    const service = new DataService(data);

     
    const { user, posts } = service.findUserByIdAndPosts(1);

    console.log(`User: ${user.name}`);
    console.log('Posts:', posts.map(p => p.title));
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();
```