```javascript
class Person {
    #age;  
    constructor(name, age) {
        this.name = name;
        this.#age = age;
    }

    getAge() {
        return this.#age;
    }

    static async fetchRandomUser() {
        const response = await fetch('https://randomuser.me/api/');
        const data = await response.json();
        return new Person(data.results[0].name.first, data.results[0].dob.age);
    }
}

function* fibonacciGenerator() {
    let [prev, curr] = [0, 1];
    while (true) {
        yield curr;
        [prev, curr] = [curr, prev + curr];
    }
}

(async () => {
    const person = await Person.fetchRandomUser();
    console.log(`Random Person: ${person.name}, Age: ${person.getAge()}`);

    const fibonacci = fibonacciGenerator();
    console.log('Fibonacci Sequence:');
    for (const number of Array.from({ length: 10 }, () => fibonacci.next().value)) {
        console.log(number);
    }
})();

const double = x => x * 2;

const numbers = [1, 2, 3, 4, 5];
const doubledNumbers = numbers.map(double);

console.log('Doubled Numbers:', doubledNumbers);

const complexObject = {
    foo: {
        bar: {
            baz: 42,
            func: () => 'Hello, World!',
        }
    }
};

const {
    foo: {
        bar: { baz, func }
    }
} = complexObject;

console.log('Destructured Value:', baz);
console.log('Function Call:', func());
```