```javascript
 

 
async function fetchData(url) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === 'https://api.example.com/data') {
        resolve({ data: 'Some fetched data' });
      } else {
        reject(new Error('Invalid URL'));
      }
    }, 1000);
  });
}

 
const dataHandler = {
  get: (target, prop, receiver) => {
    console.log(`Property '${prop}' accessed.`);
    return Reflect.get(target, prop, receiver);
  },
  set: (target, prop, value) => {
    console.log(`Property '${prop}' set to '${value}'.`);
    target[prop] = value;
    return true;
  },
};

 
const dataObject = new Proxy({}, dataHandler);

 
async function processData() {
  try {
    console.log('Fetching data...');
    const response = await fetchData('https://api.example.com/data');
    
    console.log('Data fetched:', response.data);
    dataObject.fetchedData = response.data;
    
    console.log('Processing data...');
    dataObject.processedData = response.data.toUpperCase();
    console.log('Processed Data:', dataObject.processedData);
    
  } catch (error) {
    console.error('Error:', error);
  }
}

 
processData();
```