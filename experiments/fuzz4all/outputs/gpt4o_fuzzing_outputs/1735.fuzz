```javascript
 

function* idGenerator() {
    let id = 0;
    while (true) {
        yield ++id;
    }
}

const idGen = idGenerator();

const fetchData = url =>
    new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === 'https://api.example.com/data') {
                resolve({ data: 'Sample data' });
            } else {
                reject(new Error('404 Not Found'));
            }
        }, 1000);
    });

const handler = {
    get: (target, prop) => {
        if (prop in target) {
            return target[prop];
        } else {
            console.warn(`Property "${prop}" not found on target object.`);
            return null;
        }
    },
};

const dataProxy = new Proxy({}, handler);

async function processData(url) {
    try {
        console.log(`Fetching data from ${url}...`);
        const response = await fetchData(url);
        const dataId = idGen.next().value;
        dataProxy[dataId] = response.data;
        console.log(`Data fetched successfully: ID ${dataId} - "${dataProxy[dataId]}"`);
    } catch (error) {
        console.error(`Error fetching data: ${error.message}`);
    }
}

(async function main() {
    await processData('https://api.example.com/data');
    await processData('https://api.invalidurl.com/404');
    await processData('https://api.example.com/data');
})();
```