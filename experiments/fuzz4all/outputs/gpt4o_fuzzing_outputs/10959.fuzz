```javascript
 

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

 
function* dataGenerator() {
  yield 'Fetching data...';
  yield delay(2000).then(() => 'Data: User Profile');
  yield delay(1000).then(() => 'Data: User Settings');
  return 'All data fetched!';
}

 
async function fetchData() {
  const dataIter = dataGenerator();
  for await (const data of dataIter) {
    console.log(data);
  }
}

 
const user = { name: 'Alice', age: 25 };

const userProxy = new Proxy(user, {
  get(target, prop) {
    if (prop in target) {
      console.log(`Getting ${prop}: ${target[prop]}`);
      return target[prop];
    }
    console.log(`Property ${prop} not found.`);
    return undefined;
  },
  set(target, prop, value) {
    console.log(`Setting ${prop} to ${value}`);
    target[prop] = value;
    return true;
  }
});

 
Reflect.set(userProxy, 'name', 'Bob');
console.log(Reflect.get(userProxy, 'name'));

fetchData();
```