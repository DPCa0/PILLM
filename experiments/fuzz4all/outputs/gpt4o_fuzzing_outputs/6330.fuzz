```javascript
class DataFetcher {
  constructor(url) {
    this.url = url;
  }
  
  async *fetchDataGenerator() {
    const response = await fetch(this.url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    for (const item of data) {
      yield item;
    }
  }
}

async function processData() {
  const fetcher = new DataFetcher('https://jsonplaceholder.typicode.com/posts');
  const result = [];
  
  for await (const item of fetcher.fetchDataGenerator()) {
    result.push({
      id: item.id,
      title: item.title.toUpperCase(),
      summary: `${item.body.slice(0, 50)}...`
    });
  }
  
  return result;
}

(async () => {
  const processedData = await processData();
  console.table(processedData);
})();

function delayedTask(delay, value) {
  return new Promise(resolve => setTimeout(() => resolve(value), delay));
}

Promise.allSettled([
  delayedTask(1000, 'Task 1 completed'),
  delayedTask(2000, 'Task 2 completed'),
  delayedTask(1500, Promise.reject('Task 3 failed'))
]).then(results => {
  for (const { status, value, reason } of results) {
    if (status === 'fulfilled') {
      console.log(value);
    } else {
      console.error(reason);
    }
  }
});
```