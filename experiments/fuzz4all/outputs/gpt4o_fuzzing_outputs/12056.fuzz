```javascript
 

const fetchData = async (url) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === 'https://api.example.com/data') {
                resolve({ id: 1, name: 'Item 1', attributes: { color: 'blue', size: 'M' } });
            } else {
                reject('Invalid URL');
            }
        }, 1000);
    });
};

(async () => {
    try {
        const url = 'https://api.example.com/data';
        const data = await fetchData(url);

         
        const { id, name, attributes: { color, ...restAttributes } } = data;

         
        const updatedData = { ...data, name: 'Updated Item', attributes: { ...restAttributes, color: 'red' } };

        console.log('Original Data:', { id, name, color, restAttributes });
        console.log('Updated Data:', updatedData);
    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```