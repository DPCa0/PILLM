class EventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }

    emit(event, ...args) {
        if (this.events.has(event)) {
            this.events.get(event).forEach(listener => listener(...args));
        }
    }

    off(event, listenerToRemove) {
        if (!this.events.has(event)) return;
        const filteredListeners = this.events.get(event)
            .filter(listener => listener !== listenerToRemove);
        this.events.set(event, filteredListeners);
    }
}

const asyncOperation = async (data) => {
    return new Promise(resolve => setTimeout(() => resolve(`Processed: ${data}`), 1000));
};

const processData = async function* (items) {
    for (const item of items) {
        yield await asyncOperation(item);
    }
};

const main = async () => {
    const emitter = new EventEmitter();

    emitter.on('data', (data) => console.log(`Received: ${data}`));
    emitter.on('complete', () => console.log('All items processed.'));

    const items = ['item1', 'item2', 'item3'];
    const processor = processData(items);

    for await (const result of processor) {
        emitter.emit('data', result);
    }

    emitter.emit('complete');
};

main();
```