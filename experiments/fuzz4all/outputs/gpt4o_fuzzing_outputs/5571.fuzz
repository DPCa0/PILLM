```javascript
class Matrix {
  constructor(rows, cols, fill = 0) {
    this.rows = rows;
    this.cols = cols;
    this.data = Array.from({ length: rows }, () =>
      Array.from({ length: cols }, () => fill)
    );
  }

  static from(array) {
    const matrix = new Matrix(array.length, array[0].length);
    matrix.map((_, i, j) => array[i][j]);
    return matrix;
  }

  map(func) {
    this.data = this.data.map((row, i) =>
      row.map((val, j) => func(val, i, j))
    );
    return this;
  }

  add(other) {
    if (other instanceof Matrix) {
      this.map((val, i, j) => val + other.data[i][j]);
    } else {
      this.map(val => val + other);
    }
    return this;
  }

  multiply(other) {
    if (other instanceof Matrix) {
      if (this.cols !== other.rows)
        throw new Error("Columns of A must match rows of B.");
      let result = new Matrix(this.rows, other.cols);
      return result.map((_, i, j) => {
        return this.data[i].reduce(
          (sum, val, k) => sum + val * other.data[k][j],
          0
        );
      });
    } else {
      return this.map(val => val * other);
    }
  }

  static identity(size) {
    return new Matrix(size, size).map((_, i, j) => (i === j ? 1 : 0));
  }

  print() {
    console.table(this.data);
  }
}

 
const A = Matrix.from([
  [1, 2, 3],
  [4, 5, 6]
]);

const B = Matrix.from([
  [7, 8],
  [9, 10],
  [11, 12]
]);

const C = A.multiply(B);
C.print();  

const I = Matrix.identity(3);
I.print();  
```