```javascript
 

 
function fetchData(url) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === "https://api.example.com/data") {
                resolve({ 
                    data: [
                        { id: 1, name: "Alice", age: 30 },
                        { id: 2, name: "Bob", age: 25 },
                        { id: 3, name: "Carol", age: 35 }
                    ]
                });
            } else {
                reject("Invalid URL");
            }
        }, 1000);
    });
}

 
class UserProcessor {
    constructor(users) {
        this.users = users;
    }

     
    getNames() {
        return this.users.map(({ name }) => name);
    }

     
    *getUsersAboveAge(minAge) {
        for (let user of this.users) {
            if (user.age > minAge) {
                yield user;
            }
        }
    }
}

(async () => {
    try {
        const response = await fetchData("https://api.example.com/data");
        const { data: users } = response;  
        const userProcessor = new UserProcessor(users);

        console.log("User names:", userProcessor.getNames());
        
        console.log("Users older than 28:");
        for (let user of userProcessor.getUsersAboveAge(28)) {
            console.log(user);
        }

    } catch (error) {
        console.error("Error fetching data:", error);
    }
})();
```