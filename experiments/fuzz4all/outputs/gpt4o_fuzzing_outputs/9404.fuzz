print('Hello, world!');
```javascript
 

 
const fetchData = () => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      resolve({ data: 'Sample Data', status: 200 });
    }, 1000);
  });
};

 
const loggerDecorator = (fn) => {
  return async (...args) => {
    console.log('Starting function...');
    try {
      const result = await fn(...args);
      console.log('Function successful:', result);
      return result;
    } catch (error) {
      console.error('Function failed:', error);
      throw error;
    } finally {
      console.log('Function finished.');
    }
  };
};

 
const fetchWithLogging = loggerDecorator(fetchData);

 
const executeAsyncTask = async () => {
  try {
    const { data, status } = await fetchWithLogging();
    if (status === 200) {
      console.log(`Received data: ${data}`);
    }
  } catch (error) {
    console.error('Error during execution:', error);
  }
};

 
(async () => {
  console.log('Start Async Execution');
  await executeAsyncTask();
  console.log('End Async Execution');
})();
```