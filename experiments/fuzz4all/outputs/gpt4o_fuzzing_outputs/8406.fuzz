print('Hello, world!');
```javascript
 

const fetchData = async (url) => {
   
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === "https://api.example.com/data") {
        resolve({ data: { id: 1, value: "Sample Data" } });
      } else {
        reject(new Error("Network Error"));
      }
    }, 1000);
  });
};

const cacheHandler = {
  get: (target, name) => {
    return name in target ? target[name] : `Property ${name} is not available`;
  },
  set: (target, name, value) => {
    console.log(`Setting ${name} to ${JSON.stringify(value)}`);
    target[name] = value;
    return true;
  },
};

const cache = new Proxy({}, cacheHandler);

const getData = async (url) => {
  if (cache[url]) {
    console.log("Serving from cache");
    return cache[url];
  }

  try {
    const response = await fetchData(url);
    cache[url] = response.data;
    return response.data;
  } catch (error) {
    console.error(`Failed to fetch data: ${error.message}`);
    return null;
  }
};

 
(async () => {
  const data = await getData("https://api.example.com/data");
  console.log("Received Data:", data);

  const cachedData = await getData("https://api.example.com/data");
  console.log("Received Cached Data:", cachedData);
})();
```