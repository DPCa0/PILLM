```javascript
const fetchUserData = async () => {
  try {
    const response = await fetch('https://jsonplaceholder.typicode.com/users');
    if (!response.ok) throw new Error('Network response was not ok');
    return await response.json();
  } catch (error) {
    console.error('Fetching error:', error);
  }
};

class UserProcessor {
  #users = [];

  constructor(users) {
    this.#users = users;
  }

  filterUsersByCompanyName(companyName) {
    return this.#users.filter(user => user.company.name.includes(companyName));
  }

  getUserDetails() {
    return this.#users.map(({ name, email, company: { name: companyName } }) => ({
      name,
      email,
      companyName
    }));
  }

  async updateUserEmails() {
    const emailUpdates = this.#users.map(({ id }) => this.#generateNewEmail(id));
    const newEmails = await Promise.all(emailUpdates);
    this.#users = this.#users.map((user, index) => ({ ...user, email: newEmails[index] }));
  }

  #generateNewEmail(userId) {
    return new Promise(resolve => {
      setTimeout(() => {
        resolve(`user${userId}@newdomain.com`);
      }, 100);
    });
  }
}

const main = async () => {
  const users = await fetchUserData();
  if (!users) return;

  const userProcessor = new UserProcessor(users);
  console.log('All Users:', userProcessor.getUserDetails());

  await userProcessor.updateUserEmails();
  console.log('Updated Users:', userProcessor.getUserDetails());

  const filteredUsers = userProcessor.filterUsersByCompanyName('Group');
  console.log('Filtered Users:', filteredUsers);
};

main();
```