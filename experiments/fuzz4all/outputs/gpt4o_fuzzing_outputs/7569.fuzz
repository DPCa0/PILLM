print('Hello, world!');
```javascript
 
async function* fetchDataSimulator() {
    const dataChunks = ['Data Part 1', 'Data Part 2', 'Data Part 3'];
    for (const chunk of dataChunks) {
        yield new Promise(resolve => setTimeout(() => resolve(chunk), 1000));
    }
}

 
const target = {
    message: 'Hello, advanced JavaScript!'
};

const handler = {
    get: (obj, prop) => {
        console.log(`Accessing property "${prop}"`);
        return obj[prop];
    }
};

const proxy = new Proxy(target, handler);

 
async function demonstrateAdvancedFeatures() {
    console.log('Starting data fetch simulation...');

     
    for await (const data of fetchDataSimulator()) {
        console.log(`Fetched: ${data}`);
    }

    console.log('Data fetch complete. Accessing proxy object...');

     
    console.log(proxy.message);

    console.log('Advanced JavaScript features demonstration complete.');
}

 
demonstrateAdvancedFeatures();
```