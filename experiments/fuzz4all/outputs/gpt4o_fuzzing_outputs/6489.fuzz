```javascript
class ComplexOperation {
  #privateValue = 42;

  static async fetchData(url) {
    const response = await fetch(url);
    return response.json();
  }

  *generateFibonacci(n) {
    let a = 0, b = 1;
    while (n--) {
      yield a;
      [a, b] = [b, a + b];
    }
  }

  async processAsyncTasks(urls) {
    const results = await Promise.all(urls.map(url => ComplexOperation.fetchData(url)));
    return results.reduce((acc, data) => acc.concat(data), []);
  }

  applyAdvancedMath(numbers) {
    return numbers.map(num => Math.pow(num, 2))
                  .filter(num => num % 2 === 0)
                  .reduce((acc, num) => acc + num, this.#privateValue);
  }
}

(async () => {
  const operation = new ComplexOperation();

   
  const fib = operation.generateFibonacci(10);
  console.log('Fibonacci sequence:', [...fib]);

   
  const urls = ['https://api.example.com/data1', 'https://api.example.com/data2'];
  try {
    const data = await operation.processAsyncTasks(urls);
    console.log('Fetched data:', data);
  } catch (error) {
    console.error('Error fetching data:', error);
  }

   
  const numbers = [1, 2, 3, 4, 5, 6];
  const result = operation.applyAdvancedMath(numbers);
  console.log('Result of advanced math operations:', result);
})();
```