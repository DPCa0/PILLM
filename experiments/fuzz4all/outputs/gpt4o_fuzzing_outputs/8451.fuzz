```javascript
 

async function* fetchData() {
  const urls = ['https://api.exapmle1.com/data', 'https://api.example2.com/info'];

   
  const dataPromises = urls.map(url =>
    fetch(url)
      .then(response => response.json())
      .catch(err => ({ error: `Error fetching from ${url}: ${err.message}` }))
  );

  const results = await Promise.all(dataPromises);

   
  for (const { data, error } of results) {
    if (error) {
      yield { error };
    } else {
      yield { data };
    }
  }
}

 
async function processData() {
  const dataGenerator = fetchData();

  for await (const { data, error } of dataGenerator) {
    if (error) {
      console.log(error);
    } else {
       
      const processedData = data.map(item => ({
        ...item,
        timestamp: new Date(item.timestamp).toLocaleString(),
        processedValue: item.value * Math.random(),
      }));
      console.log('Processed Data:', processedData);
    }
  }
}

processData();
```