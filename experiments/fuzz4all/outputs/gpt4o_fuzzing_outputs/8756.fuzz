```javascript
class Scheduler {
    constructor() {
        this.queue = [];
    }

    addTask(task, delay) {
        const taskPromise = new Promise((resolve) => {
            setTimeout(() => {
                resolve(task());
            }, delay);
        });
        this.queue.push(taskPromise);
    }

    async runTasks() {
        for (const task of this.queue) {
            try {
                const result = await task;
                console.log(`Task result: ${result}`);
            } catch (error) {
                console.error(`Error executing task: ${error}`);
            }
        }
    }
}

const fetchData = async (url) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`Failed to fetch ${url}`);
    return response.json();
};

const scheduler = new Scheduler();
const urls = [
    'https://jsonplaceholder.typicode.com/posts/1',
    'https://jsonplaceholder.typicode.com/posts/2',
    'https://jsonplaceholder.typicode.com/posts/3',
];

urls.forEach((url, index) => {
    scheduler.addTask(() => fetchData(url), index * 1000);
});

scheduler.runTasks();

 
const logger = {
    log: (message) => console.log(`[LOG]: ${message}`),
    warn: (message) => console.warn(`[WARN]: ${message}`),
    error: (message) => console.error(`[ERROR]: ${message}`),
};

const handler = {
    get: (target, propKey) => {
        return function(...args) {
            console.log(`Called ${propKey} with args: ${JSON.stringify(args)}`);
            return target[propKey](...args);
        };
    },
};

const proxiedLogger = new Proxy(logger, handler);

proxiedLogger.log("Starting the task scheduler");
proxiedLogger.warn("This is a warning");
proxiedLogger.error("An error occurred");
```