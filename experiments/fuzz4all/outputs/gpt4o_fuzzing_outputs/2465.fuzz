print('Hello, world!');
```javascript
class Matrix {
  constructor(rows, cols, elements = []) {
    this.rows = rows;
    this.cols = cols;
    this.elements = elements.length ? elements : Array(rows * cols).fill(0);
  }

  static from2DArray(array) {
    const rows = array.length;
    const cols = array[0].length;
    const elements = array.flat();
    return new Matrix(rows, cols, elements);
  }

  [Symbol.iterator]() {
    let row = 0, col = 0;
    return {
      next: () => {
        if (row < this.rows) {
          const value = this.elements[row * this.cols + col];
          col++;
          if (col === this.cols) {
            col = 0;
            row++;
          }
          return { value, done: false };
        }
        return { done: true };
      }
    };
  }

  *transpose() {
    for (let c = 0; c < this.cols; c++) {
      let transposedRow = [];
      for (let r = 0; r < this.rows; r++) {
        transposedRow.push(this.elements[r * this.cols + c]);
      }
      yield transposedRow;
    }
  }
}

const matrix = Matrix.from2DArray([
  [1, 2, 3],
  [4, 5, 6],
  [7, 8, 9]
]);

console.log('Matrix:');
for (const value of matrix) {
  process.stdout.write(value + ' ');
}
console.log('\nTransposed:');
for (const row of matrix.transpose()) {
  console.log(row.join(' '));
}
```