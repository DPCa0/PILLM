```javascript
class AsyncIterableQueue {
    constructor() {
        this.queue = [];
        this.resolvers = [];
        this.done = false;
    }

    enqueue(item) {
        if (this.done) throw new Error("Cannot enqueue to a completed queue.");
        if (this.resolvers.length > 0) {
            const resolve = this.resolvers.shift();
            resolve({ value: item, done: false });
        } else {
            this.queue.push(item);
        }
    }

    dequeue() {
        return new Promise((resolve) => {
            if (this.queue.length > 0) {
                const item = this.queue.shift();
                resolve({ value: item, done: false });
            } else if (this.done) {
                resolve({ value: undefined, done: true });
            } else {
                this.resolvers.push(resolve);
            }
        });
    }

    complete() {
        while (this.resolvers.length > 0) {
            const resolve = this.resolvers.shift();
            resolve({ value: undefined, done: true });
        }
        this.done = true;
    }

    [Symbol.asyncIterator]() {
        return {
            next: () => this.dequeue()
        };
    }
}

async function processQueue() {
    const queue = new AsyncIterableQueue();
    
     
    setTimeout(() => queue.enqueue("First Item"), 100);
    setTimeout(() => queue.enqueue("Second Item"), 200);
    setTimeout(() => queue.enqueue("Third Item"), 300);
    setTimeout(() => queue.complete(), 400);

    for await (let item of queue) {
        console.log(item);
    }
}

processQueue();
