print('Hello, world!');
```javascript
 

 
function* fetchData() {
  yield new Promise(resolve => setTimeout(() => resolve({ id: 1, value: 'Item 1' }), 1000));
  yield new Promise(resolve => setTimeout(() => resolve({ id: 2, value: 'Item 2' }), 1000));
  yield new Promise(resolve => setTimeout(() => resolve({ id: 3, value: 'Item 3' }), 1000));
}

 
async function processData() {
  const dataGenerator = fetchData();
  const results = [];
  
  for await (const dataPromise of dataGenerator) {
    const { id, value } = await dataPromise;  
    results.push({ id, value });
  }
  return results;
}

 
const handler = {
  get(target, property) {
    console.log(`Accessing property "${property}"`);
    return Reflect.get(...arguments);
  }
};

 
processData().then(results => {
  const proxyResults = new Proxy(results, handler);
  proxyResults.forEach(item => {
    console.log(`Item: ${item.value}`);
  });
});
```