Certainly! Below is a JavaScript program utilizing advanced features such as Promises, async/await, and destructuring assignment:

```javascript
 
const fetchData = (url) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === "https://api.example.com/data") {
                resolve({ status: 200, data: { user: { name: "Alice", age: 30 }, settings: { theme: "dark", notifications: true } } });
            } else {
                reject({ status: 404, message: "Not Found" });
            }
        }, 1000);
    });
};

 
const getDataAndProcess = async (url) => {
    try {
         
        const { status, data: { user, settings: { theme } } } = await fetchData(url);
        
        if (status === 200) {
            console.log(`User: ${user.name}, Age: ${user.age}, Preferred Theme: ${theme}`);
        }
    } catch (error) {
        console.error(`Error: ${error.message}, Status Code: ${error.status}`);
    }
};

 
getDataAndProcess("https://api.example.com/data");
```

This script simulates fetching data asynchronously and processes it using advanced JavaScript features.