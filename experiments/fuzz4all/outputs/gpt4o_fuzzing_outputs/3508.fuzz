```javascript
 
const dataProxy = (target) => {
  return new Proxy(target, {
    get(obj, prop) {
      if (prop in obj) {
        console.log(`Accessing property "${prop}":`, obj[prop]);
        return obj[prop];
      } else {
        console.log(`Property "${prop}" not found`);
        return null;
      }
    },
    set(obj, prop, value) {
      console.log(`Setting property "${prop}" to:`, value);
      obj[prop] = value;
      return true;
    }
  });
};

const fetchData = () => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve({ id: 1, name: 'JavaScript Mastery' });
    }, 1000);
  });
};

const processAsyncData = async () => {
  const data = await fetchData();
  const proxiedData = dataProxy(data);
  
  console.log('Initial Data:', proxiedData);

  proxiedData.name = 'Advanced JS Techniques';
  console.log('Updated Data:', proxiedData);
  
  console.log('Non-existing Property Access:', proxiedData.nonExistent);
};

processAsyncData();
```