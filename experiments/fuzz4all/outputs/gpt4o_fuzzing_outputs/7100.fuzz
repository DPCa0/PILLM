```javascript
 
function* fibonacci(limit) {
    let [prev, curr] = [0, 1];
    for (let i = 0; i < limit; i++) {
        [prev, curr] = [curr, prev + curr];
        yield curr;
    }
}

 
const complexObject = {
    a: 1,
    b: 2,
    c: 3,
    get sum() {
        return this.a + this.b + this.c;
    }
};

const handler = {
    get(target, prop, receiver) {
        console.log(`Accessing property '${prop}'`);
        return Reflect.get(...arguments);
    },
    set(target, prop, value) {
        console.log(`Setting property '${prop}' to '${value}'`);
        return Reflect.set(...arguments);
    }
};

const proxyObject = new Proxy(complexObject, handler);

 
async function fetchData() {
    const data = await new Promise(resolve => setTimeout(() => resolve('Fetched Data'), 1000));
    console.log(data);
    return data;
}

function processData(data) {
    return new Promise(resolve => {
        console.log(`Processing: ${data}`);
        setTimeout(() => resolve(`${data} -> Processed`), 1000);
    });
}

 
async function main() {
     
    console.log('Fibonacci Sequence:');
    for (const num of fibonacci(5)) {
        console.log(num);
    }

     
    console.log('Sum:', proxyObject.sum);
    proxyObject.a = 5;
    console.log('Updated Sum:', proxyObject.sum);

     
    const fetchedData = await fetchData();
    const processedData = await processData(fetchedData);
    console.log('Final Result:', processedData);
}

main();
```