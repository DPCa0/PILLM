```javascript
 

class WeatherFetcher {
  constructor(apiKey) {
    this.apiKey = apiKey;
    this.baseUrl = 'https://api.openweathermap.org/data/2.5/weather';
  }

  async getWeather(city) {
    const url = `${this.baseUrl}?q=${city}&appid=${this.apiKey}&units=metric`;
    try {
      const response = await fetch(url);
      if (!response.ok) throw new Error('City not found');
      const data = await response.json();
      return this.formatWeather(data);
    } catch (error) {
      console.error('Error fetching weather:', error);
    }
  }

  formatWeather(data) {
    const { main: { temp }, weather: [{ description }], name } = data;
    return `The weather in ${name} is ${description} with a temperature of ${temp}°C.`;
  }
}

const apiKey = 'your_api_key_here';   
const city = 'London';

(async () => {
  const fetcher = new WeatherFetcher(apiKey);
  const weatherReport = await fetcher.getWeather(city);
  console.log(weatherReport);
})();
```