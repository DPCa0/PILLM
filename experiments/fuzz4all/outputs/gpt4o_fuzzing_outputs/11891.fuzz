print('Hello, world!');
```javascript
 

(async () => {
   
  const uniqueItems = new Set([1, 2, 3, 4, 5]);

   
  const itemsMap = new Map();
  uniqueItems.forEach(item => itemsMap.set(item, item * 2));

   
  const fetchData = async (key) => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (itemsMap.has(key)) {
          resolve(`Data for ${key}: ${itemsMap.get(key)}`);
        } else {
          reject(`No data found for ${key}`);
        }
      }, 1000);
    });
  };

  try {
     
    const results = await Promise.all([...uniqueItems].map(async (item) => await fetchData(item)));
    console.log(results.join('\n'));
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();
```