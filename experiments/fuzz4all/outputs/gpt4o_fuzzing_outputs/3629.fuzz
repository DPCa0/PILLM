print('Hello, world!');
```javascript
 

(async () => {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/users');
    
     
    if (!response.ok) throw new Error('Failed to fetch users');
    
    const users = await response.json();
    
     
    const processedUsers = users.map(({ id, name, address: { city } }) => ({ id, name, city }));
    
     
    const additionalOperation = (userData) => new Promise((resolve) => {
      setTimeout(() => resolve(userData.map(user => ({ ...user, greeting: `Hello, ${user.name} from ${user.city}` }))), 1000);
    });

    const result = await additionalOperation(processedUsers);
    
     
    console.table(result.map(({ id, name, city, ...rest }) => ({
      ID: id,
      UserName: name,
      UserCity: city,
      ...rest,
    })));

  } catch (error) {
    console.error('Error:', error.message);
  }
})();
```