```javascript
 

 
async function fetchUserData() {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            resolve([
                { id: 1, name: 'Alice', age: 28 },
                { id: 2, name: 'Bob', age: 34 },
                { id: 3, name: 'Charlie', age: 22 }
            ]);
        }, 1000);
    });
}

 
async function processUserData() {
    try {
        const users = await fetchUserData();
        const [user1, ...otherUsers] = users;

        console.log(`First user: ${user1.name}, Age: ${user1.age}`);

        const averageAge = otherUsers.reduce((acc, { age }) => acc + age, 0) / otherUsers.length;
        
        console.log(`Average age of other users: ${averageAge}`);

        otherUsers.forEach(({ name, age }) => {
            console.log(`User: ${name}, Age: ${age}`);
        });

    } catch (error) {
        console.error('Error fetching user data:', error);
    }
}

processUserData();
```