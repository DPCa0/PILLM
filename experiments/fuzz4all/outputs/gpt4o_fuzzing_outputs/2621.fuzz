Certainly! Here's a JavaScript program utilizing advanced features like Promises, async/await, generator functions, and destructuring:

```javascript
// A utility function to simulate asynchronous operations with Promises
function asyncOperation(ms, value) {
  return new Promise((resolve) => setTimeout(() => resolve(value), ms));
}

// An async function to fetch data concurrently
async function fetchData() {
  const [user, posts, comments] = await Promise.all([
    asyncOperation(1000, { id: 1, name: 'Alice' }),
    asyncOperation(1500, [
      { id: 1, userId: 1, title: 'Post 1' },
      { id: 2, userId: 1, title: 'Post 2' }
    ]),
    asyncOperation(500, [
      { id: 1, postId: 1, body: 'Great post!' },
      { id: 2, postId: 1, body: 'Thanks for sharing!' }
    ])
  ]);

  return { user, posts, comments };
}

 
function* arrayIterator(array) {
  for (const item of array) {
    yield item;
  }
}

 
(async function main() {
  const { user, posts, comments } = await fetchData();

  console.log(`User: ${user.name}`);

  const postIterator = arrayIterator(posts);
  for (const post of postIterator) {
    console.log(`Post: ${post.title}`);
    
    const postComments = comments.filter(comment => comment.postId === post.id);
    for (const { body } of postComments) {
      console.log(`  Comment: ${body}`);
    }
  }
})();
```

This script fetches user data, posts, and comments concurrently using `Promise.all` and then processes and logs them utilizing both `async/await` and generator functions.