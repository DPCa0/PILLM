```javascript
 

 
const fetchData = () =>
  new Promise((resolve, reject) => {
    setTimeout(() => {
      const data = { id: 1, name: 'JavaScript', type: 'Programming Language' };
      Math.random() > 0.1 ? resolve(data) : reject('Fetch error');
    }, 1000);
  });

class DataManager {
  constructor(data) {
    ({ id: this.id, name: this.name, type: this.type } = data);
  }

  display() {
    console.log(`ID: ${this.id}, Name: ${this.name}, Type: ${this.type}`);
  }
}

async function main() {
  try {
    const data = await fetchData();
    const manager = new DataManager(data);
    manager.display();
  } catch (error) {
    console.error(`An error occurred: ${error}`);
  }
}

main();
```