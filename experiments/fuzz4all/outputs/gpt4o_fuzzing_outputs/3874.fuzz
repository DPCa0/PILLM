print('Hello, world!');
```javascript
 

const asyncOperation = () => new Promise((resolve) => {
    setTimeout(() => resolve(Math.floor(Math.random() * 100)), 1000);
});

async function fetchData() {
    try {
        const data = await asyncOperation();
        console.log(`Fetched data: ${data}`);
        return data;
    } catch (error) {
        console.error('Error fetching data:', error);
    }
}

const handler = {
    get(target, prop, receiver) {
        if (prop === 'fetch') {
            return Reflect.get(target, prop, receiver);
        } else {
            return `Property ${prop} is not accessible`;
        }
    },
    apply(target, thisArg, argumentsList) {
        return `Operation not permitted. Attempt to call ${target.name}`;
    }
};

const proxiedFetchData = new Proxy(fetchData, handler);

 
(async () => {
    const result = await proxiedFetchData();   
    console.log('Result from proxied fetch:', result);

    console.log(proxiedFetchData.someOtherProperty);   
})();
```