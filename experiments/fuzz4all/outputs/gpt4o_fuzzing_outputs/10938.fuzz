import fs from 'fs/promises';
import { pipeline } from 'stream/promises';
import { createGzip } from 'zlib';

 
 
const processFile = async (inputPath, outputPath) => {
  try {
     
    const data = await fs.readFile(inputPath, 'utf-8');
    
     
    const transformedData = data.split('\n')
      .map(line => line.trim().toUpperCase())
      .filter(line => line.length > 0);

     
    await fs.writeFile('temp.txt', transformedData.join('\n'));

     
    await pipeline(
      fs.createReadStream('temp.txt'),
      createGzip(),
      fs.createWriteStream(outputPath)
    );
    
    console.log('File processed and compressed successfully.');
    
     
    await fs.unlink('temp.txt');
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

 
await processFile('input.txt', 'output.txt.gz');
```