```javascript
 
const handler = {
    get(target, prop, receiver) {
        if (prop in target) {
            console.log(`Getting property ${prop}`);
            return Reflect.get(target, prop, receiver);
        } else {
            console.warn(`Property ${prop} does not exist.`);
            return undefined;
        }
    },
    set(target, prop, value) {
        console.log(`Setting property ${prop} to ${value}`);
        return Reflect.set(target, prop, value);
    }
};

 
const complexObject = {
    data: {
        x: 10,
        y: 20,
        calculate: function() {
            return this.x + this.y;
        }
    },
    log() {
        console.log(`x: ${this.data.x}, y: ${this.data.y}`);
    }
};

 
const proxy = new Proxy(complexObject, handler);

 
const { data: { x, ...rest } } = proxy;
const newData = { x: 100, ...rest };

 
proxy.data.x = newData.x;
proxy.data.y = 50;

 
proxy.log();
console.log(`Calculated Value: ${proxy.data.calculate()}`);

 
(async function() {
    const { sqrt } = await import('mathjs');
    console.log(`Square root of 16 is: ${sqrt(16)}`);
})();
```