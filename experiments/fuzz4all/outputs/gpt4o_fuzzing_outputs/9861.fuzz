```javascript
 
import { readFile } from 'fs/promises';

 
async function fetchJsonData(filePath) {
  try {
     
    const data = await readFile(filePath, 'utf8');
     
    const jsonData = JSON.parse(data, (key, value) =>
      typeof value === 'string' ? value.toUpperCase() : value
    );
    return jsonData;
  } catch (error) {
    console.error('Error reading file:', error);
  }
}

 
function createTrackedObject(obj) {
  return new Proxy(obj, {
    get(target, property) {
      if (property in target) {
        console.log(`Property accessed: ${property}`);
        return target[property];
      }
      throw new ReferenceError(`Property ${property} does not exist.`);
    },
    set(target, property, value) {
      console.log(`Property set: ${property} = ${value}`);
      target[property] = value;
      return true;
    },
  });
}

(async () => {
   
  const { v4: uuidv4 } = await import('uuid');

   
  const uniqueID = uuidv4();
  console.log('Generated UUID:', uniqueID);

   
  const jsonData = await fetchJsonData('./data.json');
  console.log('Fetched JSON Data:', jsonData);

   
  const trackedObject = createTrackedObject({ hello: 'world', answer: 42 });
  console.log(trackedObject.hello);
  trackedObject.newProperty = 'New Value';
})();
```