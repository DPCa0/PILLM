print('Hello, world!');
```javascript
 
const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

 
const fetchData = async () => {
  await delay(1000);  
  return { data: "Fetched Data" };
};

 
const processData = async () => {
  const { data } = await fetchData();
  const additionalData = { ...data, extra: "Extra Data" };
  const { extra, ...rest } = additionalData;

  return { extra, rest };
};

 
function* numberGenerator() {
  let num = 0;
  while (true) {
    yield num++;
  }
}

 
const targetObject = { name: "John Doe", age: 30 };
const handler = {
  get(target, prop, receiver) {
    if (prop === 'age') {
      return `Age is a secret!`;
    }
    return Reflect.get(...arguments);
  }
};

const proxyObject = new Proxy(targetObject, handler);

 
class ExampleClass {
  #privateField = "Private Data";
  
  static staticMethod() {
    console.log("I'm a static method!");
  }
  
  getPrivateField() {
    return this.#privateField;
  }
}

 
(async () => {
  console.log("Hello, world!");

  const processed = await processData();
  console.log("Processed Data:", processed);

  const gen = numberGenerator();
  console.log("Generator Value:", gen.next().value);
  console.log("Generator Value:", gen.next().value);

  console.log("Proxy Access (name):", proxyObject.name);
  console.log("Proxy Access (age):", proxyObject.age);

  ExampleClass.staticMethod();
  const instance = new ExampleClass();
  console.log("Private Field Access:", instance.getPrivateField());
})();
```