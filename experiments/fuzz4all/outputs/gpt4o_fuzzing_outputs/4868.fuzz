Certainly! Here's a JavaScript program that uses advanced features such as async/await, Promises, ES6 features (like arrow functions, destructuring, template literals), and classes.

```javascript
class DataProcessor {
  constructor(data) {
    this.data = data;
  }

  async process() {
    try {
      const results = await Promise.all(this.data.map(item => this.enrichData(item)));
      return this.summarize(results);
    } catch (error) {
      console.error('Error processing data:', error);
      throw error;
    }
  }

  enrichData(item) {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (Math.random() > 0.1) { // Simulate occasional failure
          resolve({ ...item, enriched: true });
        } else {
          reject(new Error('Failed to enrich data'));
        }
      }, 100);
    });
  }

  summarize(results) {
    const successfulResults = results.filter(result => result.enriched);
    return {
      count: successfulResults.length,
      data: successfulResults,
    };
  }
}

// Usage example
(async () => {
  const inputData = [
    { id: 1, value: 'foo' },
    { id: 2, value: 'bar' },
    { id: 3, value: 'baz' },
  ];

  const processor = new DataProcessor(inputData);
  try {
    const summary = await processor.process();
    console.log(`Processed ${summary.count} items successfully.`);
    console.log('Processed Data:', summary.data);
  } catch (error) {
    console.error('Processing failed:', error);
  }
})();
```

This script defines a `DataProcessor` class that processes an array of data objects, simulates data enrichment with asynchronous operations using Promises, and summarizes the successful processing. The `enrichData` method randomly fails to simulate real-world conditions, and the `process` method handles these potential errors gracefully using try/catch.