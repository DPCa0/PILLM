```javascript
 

 
const fetchData = async (url) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === "https://api.example.com/data") {
        resolve({ id: 1, name: "Sample Data" });
      } else {
        reject("Invalid URL");
      }
    }, 1000);
  });
};

 
const handler = {
  get: (target, property) => {
    console.log(`Property '${property}' accessed`);
    return property in target ? target[property] : `Property '${property}' not found`;
  },
};

 
const main = async () => {
  try {
    const data = await fetchData("https://api.example.com/data");
    const proxiedData = new Proxy(data, handler);

     
    console.log(`Data ID: ${proxiedData.id}`);
    console.log(`Data Name: ${proxiedData.name}`);
    console.log(proxiedData.nonexistentProperty);  
  } catch (error) {
    console.error("Error fetching data:", error);
  }
};

 
main();
```