```javascript
(async () => {
  const fetchData = async (url) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
    return response.json();
  };

  const processData = async () => {
    try {
      const data = await fetchData('https://jsonplaceholder.typicode.com/posts');
      const result = data.reduce((acc, { userId, title }) => {
        acc[userId] = acc[userId] || [];
        acc[userId].push(title);
        return acc;
      }, {});
      return result;
    } catch (error) {
      console.error('Error fetching data:', error);
    }
  };

  class AsyncLogger {
    static async *[Symbol.asyncIterator]() {
      yield 'Starting async operations...';
      const data = await processData();
      yield 'Data processed successfully!';
      yield JSON.stringify(data, null, 2);
    }
  }

  const logger = new AsyncLogger();
  for await (const message of logger) {
    console.log(message);
  }
})();
```