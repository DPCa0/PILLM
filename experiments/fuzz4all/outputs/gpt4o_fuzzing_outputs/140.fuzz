```javascript
 

class DataProcessor {
    constructor(data) {
        this.data = data;
    }

    async processData() {
        try {
            const processedData = await this.fetchData();
            const filteredData = processedData.filter(item => item.isActive);
            this.logData(...filteredData);
        } catch (error) {
            console.error("Error processing data:", error);
        }
    }

    fetchData() {
         
        return new Promise((resolve, reject) => {
            setTimeout(() => {
                if (this.data) {
                    resolve(this.data);
                } else {
                    reject('No data available');
                }
            }, 1000);
        });
    }

    logData(...items) {
        items.forEach(({ id, value }) => {
            console.log(`ID: ${id}, Value: ${value}`);
        });
    }
}

const data = [
    { id: 1, value: 'Alpha', isActive: true },
    { id: 2, value: 'Beta', isActive: false },
    { id: 3, value: 'Gamma', isActive: true }
];

const processor = new DataProcessor(data);
processor.processData();
```