print('Hello, world!');
```javascript
 

 
async function fetchData(url) {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    return data;
  } catch (error) {
    console.error('Fetch error:', error);
  }
}

 
const handler = {
  get: (target, property) => {
    console.log(`Accessed property: ${property}`);
    return Reflect.get(target, property);
  }
};

 
(async () => {
  const url = 'https://jsonplaceholder.typicode.com/users/1';
  
   
  const userData = await fetchData(url);
  
  if (userData) {
     
    const { name, email, address: { city } } = userData;

     
    const proxiedUser = new Proxy(userData, handler);
    
     
    console.log(`User Name: ${proxiedUser.name}`);
    console.log(`Email: ${proxiedUser.email}`);
    console.log(`City: ${proxiedUser.address.city}`);

     
    console.log(`Destructured - Name: ${name}, Email: ${email}, City: ${city}`);
  }
})();
```