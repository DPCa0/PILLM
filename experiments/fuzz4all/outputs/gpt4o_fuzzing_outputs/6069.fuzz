```javascript
 

 
async function fetchData() {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve(['apple', 'banana', 'cherry']);
    }, 1000);
  });
}

 
const handler = {
  get: (target, prop) => {
    if (prop === 'getUpperCased') {
      return () => target.map(item => item.toUpperCase());
    }
    return target[prop];
  },
  set: (target, prop, value) => {
    console.log(`Setting value of ${prop} to ${value}`);
    target[prop] = value;
    return true;
  }
};

 
(async () => {
  try {
    console.log("Fetching data...");
    const data = await fetchData();
    
    const proxyData = new Proxy(data, handler);
    
    console.log("Original Data:", proxyData);
    console.log("Upper Cased Data:", proxyData.getUpperCased());
    
    proxyData.push('date');
    console.log("Modified Data:", proxyData);
  } catch (error) {
    console.error("Error fetching data:", error);
  }
})();
```