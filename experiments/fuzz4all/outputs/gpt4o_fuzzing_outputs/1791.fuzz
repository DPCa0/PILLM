```javascript
 
async function fetchData(url) {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
    const data = await response.json();
    return data;
  } catch (error) {
    console.error(`Fetch error: ${error}`);
  }
}

 
class DataManager {
  #privateData = [];

  static async loadData(url) {
    const data = await fetchData(url);
    const manager = new DataManager();
    manager.#privateData = data;
    return manager;
  }

  getData() {
    return [...this.#privateData];  
  }

  addData(item) {
    this.#privateData = [...this.#privateData, item];
  }
}

 
const handler = {
  get(target, property) {
    console.log(`Accessing property: ${property}`);
    return target[property];
  },
  set(target, property, value) {
    console.log(`Setting property: ${property} to ${value}`);
    target[property] = value;
    return true;
  }
};

 
(async () => {
  const manager = await DataManager.loadData('https://jsonplaceholder.typicode.com/posts');
  const proxyData = new Proxy(manager.getData(), handler);

   
  console.log(proxyData[0]);  
  proxyData.push({ id: 101, title: 'New Item' });  

  console.log('Final Data:', proxyData);
})();
```