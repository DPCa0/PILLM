print('Hello, world!');
```javascript
 

 
async function fetchData(url) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            const data = { success: true, data: { message: "Hello, World!" } };
            if (data.success) {
                resolve(data);
            } else {
                reject('Error fetching data');
            }
        }, 1000);
    });
}

 
const handler = {
    get: function(target, prop, receiver) {
        if (prop in target) {
            return Reflect.get(...arguments);
        } else {
            console.log(`Property '${prop}' not found on target`);
            return undefined;
        }
    }
};

(async () => {
    try {
         
        const result = await fetchData('https://api.example.com/data');
        const proxyData = new Proxy(result.data, handler);

         
        const { message } = proxyData;
        console.log(`Fetched Message: ${message}`);
        
         
        console.log(`Attempting to access a non-existent property: ${proxyData.nonExistentProp}`);

    } catch (error) {
        console.error(`Caught an error: ${error}`);
    }
})();
```