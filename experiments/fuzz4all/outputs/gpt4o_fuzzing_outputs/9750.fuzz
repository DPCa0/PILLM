print('Hello, world!');
```javascript
 
const complexModule = (() => {
   
  const dataMap = new Map();

   
  const id1 = Symbol('id');
  const id2 = Symbol('id');

   
  const privateMethods = new WeakMap();

  class ComplexClass {
    constructor(value) {
      this._value = value;
      privateMethods.set(this, {
        multiplyValue: () => this._value * 2
      });
    }

    showValue() {
      return this._value;
    }

    showMultipliedValue() {
      return privateMethods.get(this).multiplyValue();
    }
  }

   
  async function* asyncValueGenerator(array) {
    for (const item of array) {
       
      await new Promise((resolve) => setTimeout(resolve, 100));
      yield item * 2;
    }
  }

   
  dataMap.set(id1, new ComplexClass(10));
  dataMap.set(id2, new ComplexClass(20));

   
  const { showValue: show1 = () => 'No value' } = dataMap.get(id1) || {};
  const { showValue: show2 = () => 'No value' } = dataMap.get(id2) || {};

  return {
    dataMap,
    displayValues: () => {
      console.log(`Value 1: ${show1()}`);
      console.log(`Value 2: ${show2()}`);
    },
    async processAsyncValues() {
      const values = [1, 2, 3, 4];
      for await (const val of asyncValueGenerator(values)) {
        console.log(`Processed async value: ${val}`);
      }
    }
  };
})();

 
complexModule?.displayValues?.() ?? console.log('Display function is not available');

 
complexModule.processAsyncValues().catch(console.error);
```