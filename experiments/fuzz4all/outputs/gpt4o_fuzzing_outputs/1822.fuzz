```javascript
class ComplexCalculator {
    constructor() {
        this.cache = new Map();
    }

     
    *fibonacci(n) {
        let [prev, curr] = [0, 1];
        for (let i = 0; i < n; i++) {
            yield curr;
            [prev, curr] = [curr, prev + curr];
        }
    }

     
    async fetchData(x) {
        return new Promise(resolve => setTimeout(() => resolve(x * 2), 1000));
    }

     
    calculatePower(base, exponent) {
        const handler = {
            get: (target, prop) => {
                if (prop in target) {
                    console.log(`Fetching from cache: ${base}^${exponent}`);
                    return target[prop];
                } else {
                    console.log(`Calculating: ${base}^${exponent}`);
                    const result = Math.pow(base, exponent);
                    target[prop] = result;
                    return result;
                }
            }
        };
        
        return new Proxy(this.cache, handler)[`${base}^${exponent}`];
    }

     
    async calculateFibonacciSums(upTo) {
        const fibValues = [...this.fibonacci(upTo)];
        const results = await Promise.all(fibValues.map(async (value) => {
            const fetched = await this.fetchData(value);
            return fetched + value;
        }));
        return results;
    }
}

 
(async () => {
    const calculator = new ComplexCalculator();
    
    console.log('Power Calculation:');
    console.log(calculator.calculatePower(2, 3));
    console.log(calculator.calculatePower(2, 3));  
    
    console.log('\nFibonacci Sums:');
    const sums = await calculator.calculateFibonacciSums(5);
    console.log(sums);
})();
