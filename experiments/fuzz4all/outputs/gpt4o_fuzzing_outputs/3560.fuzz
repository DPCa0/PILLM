```javascript
class Matrix {
    constructor(data) {
        this.data = data;
    }

    static from(dimensions, fillFn) {
        const [rows, cols] = dimensions;
        return new Matrix(
            Array.from({ length: rows }, (_, i) =>
                Array.from({ length: cols }, (_, j) => fillFn(i, j))
            )
        );
    }

    *[Symbol.iterator]() {
        for (let row of this.data) {
            yield* row;
        }
    }

    map(fn) {
        return new Matrix(this.data.map((row, i) => row.map((val, j) => fn(val, i, j))));
    }

    toString() {
        return this.data.map(row => row.join(' ')).join('\n');
    }
}

const fibonacci = function* (length) {
    let [prev, curr] = [0, 1];
    for (let i = 0; i < length; i++) {
        yield prev;
        [prev, curr] = [curr, prev + curr];
    }
};

const fibMatrix = Matrix.from([5, 5], (i, j) => i * j).map(() => fibonacci(25).next().value);

const processMatrix = async matrix => {
    await new Promise(resolve => setTimeout(resolve, 1000));  
    console.log('Processed Matrix:');
    console.log(matrix.toString());
};

(async () => {
    console.log('Original Matrix:');
    console.log(fibMatrix.toString());
    await processMatrix(fibMatrix);
})();
```