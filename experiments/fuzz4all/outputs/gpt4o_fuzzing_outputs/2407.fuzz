```javascript
 

 
async function* asyncNumberGenerator(limit) {
    for (let i = 1; i <= limit; i++) {
         
        await new Promise(resolve => setTimeout(resolve, 100));
        yield i;
    }
}

 
const handler = {
    get(target, property) {
        console.log(`Getting property ${property}`);
        return property in target ? target[property] : 42;  
    },
    set(target, property, value) {
        console.log(`Setting property ${property} to ${value}`);
        target[property] = value;
        return true;
    }
};

 
const targetObject = { x: 10, y: 20 };
const proxyObject = new Proxy(targetObject, handler);

 
async function main() {
    console.log("Proxy and Generators in action:");
    
     
    console.log(proxyObject.x);  
    proxyObject.z = 30;  
    console.log(proxyObject.z);  

     
    const gen = asyncNumberGenerator(5);
    for await (const num of gen) {
        console.log(`Generated number: ${num}`);
    }
}

 
main();
```