print('Hello, world!');
```javascript
 

 
const fetchData = () => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            resolve({ id: 1, name: 'John Doe', email: 'john@example.com' });
        }, 2000);
    });
};

 
function* dataGenerator() {
    try {
        const data = yield fetchData();
        const { id, name, email } = data;
        console.log(`ID: ${id}, Name: ${name}, Email: ${email}`);
    } catch (error) {
        console.error("Error fetching data:", error);
    }
}

 
async function processData() {
    const iterator = dataGenerator();
    const { value: promise } = iterator.next();
    try {
        const result = await promise;
        iterator.next(result);
    } catch (error) {
        iterator.throw(error);
    }
}

 
processData();

 
const userMap = new Map();

(async () => {
    try {
        const userData = await fetchData();
        const { id, name, email } = userData;
        userMap.set(id, { name, email });

        for (const [userId, userInfo] of userMap) {
            console.log(`User ID: ${userId} => ${JSON.stringify(userInfo)}`);
        }
    } catch (err) {
        console.error("Error in map operation:", err);
    }
})();
```