print('Hello, world!');
```javascript
 

 
const fetchData = async () => {
    return new Promise((resolve) => {
        setTimeout(() => resolve(['apple', 'banana', 'cherry']), 1000);
    });
};

 
function* dataGenerator(data) {
    for (const item of data) {
        yield item;
    }
}

 
const dataHandler = {
    get(target, property) {
        if (property in target) {
            console.log(`Accessing property: ${property}`);
            return Reflect.get(target, property);
        } else {
            console.log(`Property ${property} does not exist`);
            return undefined;
        }
    }
};

 
(async function main() {
    const data = await fetchData();
    
    const dataProxy = new Proxy(data, dataHandler);
    const iterator = dataGenerator(dataProxy);

    console.log("Fetched data:");
    for (let item of iterator) {
        console.log(item);
    }

     
    console.log(`First element: ${dataProxy[0]}`);
    console.log(`Invalid property: ${dataProxy[10]}`);
})();
```