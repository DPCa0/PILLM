```javascript
 

class DataFetcher {
  constructor(url) {
    this.url = url;
  }

  async fetchData() {
    try {
      const response = await fetch(this.url);
      if (!response.ok) throw new Error('Network response was not ok');
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('Fetch error:', error);
      throw error;
    }
  }
}

function* dataProcessor(data) {
  for (let item of data) {
    yield `Processed: ${JSON.stringify(item)}`;
  }
}

(async () => {
  const url = 'https://jsonplaceholder.typicode.com/posts';
  const fetcher = new DataFetcher(url);

  try {
    const data = await fetcher.fetchData();
    const processedData = dataProcessor(data);

    for (let item of processedData) {
      console.log(item);
    }
  } catch (error) {
    console.error('Error processing data:', error);
  }
})();

function simulateAsyncOperation(result, delay = 1000) {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (Math.random() > 0.1) {
        resolve(result);
      } else {
        reject(new Error('Simulated operation failed'));
      }
    }, delay);
  });
}

async function handleMultiplePromises() {
  try {
    const results = await Promise.all([
      simulateAsyncOperation('First'),
      simulateAsyncOperation('Second'),
      simulateAsyncOperation('Third'),
    ]);
    console.log('All operations successful:', results);
  } catch (error) {
    console.error('Error in operations:', error);
  }
}

handleMultiplePromises();
```