```javascript
class AsyncTask {
    constructor(duration) {
        this.duration = duration;
    }

    async execute() {
        return new Promise((resolve) => setTimeout(resolve, this.duration));
    }
}

const delay = (ms) => new Promise(res => setTimeout(res, ms));

(async function main() {
    const tasks = [new AsyncTask(1000), new AsyncTask(2000), new AsyncTask(1500)];
    
     
    console.log("Starting parallel tasks...");
    const parallelStart = Date.now();
    await Promise.all(tasks.map(task => task.execute()));
    console.log(`All parallel tasks completed in ${Date.now() - parallelStart}ms`);

     
    console.log("Starting sequential tasks...");
    const sequentialStart = Date.now();
    for (const task of tasks) {
        await task.execute();
    }
    console.log(`All sequential tasks completed in ${Date.now() - sequentialStart}ms`);

     
    function* fibonacci() {
        let [prev, curr] = [0, 1];
        while (true) {
            [prev, curr] = [curr, prev + curr];
            yield curr;
        }
    }

    const fib = fibonacci();
    console.log("First 5 Fibonacci numbers:");
    for (let i = 0; i < 5; i++) {
        console.log(fib.next().value);
    }

     
    const handler = {
        get: function(target, prop) {
            return prop in target ? target[prop] : `Property ${prop} not found`;
        },
        set: function(target, prop, value) {
            if (typeof value === 'number') {
                target[prop] = value;
            } else {
                console.log(`Invalid value for ${prop}: ${value}`);
            }
            return true;
        }
    };

    const data = new Proxy({}, handler);
    data.count = 1;
    console.log(data.count);  
    data.count = 'two';  
    console.log(data.count);  
    console.log(data.missingProperty);  

     
    console.log("Delaying for 3 seconds...");
    await delay(3000);
    console.log("Delay complete.");

})();
```