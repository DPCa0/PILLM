```javascript
class EventEmitter {
  constructor() {
    this.events = new Map();
  }

  on(event, listener) {
    if (!this.events.has(event)) {
      this.events.set(event, []);
    }
    this.events.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.events.has(event)) {
      this.events.get(event).forEach(listener => listener(...args));
    }
  }
}

const asyncFunction = async (value) => {
  return new Promise((resolve) => {
    setTimeout(() => resolve(`Processed: ${value}`), 1000);
  });
};

const handler = async function*(values) {
  for (const value of values) {
    yield await asyncFunction(value);
  }
};

const eventEmitter = new EventEmitter();
eventEmitter.on('data', async (data) => {
  console.log(`Received: ${data}`);
  const iterator = handler(data);

  for await (const processedData of iterator) {
    console.log(processedData);
  }
});

eventEmitter.emit('data', ['apple', 'banana', 'cherry']);
```