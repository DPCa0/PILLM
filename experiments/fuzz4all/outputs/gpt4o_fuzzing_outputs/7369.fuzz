```javascript
 

 
const AppModule = (() => {
   
  const fetchData = async (url) => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        url ? resolve({ data: 'Fetched data from ' + url }) : reject('No URL provided');
      }, 1000);
    });
  };

   
  class DataHandler {
    constructor(urls) {
      this.urls = urls;
    }

     
    async fetchDataSequentially() {
      const results = [];
      for (const url of this.urls) {
        try {
          const { data } = await fetchData(url);
          results.push(data);
        } catch (error) {
          console.error('Error fetching data:', error);
        }
      }
      return results;
    }

     
    fetchDataConcurrently() {
      const fetchPromises = this.urls.map(url => fetchData(url).catch(error => error));
      return Promise.all(fetchPromises);
    }
  }

   
  const showResults = ({ sequentialResults, concurrentResults }) => {
    console.log('Sequential Results:', sequentialResults);
    console.log('Concurrent Results:', concurrentResults);
  };

  return {
    run: async () => {
      const handler = new DataHandler(['https://api.example.com/1', 'https://api.example.com/2', null]);

      const sequentialResults = await handler.fetchDataSequentially();
      const concurrentResults = await handler.fetchDataConcurrently();

      showResults({ sequentialResults, concurrentResults });
    },
  };
})();

 
AppModule.run();
```