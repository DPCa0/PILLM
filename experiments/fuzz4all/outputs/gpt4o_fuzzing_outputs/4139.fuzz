```javascript
class Person {
  #name;
  #age;

  constructor(name, age) {
    this.#name = name;
    this.#age = age;
  }

  getName() {
    return this.#name;
  }

  getAge() {
    return this.#age;
  }

  static async fetchPeople() {
    return new Promise((resolve) => {
      setTimeout(() => {
        resolve([
          new Person("Alice", 30),
          new Person("Bob", 25),
        ]);
      }, 1000);
    });
  }
}

(async () => {
  try {
    const people = await Person.fetchPeople();
    const names = people.map((p) => p.getName());
    const averageAge = people.reduce((acc, p) => acc + p.getAge(), 0) / people.length;

    console.log(`People: ${names.join(', ')}`);
    console.log(`Average Age: ${averageAge}`);

    const ageTable = new Map(people.map(p => [p.getName(), p.getAge()]));
    console.log('Age Table:', ageTable);

    const {name, age} = people.find(p => p.getName() === 'Alice');
    console.log(`Found: ${name}, Age: ${age}`);

  } catch (error) {
    console.error('Error:', error);
  }
})();
```