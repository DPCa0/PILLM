print('Hello, world!');
```javascript
 

 
function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

 
async function asyncOperation() {
    console.log('Starting async operation...');
    await delay(1000);
    console.log('Async operation complete!');
}

 
function* numberGenerator() {
    let number = 1;
    while (true) {
        yield number++;
    }
}

 
const handler = {
    get: function(target, prop, receiver) {
        console.log(`Property ${prop} has been accessed`);
        return Reflect.get(...arguments);
    },
    set: function(target, prop, value) {
        console.log(`Property ${prop} is being set to ${value}`);
        return Reflect.set(...arguments);
    }
};

 
const exampleObject = {
    data: 'Some data',
    status: 'Active'
};

 
const proxy = new Proxy(exampleObject, handler);

 
(async function main() {
     
    await asyncOperation();
    
     
    const generator = numberGenerator();
    console.log(`Generated number: ${generator.next().value}`);
    console.log(`Generated number: ${generator.next().value}`);
    
     
    console.log(`Proxy object data: ${proxy.data}`);
    proxy.status = 'Inactive';
    console.log(`Proxy object status: ${proxy.status}`);
})();
```