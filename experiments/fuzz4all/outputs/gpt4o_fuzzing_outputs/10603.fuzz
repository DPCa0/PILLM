const fs = require('fs').promises;
const path = require('path');
const { performance, PerformanceObserver } = require('perf_hooks');

 
const obs = new PerformanceObserver((items) => {
  console.log(items.getEntries()[0].name + ' took ' + items.getEntries()[0].duration + 'ms');
  performance.clearMarks();
});
obs.observe({ entryTypes: ['measure'] });

 
async function processData() {
  try {
    performance.mark('start');

     
    const data = await fs.readFile(path.join(__dirname, 'data.txt'), 'utf-8');

     
    const transformedData = data.split('\n')
      .map(line => line.split('').reverse().join(''))
      .sort()
      .join('\n');

     
    await fs.writeFile(path.join(__dirname, 'output.txt'), transformedData);

    performance.mark('end');
    performance.measure('Processing data', 'start', 'end');

    console.log('Data processed and saved to output.txt');
  } catch (error) {
    console.error('Error processing data:', error);
  }
}

 
(async () => {
  if (Math.random() < 0.5) {
    const { default: lodash } = await import('lodash');
    console.log('Random number from lodash:', lodash.random(1, 100));
  } else {
    console.log('No lodash used this time.');
  }

   
  const config = { logging: { level: 'info' } };
  console.log('Logging level:', config.logging?.level ?? 'default');

   
  await processData();
})();
