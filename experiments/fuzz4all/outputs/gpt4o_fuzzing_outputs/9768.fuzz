```javascript
class AsyncPriorityQueue {
    constructor() {
        this.queue = [];
        this.pendingPromises = [];
    }

    async enqueue(item, priority = 0) {
        return new Promise((resolve) => {
            const newItem = { item, priority, resolve };
            this.queue.push(newItem);
            this.queue.sort((a, b) => b.priority - a.priority);
            this.dequeueIfPossible();
        });
    }

    async dequeueIfPossible() {
        if (this.pendingPromises.length > 0 && this.queue.length > 0) {
            const highestPriorityItem = this.queue.shift();
            this.pendingPromises.shift()(highestPriorityItem.item);
            highestPriorityItem.resolve();
        }
    }

    async dequeue() {
        if (this.queue.length > 0) {
            const highestPriorityItem = this.queue.shift();
            this.dequeueIfPossible();
            return highestPriorityItem.item;
        }

        return new Promise((resolve) => {
            this.pendingPromises.push(resolve);
        });
    }
}

async function main() {
    const queue = new AsyncPriorityQueue();

     
    const tasks = Array.from({ length: 10 }, (_, i) => queue.enqueue(`Task ${i}`, Math.random() * 10));

     
    for (let i = 0; i < 10; i++) {
        const task = await queue.dequeue();
        console.log(`Processed: ${task}`);
    }
}

main().catch(console.error);
