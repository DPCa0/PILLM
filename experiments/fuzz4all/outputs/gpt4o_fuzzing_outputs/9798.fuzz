print('Hello, world!');
```javascript
class AdvancedFeatureExample {
  #privateVariable = 'I am private';
  
  constructor(name) {
    this.name = name;
  }

  static async fetchData(url) {
    const response = await fetch(url);
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status}`);
    }
    return response.json();
  }

  #privateMethod() {
    console.log('Accessing private method:', this.#privateVariable);
  }

  publicMethod() {
    console.log(`Hello, my name is ${this.name}`);
    this.#privateMethod();
  }

  *generatorFunction(limit) {
    let count = 0;
    while (count < limit) {
      yield count++;
    }
  }

  async logFetchedData(url) {
    try {
      const data = await AdvancedFeatureExample.fetchData(url);
      console.log('Fetched Data:', data);
    } catch (error) {
      console.error('Error fetching data:', error);
    }
  }
}

(async () => {
  const example = new AdvancedFeatureExample('John Doe');
  example.publicMethod();

  console.log('\nUsing Generator Function:');
  const generator = example.generatorFunction(5);
  for (const value of generator) {
    console.log(value);
  }

  console.log('\nFetching data using async/await:');
  await example.logFetchedData('https://jsonplaceholder.typicode.com/todos/1');
})();
```