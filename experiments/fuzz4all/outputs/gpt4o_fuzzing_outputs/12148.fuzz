print('Hello, world!');
```javascript
const fetchData = async (url) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    return data;
};

const processData = ({ results }) => {
    return results.map(({ name: { first, last }, email }) => ({
        fullName: `${first} ${last}`,
        email
    }));
};

(async () => {
    try {
        const url = 'https://randomuser.me/api/?results=5';
        const data = await fetchData(url);
        const users = processData(data);
        const emailSet = new Set(users.map(user => user.email));
        
        const promises = users.map(user => 
            Promise.resolve(`Name: ${user.fullName}, Email: ${user.email}`));

        const messages = await Promise.all(promises);

        emailSet.forEach(email => console.log(`Unique Email: ${email}`));
        messages.forEach(message => console.log(`Processed User: ${message}`));
        
    } catch (error) {
        console.error('An error occurred:', error);
    }
})();
```