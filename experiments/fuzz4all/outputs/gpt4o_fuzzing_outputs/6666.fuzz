```javascript
 

 
 
export const fetchData = () => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      const data = { user: { name: "Alice", age: 25 }, status: "active" };
      resolve(data);
    }, 1000);
  });
};

 

import { fetchData } from './dataFetcher.js';

 
async function processUserData() {
  try {
    const { user, status } = await fetchData();  
    if (status === "active") {
      console.log(`User ${user.name} is active and ${user.age} years old.`);
    } else {
      console.log(`User ${user.name} is not active.`);
    }
  } catch (error) {
    console.error('An error occurred:', error);
  }
}

 
processUserData();
```
Make sure to run this code in an environment that supports ES modules (like modern browsers or Node.js with the `--experimental-modules` flag). The program imports a module to fetch data asynchronously, uses async/await for control flow, and destructures an object to access properties concisely.