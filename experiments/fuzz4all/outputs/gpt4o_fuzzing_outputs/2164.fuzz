```javascript
class AsyncQueue {
  constructor() {
    this.queue = [];
    this.isProcessing = false;
  }

  async enqueue(promiseFunction) {
    this.queue.push(promiseFunction);
    if (!this.isProcessing) {
      this.processQueue();
    }
  }

  async processQueue() {
    this.isProcessing = true;
    while (this.queue.length) {
      const task = this.queue.shift();
      await task();
    }
    this.isProcessing = false;
  }
}

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

const logWithDelay = async (message, delayTime) => {
  await delay(delayTime);
  console.log(message);
};

const asyncQueue = new AsyncQueue();

(async () => {
  const tasks = [
    () => logWithDelay('Task 1 Complete', 1000),
    () => logWithDelay('Task 2 Complete', 500),
    () => logWithDelay('Task 3 Complete', 1500),
  ];

  tasks.forEach(task => asyncQueue.enqueue(task));
})();

 
const handler = {
  get(target, prop) {
    if (typeof target[prop] === 'function') {
      return function (...args) {
        console.log(`Calling ${prop} with args: ${JSON.stringify(args)}`);
        return target[prop](...args);
      };
    }
    return target[prop];
  }
};

const monitoredQueue = new Proxy(asyncQueue, handler);

monitoredQueue.enqueue(() => logWithDelay('Monitored Task Complete', 700));
```