  if (!response.ok) throw new Error("Network response was not ok");
  const user = await response.json();
  console.log(`GitHub User: ${user.name}`);
}

 
fetchData();
processArray([1, 2, 3, 4, 5, 6]);
fetchGithubUser('octocat').catch(console.error);
