```javascript
class Matrix {
    constructor(rows, cols, fill = 0) {
        this.rows = rows;
        this.cols = cols;
        this.data = Array.from({ length: rows }, () => Array.from({ length: cols }, () => fill));
    }

    static fromArray(arr) {
        return new Matrix(arr.length, arr[0].length, 0).map((_, i, j) => arr[i][j]);
    }

    map(func) {
        this.data = this.data.map((row, i) => row.map((val, j) => func(val, i, j)));
        return this;
    }

    static multiply(a, b) {
        if (a.cols !== b.rows) throw new Error("Columns of A must match rows of B.");
        return new Matrix(a.rows, b.cols).map((_, i, j) =>
            a.data[i].reduce((sum, elm, k) => sum + elm * b.data[k][j], 0)
        );
    }

    [Symbol.iterator]() {
        let rowIndex = 0;
        let colIndex = 0;
        return {
            next: () => {
                if (rowIndex < this.rows) {
                    const value = this.data[rowIndex][colIndex];
                    colIndex++;
                    if (colIndex === this.cols) {
                        colIndex = 0;
                        rowIndex++;
                    }
                    return { value, done: false };
                } else {
                    return { done: true };
                }
            }
        };
    }

    toString() {
        return this.data.map(row => row.join(' ')).join('\n');
    }
}

 
const a = Matrix.fromArray([[1, 2, 3], [4, 5, 6]]);
const b = Matrix.fromArray([[7, 8], [9, 10], [11, 12]]);
const result = Matrix.multiply(a, b);

console.log(result.toString());

for (const value of result) {
    console.log(`Value: ${value}`);
}
```