print('Hello, world!');
```javascript
 

const fetchData = async () => {
    const simulateAsyncFetch = () => new Promise(resolve => 
        setTimeout(() => resolve({ data: { id: 1, name: 'John Doe', age: 30 } }), 1000)
    );

    try {
        const { data: { id, name, age } } = await simulateAsyncFetch();
        
        const displayData = () => {
            const dataTemplate = `
                User Details:
                ID: ${id}
                Name: ${name}
                Age: ${age}
            `;
            console.log(dataTemplate);
        };
        
        displayData();
    } catch (error) {
        console.error('Error fetching data:', error);
    }
};

fetchData();
```