print('Hello, world!');
```javascript
 

 
const fetchData = async () => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      resolve({ user: 'Alice', age: 30, location: { city: 'Wonderland', country: 'Imagination' } });
    }, 1000);
  });
};

 
class User {
  constructor({ user, age, location: { city, country } }) {
    this.name = user;
    this.age = age;
    this.city = city;
    this.country = country;
  }

  greet() {
    return `Hello, my name is ${this.name} from ${this.city}, ${this.country}.`;
  }
}

 
const displayGreeting = async () => {
  try {
    const userData = await fetchData();
    const user = new User(userData);
    console.log(user.greet());
  } catch (error) {
    console.error('An error occurred:', error);
  }
};

 
displayGreeting();
```