```javascript
 

async function fetchData(url) {
  const response = await fetch(url);
  if (!response.ok) {
    throw new Error(`HTTP error! Status: ${response.status}`);
  }
  return response.json();
}

function processData(data) {
  const [{ id, name }, ...rest] = data;
  return { firstEntry: { id, name }, restEntriesCount: rest.length };
}

function delay(ms) {
  return new Promise(resolve => setTimeout(resolve, ms));
}

async function main() {
  try {
    const url = 'https://jsonplaceholder.typicode.com/users';
    console.log(`Fetching data from: ${url}`);
    
    const data = await fetchData(url);
    console.log(`Fetched ${data.length} entries`);
    
    const { firstEntry, restEntriesCount } = processData(data);
    console.log(`First Entry: ${JSON.stringify(firstEntry, null, 2)}`);
    console.log(`Number of remaining entries: ${restEntriesCount}`);
    
    console.log(`Waiting for 3 seconds...`);
    await delay(3000);
    
    console.log('Done!');
  } catch (error) {
    console.error(`Error: ${error.message}`);
  }
}

main();
```