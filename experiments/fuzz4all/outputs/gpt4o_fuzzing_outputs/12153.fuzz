```javascript
 

 
const fetchData = () => new Promise((resolve) => {
  setTimeout(() => {
    resolve({
      user: 'John Doe',
      email: 'john.doe@example.com',
      favorites: ['JavaScript', 'Node.js', 'React']
    });
  }, 1000);
});

 
async function getUserData() {
  try {
     
    const { user, email, favorites } = await fetchData();

     
    const [firstFav, ...otherFavs] = favorites;
    const newFavorites = ['TypeScript', ...otherFavs];

     
    console.log(`User: ${user}`);
    console.log(`Email: ${email}`);
    console.log(`First favorite: ${firstFav}`);
    console.log(`Updated favorites: ${newFavorites.join(', ')}`);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
}

 
(async () => {
  await getUserData();
})();
```