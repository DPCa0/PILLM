```javascript
class AsyncQueue {
    constructor() {
        this.queue = [];
        this.pendingPromise = false;
    }

    enqueue(asyncFunc) {
        return new Promise((resolve, reject) => {
            this.queue.push(() => asyncFunc().then(resolve).catch(reject));
            this.run();
        });
    }

    async run() {
        if (this.pendingPromise || !this.queue.length) return;
        this.pendingPromise = true;
        try {
            await this.queue.shift()();
        } catch (err) {
            console.error('Error in AsyncQueue:', err);
        }
        this.pendingPromise = false;
        this.run();
    }
}

const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

(async function main() {
    const asyncQueue = new AsyncQueue();
    
    const logAfterDelay = async (msg, delayTime) => {
        await delay(delayTime);
        console.log(msg);
    };

     
    ['Task 1', 'Task 2', 'Task 3'].forEach((task, index) => {
        asyncQueue.enqueue(async () => {
            await logAfterDelay(`Processing ${task}...`, (index + 1) * 1000);
        });
    });

     
    const [result1, result2] = await Promise.all([
        (async () => await asyncQueue.enqueue(() => logAfterDelay('Executing independent task A', 500)))(),
        (async () => await asyncQueue.enqueue(() => logAfterDelay('Executing independent task B', 800)))()
    ]);

    console.log('All tasks completed');
})();
```