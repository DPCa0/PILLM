class EventEmitter {
  constructor() {
    this.listeners = new Map();
  }

  on(event, listener) {
    if (!this.listeners.has(event)) {
      this.listeners.set(event, []);
    }
    this.listeners.get(event).push(listener);
  }

  emit(event, ...args) {
    if (this.listeners.has(event)) {
      this.listeners.get(event).forEach(listener => listener(...args));
    }
  }
}

const fetchData = (url) => new Promise((resolve, reject) => {
  setTimeout(() => {
    Math.random() > 0.5 ? resolve(`Data from ${url}`) : reject('Fetch error');
  }, 1000);
});

const withRetry = async (fn, retries = 3) => {
  let attempts = 0;
  while (attempts < retries) {
    try {
      return await fn();
    } catch (error) {
      if (attempts === retries - 1) throw error;
      attempts++;
    }
  }
};

const cachedFetch = (() => {
  const cache = new Map();
  return async (url) => {
    if (cache.has(url)) {
      return cache.get(url);
    }
    const data = await withRetry(() => fetchData(url));
    cache.set(url, data);
    return data;
  };
})();

const main = async () => {
  const eventEmitter = new EventEmitter();
  eventEmitter.on('data', (data) => console.log(`Received: ${data}`));
  eventEmitter.on('error', (error) => console.error(`Error: ${error}`));

  try {
    const data1 = await cachedFetch('https://api.example.com/resource1');
    eventEmitter.emit('data', data1);

    const data2 = await cachedFetch('https://api.example.com/resource2');
    eventEmitter.emit('data', data2);
  } catch (error) {
    eventEmitter.emit('error', error);
  }
};

main();
```