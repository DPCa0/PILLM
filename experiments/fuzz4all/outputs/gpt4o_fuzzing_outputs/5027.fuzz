class EventEmitter {
    constructor() {
        this.events = new Map();
    }
    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }
    emit(event, ...args) {
        if (this.events.has(event)) {
            this.events.get(event).forEach(listener => listener(...args));
        }
    }
    once(event, listener) {
        const wrapper = (...args) => {
            listener(...args);
            this.off(event, wrapper);
        };
        this.on(event, wrapper);
    }
    off(event, listenerToRemove) {
        if (this.events.has(event)) {
            const updatedListeners = this.events
                .get(event)
                .filter(listener => listener !== listenerToRemove);
            this.events.set(event, updatedListeners);
        }
    }
}

class PromiseQueue {
    constructor(concurrency = 2) {
        this.concurrency = concurrency;
        this.running = 0;
        this.queue = [];
    }

    enqueue(promiseFn) {
        return new Promise((resolve, reject) => {
            this.queue.push(() => promiseFn().then(resolve).catch(reject));
            this.dequeue();
        });
    }

    dequeue() {
        if (this.running >= this.concurrency || !this.queue.length) return;
        this.running++;
        this.queue.shift()().finally(() => {
            this.running--;
            this.dequeue();
        });
    }
}

async function advancedFeatureShowcase() {
    const emitter = new EventEmitter();

    emitter.on('data', data => console.log(`Data received: ${data}`));
    emitter.once('end', () => console.log('No more data.'));
    
    const queue = new PromiseQueue(3);

    const asyncTask = (msg, delay) => () =>
        new Promise(resolve => {
            setTimeout(() => {
                emitter.emit('data', msg);
                resolve(msg);
            }, delay);
        });

    for (let i = 1; i <= 5; i++) {
        queue.enqueue(asyncTask(`Task ${i}`, i * 1000));
    }

    await queue.enqueue(asyncTask('Final Task', 3000));
    emitter.emit('end');
}

advancedFeatureShowcase();
