```javascript
 
async function fetchData() {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    
     
    if (!response.ok) {
      throw new Error(`HTTP error! status: ${response.status}`);
    }

     
    const data = await response.json();
    
     
    const processedData = data.slice(0, 5).map(({ id, title, body }) => ({
      id,
      summary: `${title.toUpperCase()}: ${body.substring(0, 50)}...`
    }));

     
    const uniqueSummaries = [...new Set(processedData.map(post => post.summary))];

     
    uniqueSummaries.forEach(summary => console.log(summary));

  } catch (error) {
     
    console.error('Fetch error:', error);
  }
}

 
(() => fetchData())();
```