class AsyncEventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }

    async emit(event, ...args) {
        if (!this.events.has(event)) return;
        const listeners = this.events.get(event);
        for (const listener of listeners) {
            await listener(...args);
        }
    }

    off(event, listener) {
        if (!this.events.has(event)) return;
        this.events.set(event, this.events.get(event).filter(l => l !== listener));
    }
}

const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

const main = async () => {
    const emitter = new AsyncEventEmitter();

    emitter.on('greet', async (name) => {
        await delay(1000);
        console.log(`Hello, ${name}!`);
    });

    emitter.on('greet', async (name) => {
        await delay(500);
        console.log(`How are you, ${name}?`);
    });

    await emitter.emit('greet', 'Alice');

    const farewell = async (name) => {
        await delay(200);
        console.log(`Goodbye, ${name}.`);
    };

    emitter.on('farewell', farewell);
    await emitter.emit('farewell', 'Bob');
    emitter.off('farewell', farewell);
    await emitter.emit('farewell', 'Charlie');
};

main();
```