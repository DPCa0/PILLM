print('Hello, world!');
```javascript
const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return response.json();
};

const processUserData = ({ name, location: { city, country } }) => {
  console.log(`User ${name} is located in ${city}, ${country}.`);
};

const main = async () => {
  try {
    const url = 'https://jsonplaceholder.typicode.com/users';
    const data = await fetchData(url);

    data.forEach((user) => {
      const { id, name } = user;
      const location = { city: user.address.city, country: 'USA' };
      
       
      const userProxy = new Proxy(user, {
        get(target, prop) {
          if (prop === 'location') return location;
          return target[prop];
        },
      });

      if (id % 2 === 0) {
        processUserData(userProxy);
      }
    });
  } catch (error) {
    console.error('Error fetching data:', error);
  }
};

 
(async () => {
  await main();
})();
```