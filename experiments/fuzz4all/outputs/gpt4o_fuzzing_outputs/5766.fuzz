const fetch = require('node-fetch');

(async () => {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    const posts = await response.json();

     
    const postSummaries = posts.map(post => {
      const { id, title, body } = post;
      return `Post ID: ${id}, Title: ${title.toUpperCase()}, Body: ${body.slice(0, 20)}...`;
    });

     
    const uniqueTitles = [...new Set(posts.map(post => post.title))];

     
    function getPostSummary({ title = 'No Title', body = 'No Content' } = {}) {
      return `Title: ${title}, Body: ${body.slice(0, 20)}...`;
    }

     
