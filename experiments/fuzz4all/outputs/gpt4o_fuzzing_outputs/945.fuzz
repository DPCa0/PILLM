```javascript
class AsyncQueue {
  constructor() {
    this.queue = [];
    this.processing = false;
  }

  enqueue(promiseFn) {
    return new Promise((resolve, reject) => {
      this.queue.push({ promiseFn, resolve, reject });
      this.processQueue();
    });
  }

  async processQueue() {
    if (this.processing || this.queue.length === 0) return;

    this.processing = true;
    const { promiseFn, resolve, reject } = this.queue.shift();

    try {
      const result = await promiseFn();
      resolve(result);
    } catch (error) {
      reject(error);
    } finally {
      this.processing = false;
      this.processQueue();
    }
  }
}

const queue = new AsyncQueue();

function createTask(duration) {
  return () => new Promise((resolve) => {
    setTimeout(() => {
      const endTime = new Date().toISOString();
      resolve(`Task completed at ${endTime} after ${duration}ms`);
    }, duration);
  });
}

const tasks = [3000, 2000, 1000].map(createTask);
const results = [];

(async () => {
  for (const task of tasks) {
    results.push(queue.enqueue(task));
  }

  for await (const result of results) {
    console.log(result);
  }
})();
```