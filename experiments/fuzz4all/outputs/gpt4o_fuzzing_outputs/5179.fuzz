```javascript
 

 
function fetchData(id) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (id < 0) {
                reject("Invalid ID");
            } else {
                resolve({ id: id, value: Math.floor(Math.random() * 100) });
            }
        }, 1000);
    });
}

 
async function processData(ids) {
    try {
         
        let data = await Promise.all(ids.map(fetchData));

         
        let sum = data.reduce((acc, item) => acc + item.value, 0);

         
        return `Total Sum: ${sum}`;
    } catch (error) {
         
        return `Error: ${error}`;
    }
}

 
(async function main() {
    const ids = [1, 2, 3, 4, 5];
    const result = await processData(ids);
    console.log(result);
})();
```