print('Hello, world!');
```javascript
 

 
const fetchData = async (url) => {
  return new Promise((resolve) => {
    setTimeout(() => resolve(`Data from ${url}`), 1000);
  });
};

 
const handler = {
  get(target, property, receiver) {
    console.log(`Getting property '${property}'`);
    return Reflect.get(target, property, receiver);
  },
  set(target, property, value, receiver) {
    console.log(`Setting property '${property}' to '${value}'`);
    return Reflect.set(target, property, value, receiver);
  }
};

 
let dataProxy = new Proxy({ cache: {} }, handler);

async function fetchAndCache(url) {
  if (!dataProxy.cache[url]) {
    console.log(`Fetching data from: ${url}`);
    dataProxy.cache[url] = await fetchData(url);
  } else {
    console.log(`Retrieving cached data for: ${url}`);
  }
  return dataProxy.cache[url];
}

 
(async () => {
  const urls = ["https://api.example.com/data1", "https://api.example.com/data2"];
  
  for (const url of urls) {
    console.log(await fetchAndCache(url));
    console.log(await fetchAndCache(url));  
  }
})();
```