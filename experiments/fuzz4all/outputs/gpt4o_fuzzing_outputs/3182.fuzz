```javascript
 

class DataFetcher {
  constructor(apiUrl) {
    this.apiUrl = apiUrl;
  }

  async fetchData(endpoint) {
    try {
      const response = await fetch(`${this.apiUrl}${endpoint}`);
      if (!response.ok) throw new Error('Network response was not ok');
      const data = await response.json();
      return data;
    } catch (error) {
      console.error('Fetch error:', error);
    }
  }
}

const processData = async ({ userId, title }) => {
  return new Promise((resolve) => {
    setTimeout(() => {
      resolve(`Processed data for userId: ${userId} with title: ${title}`);
    }, 2000);
  });
};

(async () => {
  const api = new DataFetcher('https://jsonplaceholder.typicode.com');
  const data = await api.fetchData('/posts/1');
  const { id: postId, userId, title, ...otherData } = data;

  console.log('Fetched data:', { postId, userId, title, ...otherData });

  const result = await processData({ userId, title });
  console.log(result);
})();
```