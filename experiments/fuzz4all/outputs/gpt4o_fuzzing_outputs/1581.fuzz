```javascript
 

 
function fetchData(url) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
             
            const data = { url, data: "Sample Data" };
            resolve(data);
        }, 1000);
    });
}

 
async function getData(url) {
    try {
        const result = await fetchData(url);
        console.log(`Data fetched from ${url}:`, result.data);
    } catch (error) {
        console.error("Error fetching data:", error);
    }
}

 
const handler = {
    get: (target, prop) => {
        console.log(`Property '${prop}' accessed`);
        return Reflect.get(target, prop);
    },
    set: (target, prop, value) => {
        console.log(`Property '${prop}' set to '${value}'`);
        return Reflect.set(target, prop, value);
    }
};

 
const targetObject = {
    name: "ProxyTarget",
    version: 1.0
};

 
const proxy = new Proxy(targetObject, handler);

 
console.log("Initial Name:", proxy.name);
proxy.version = 2.0;
console.log("Updated Version:", proxy.version);

 
console.log("Starting async operations...");
getData("http://example.com/api/data").then(() => {
    proxy.name = "UpdatedProxyTarget";
    console.log("Final Name:", proxy.name);
});
```