```javascript
const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

async function* asyncGenerator(array) {
  for (const item of array) {
    await delay(500);
    yield item;
  }
}

const manipulateData = async () => {
  const numbers = [1, 2, 3, 4, 5];
  
  const modifiedNumbers = numbers.map(num => num * 2).filter(num => num > 5);
  
  const numberIterator = asyncGenerator(modifiedNumbers);
  
  for await (const value of numberIterator) {
    const processedValue = await Promise.resolve(value).then(val => val + 1);
    console.log(`Processed Value: ${processedValue}`);
  }
  
  const squaredNumbers = modifiedNumbers.reduce((acc, num) => ({
    ...acc,
    [num]: num ** 2
  }), {});
  
  console.table(squaredNumbers);
};

(async () => {
  try {
    await manipulateData();
  } catch (error) {
    console.error('An error occurred:', error);
  }
})();
```