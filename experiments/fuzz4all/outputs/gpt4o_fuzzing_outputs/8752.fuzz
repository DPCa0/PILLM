class Observable {
    constructor() {
        this.subscribers = new Set();
    }
    
    subscribe(fn) {
        this.subscribers.add(fn);
        return () => this.subscribers.delete(fn);
    }
    
    notify(data) {
        this.subscribers.forEach(fn => fn(data));
    }
}

class Store {
    #state;
    #observable = new Observable();
    
    constructor(reducer, initialState) {
        this.reducer = reducer;
        this.#state = initialState;
    }
    
    getState() {
        return this.#state;
    }
    
    dispatch(action) {
        const newState = this.reducer(this.#state, action);
        if (newState !== this.#state) {
            this.#state = newState;
            this.#observable.notify(this.#state);
        }
    }
    
    subscribe(fn) {
        return this.#observable.subscribe(fn);
    }
}

const reducer = (state, action) => {
    switch (action.type) {
        case 'INCREMENT':
            return { count: state.count + 1 };
        case 'DECREMENT':
            return { count: state.count - 1 };
        default:
            return state;
    }
};

const store = new Store(reducer, { count: 0 });

const unsubscribe = store.subscribe(state => console.log('State changed:', state));

store.dispatch({ type: 'INCREMENT' });
store.dispatch({ type: 'INCREMENT' });
unsubscribe();
store.dispatch({ type: 'DECREMENT' });

 
async function fetchAndLog(url) {
    try {
        const response = await fetch(url);
        if (!response.ok) throw new Error('Network response was not ok');
        const data = await response.json();
        console.log('Fetched data:', data);
    } catch (error) {
        console.error('Fetch error:', error);
    }
}

 
const person = { name: 'Alice', age: 30 };
const personProxy = new Proxy(person, {
    get(target, property) {
        console.log(`Accessing property '${property}' with value: ${target[property]}`);
        return target[property];
    },
    set(target, property, value) {
        console.log(`Setting property '${property}' to value: ${value}`);
        target[property] = value;
        return true;
    }
});

personProxy.name;  
personProxy.age = 31;  

 