```javascript
 

 
const fetchData = (url) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === "https://api.example.com/data") {
        resolve({
          status: 200,
          data: { user: { name: "John Doe", age: 30 }, settings: { theme: "dark", notifications: true } }
        });
      } else {
        reject(new Error("404 Not Found"));
      }
    }, 2000);
  });
};

 
const processData = async (url) => {
  try {
    const { status, data: { user: { name, age }, settings: { theme, notifications } } } = await fetchData(url);

    if (status === 200) {
      console.log(`Name: ${name}, Age: ${age}`);
      console.log(`Theme: ${theme}, Notifications Enabled: ${notifications}`);

       
      const userMap = new Map();
      userMap.set('Name', name);
      userMap.set('Age', age);
      userMap.set('Theme', theme);
      userMap.set('Notifications', notifications);

       
      console.log('User Map:', [...userMap]);
    }
  } catch (error) {
    console.error("Error fetching data:", error.message);
  }
};

 
processData("https://api.example.com/data");

 
processData("https://api.wrong-url.com/data");
```