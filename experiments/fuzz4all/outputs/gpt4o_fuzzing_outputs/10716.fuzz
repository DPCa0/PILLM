```javascript
 
const fs = require('fs').promises;

 
async function readAndLogFile(filePath) {
    try {
         
        const formatLog = (strings, ...values) => strings.raw.reduce((acc, str, i) => `${acc}${str}${values[i] || ''}`, '');
        
         
        const data = await fs.readFile(filePath, 'utf8');
        
         
        const lines = data.split('\n').map((line, index) => `${index + 1}: ${line}`);
        
         
        const uniqueLines = [...new Set(lines)];
        
         
        console.log(formatLog`--- Start of File ---\n${uniqueLines.join('\n')}\n--- End of File ---`);
    } catch (error) {
         
        console.error(`Failed to read file: ${error?.message ?? 'Unknown Error'}`);
    }
}

 
(async () => {
    const filePath = './example.txt';
    await readAndLogFile(filePath);
})();
```