```javascript
 
import fs from 'fs/promises';

 
(async function() {
    try {
         
        const uniqueNumbers = new Set([1, 2, 2, 3, 4]);
        const numberDescriptions = new Map([
            [1, 'One'],
            [2, 'Two'],
            [3, 'Three'],
            [4, 'Four']
        ]);

         
        const filePath = './numbers.json';
        await fs.writeFile(filePath, JSON.stringify(Array.from(uniqueNumbers), null, 2));

         
        const { default: os } = await import('os');

         
        console.log(`File written successfully on ${os.platform()}. Content:`);
        const fileContent = await fs.readFile(filePath, 'utf-8');
        console.log(fileContent);

         
        const descriptionArray = Array.from(uniqueNumbers, num => numberDescriptions.get(num));

         
        console.log('Descriptions:', [...descriptionArray]);
    } catch (error) {
         
        console.error('An error occurred:', error?.message ?? 'Unknown error');
    }
})();
```