const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return await response.json();
};

const processUserData = async (userId) => {
  try {
    const urls = [
      `https: 
      `https: 
      `https: 
    ];

    const [user, posts, albums] = await Promise.all(urls.map(fetchData));

    const getRecentPosts = (posts) =>
      posts
        .slice(0, 3)
        .map(({ id, title }) => ({ id, title }));  

    const userInfo = {
      name: user.name,
      email: user.email,
      recentPosts: getRecentPosts(posts),
      numberOfAlbums: albums.length,
    };

    console.log(userInfo);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
};

processUserData(1);
