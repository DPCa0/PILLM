class Observable {
    constructor() {
        this.listeners = new Set();
    }

    subscribe(listener) {
        this.listeners.add(listener);
        return () => this.listeners.delete(listener);
    }

    notify(data) {
        this.listeners.forEach(listener => listener(data));
    }
}

async function fetchData(url) {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    return response.json();
}

const dataStore = new Proxy({}, {
    set(target, property, value) {
        Reflect.set(target, property, value);
        dataObservable.notify({ property, value });
        return true;
    }
});

const dataObservable = new Observable();

dataObservable.subscribe(({ property, value }) => {
    console.log(`Data changed: ${property} = ${value}`);
});

(async function loadDataAndReact() {
    try {
        const data = await fetchData('https://jsonplaceholder.typicode.com/posts/1');
        Object.assign(dataStore, data);
        console.log(`Title: ${dataStore.title}`);
    } catch (error) {
        console.error('Failed to fetch data:', error);
    }
})();
```