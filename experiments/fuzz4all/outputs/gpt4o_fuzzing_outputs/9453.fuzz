```javascript
 

const secret = Symbol('secret');

class Ninja {
  constructor(name) {
    this.name = name;
    this[secret] = `The secret of ${name}`;
  }

  async getSecret() {
    return new Promise((resolve) => {
      setTimeout(() => resolve(this[secret]), 1000);
    });
  }

  static* quoteGenerator() {
    const quotes = [
      "I fear not the man who has practiced 10,000 kicks once, but I fear the man who has practiced one kick 10,000 times.",
      "Do not pray for an easy life, pray for the strength to endure a difficult one.",
      "The successful warrior is the average man, with laser-like focus."
    ];
    let index = 0;
    while (true) {
      yield quotes[index % quotes.length];
      index++;
    }
  }
}

const handler = {
  get(target, prop, receiver) {
    if (prop === 'name') {
      return `Masked ${Reflect.get(target, prop, receiver)}`;
    }
    return Reflect.get(target, prop, receiver);
  }
};

const ninja = new Proxy(new Ninja('Hattori'), handler);

(async () => {
  console.log(`Ninja name: ${ninja.name}`);  

  const secretMessage = await ninja.getSecret();
  console.log(`Secret message: ${secretMessage}`);

  const quotes = Ninja.quoteGenerator();
  console.log(quotes.next().value);
  console.log(quotes.next().value);
  console.log(quotes.next().value);
  console.log(quotes.next().value);
})();
```