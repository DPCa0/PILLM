```javascript
 

class FetchSimulator {
  constructor(data) {
    this.data = data;
    this.handlers = {
      get: (target, prop) => {
        console.log(`Accessing property '${prop}'`);
        return target[prop];
      },
    };
    this.proxy = new Proxy(this.data, this.handlers);
  }

  async fetchData() {
    console.log("Fetching data...");
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (Math.random() > 0.2) {
          console.log("Data fetched successfully.");
          resolve(this.proxy);
        } else {
          reject(new Error("Failed to fetch data."));
        }
      }, 1000);
    });
  }
}

(async function run() {
  const data = { user: "John Doe", age: 30, location: "Earth" };
  const fetchSimulator = new FetchSimulator(data);

  try {
    const fetchedData = await fetchSimulator.fetchData();
    console.log(`User: ${fetchedData.user}`);
    console.log(`Age: ${fetchedData.age}`);
  } catch (error) {
    console.error(error.message);
  }
})();
```