print('Hello, world!');
```javascript
 

 
const fetchData = async (url) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      const data = { message: `Data from ${url}` };
      resolve(data);
    }, 1000);
  });
};

 
const handler = {
  get(target, property) {
    if (property in target) {
      console.log(`Accessing property "${property}"`);
      return target[property];
    } else {
      throw new Error(`Property "${property}" not found`);
    }
  },
  set(target, property, value) {
    console.log(`Setting property "${property}" to "${value}"`);
    target[property] = value;
    return true;
  }
};

 
const targetObject = { name: "JavaScript", year: 1995 };
const proxyObject = new Proxy(targetObject, handler);

 
(async () => {
  try {
     
    const data = await fetchData("https://api.example.com/resource");
    console.log("Fetched data:", data);

     
    console.log(proxyObject.name);  
    proxyObject.year = 2021;  
    console.log(proxyObject.year);

  } catch (error) {
    console.error("Error:", error);
  }
})();
```