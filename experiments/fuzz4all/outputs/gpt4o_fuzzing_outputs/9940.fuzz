```javascript
class FibonacciSequence {
    constructor(limit) {
        this.limit = limit;
        this.cache = new Map();
    }
  
    *[Symbol.iterator]() {
        let [prev, curr] = [0, 1];
        for (let i = 0; i < this.limit; i++) {
            yield curr;
            [prev, curr] = [curr, prev + curr];
        }
    }
  
    async calculateAsync(n) {
        if (this.cache.has(n)) {
            return this.cache.get(n);
        }
        if (n < 2) return n;
        const result = await Promise.all([this.calculateAsync(n - 1), this.calculateAsync(n - 2)])
                                  .then(([a, b]) => a + b);
        this.cache.set(n, result);
        return result;
    }
}

(async function() {
    const fibSequence = new FibonacciSequence(10);
  
    console.log("Synchronous Fibonacci Sequence:");
    for (let num of fibSequence) {
        console.log(num);
    }
  
    const numToCalculate = 10;
    console.log(`\nCalculating Fibonacci(${numToCalculate}) asynchronously:`);
    const result = await fibSequence.calculateAsync(numToCalculate);
    console.log(`Result: ${result}`);
})();
```