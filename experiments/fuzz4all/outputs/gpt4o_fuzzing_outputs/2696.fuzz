print('Hello, world!');
```javascript
 

 
const handler = {
    get: (target, prop, receiver) => {
        console.log(`GET property ${prop}`);
        return Reflect.get(target, prop, receiver);
    },
    set: (target, prop, value, receiver) => {
        console.log(`SET property ${prop} to ${value}`);
        return Reflect.set(target, prop, value, receiver);
    }
};

 
const data = new Proxy({ name: 'John Doe', age: 30 }, handler);

 
async function fetchData() {
     
    await new Promise(resolve => setTimeout(resolve, 1000));
    return { message: "Data retrieved successfully", data: { userId: 1, name: data.name, age: data.age } };
}

 
(async () => {
    try {
         
        console.log(data.name);
        data.age = 31;

         
        const result = await fetchData();
        console.log(result.message);
        console.log(`User: ${result.data.name}, Age: ${result.data.age}`);
    } catch (error) {
        console.error("An error occurred:", error);
    }
})();
```