```javascript
class FetchService {
  static #instance;

  constructor() {
    if (FetchService.#instance) {
      return FetchService.#instance;
    }
    FetchService.#instance = this;
  }

  async getJSON(url) {
    const response = await fetch(url);
    return response.json();
  }
}

async function* dataGenerator(urls) {
  const service = new FetchService();
  for (const url of urls) {
    yield await service.getJSON(url);
  }
}

(async () => {
  const urls = [
    'https://jsonplaceholder.typicode.com/posts/1',
    'https://jsonplaceholder.typicode.com/posts/2',
  ];

  const processBatch = async (batch) => {
    try {
      const results = await Promise.all(batch);
      console.log('Processed Batch:', results);
    } catch (error) {
      console.error('Error processing batch:', error);
    }
  };

  const generator = dataGenerator(urls);
  const batchSize = 1;
  let batch = [];

  for await (const data of generator) {
    batch.push(data);
    if (batch.length === batchSize) {
      await processBatch(batch);
      batch = [];
    }
  }

  if (batch.length > 0) {
    await processBatch(batch);
  }
})();
```