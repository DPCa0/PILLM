class AsyncEventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }

    async emit(event, ...args) {
        const listeners = this.events.get(event);
        if (!listeners) return;
        await Promise.all(listeners.map(listener => listener(...args)));
    }
}

const fetchWithTimeout = (url, timeout = 5000) => {
    return Promise.race([
        fetch(url).then(response => response.json()),
        new Promise((_, reject) => setTimeout(() => reject(new Error('Timeout')), timeout))
    ]);
};

const emitter = new AsyncEventEmitter();

emitter.on('data', async data => {
    console.log('Data received:', data);
    const result = await processDataAsync(data);
    console.log('Processed result:', result);
});

async function processDataAsync(data) {
     
    return new Promise(resolve => setTimeout(() => resolve(data.map(d => d * 2)), 1000));
}

(async function main() {
    try {
        const data = await fetchWithTimeout('https://jsonplaceholder.typicode.com/posts');
        await emitter.emit('data', data);
    } catch (error) {
        console.error('Error:', error.message);
    }
})();
```