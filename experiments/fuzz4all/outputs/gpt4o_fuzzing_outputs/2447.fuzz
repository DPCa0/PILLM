class EventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }

    emit(event, ...args) {
        if (this.events.has(event)) {
            this.events.get(event).forEach(listener => listener(...args));
        }
    }
}

const asyncProcess = async (value) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (value % 2 === 0) resolve(value);
            else reject('Error: Odd value');
        }, 1000);
    });
};

const pipeline = async function* (iterable) {
    for (let item of iterable) {
        try {
            yield await asyncProcess(item);
        } catch (error) {
            yield error;
        }
    }
};

const main = async () => {
    const emitter = new EventEmitter();
    
    emitter.on('success', (value) => {
        console.log(`Success: Processed ${value}`);
    });

    emitter.on('error', (error) => {
        console.error(error);
    });

    const numbers = [1, 2, 3, 4, 5, 6];
    for await (let result of pipeline(numbers)) {
        if (typeof result === 'string') {
            emitter.emit('error', result);
        } else {
            emitter.emit('success', result);
        }
    }
};

main();
```