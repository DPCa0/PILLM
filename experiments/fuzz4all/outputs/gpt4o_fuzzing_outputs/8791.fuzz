```javascript
class Fibonacci {
  constructor() {
    this.cache = new Map();
  }

  *[Symbol.iterator]() {
    let [prev, curr] = [0, 1];
    while (true) {
      yield curr;
      [prev, curr] = [curr, prev + curr];
    }
  }

  memoize(n) {
    if (this.cache.has(n)) return this.cache.get(n);
    if (n < 2) return n;
    const value = this.memoize(n - 1) + this.memoize(n - 2);
    this.cache.set(n, value);
    return value;
  }
}

async function asyncFibonacci(n) {
  return new Promise(resolve => setTimeout(() => {
    const fib = new Fibonacci();
    resolve(fib.memoize(n));
  }, 100));
}

(async () => {
  const fibonacci = new Fibonacci();
  
  console.log('First 10 Fibonacci numbers using generator:');
  for (const num of fibonacci) {
    console.log(num);
    if (--n === 0) break;
  }
  
  const nth = 20;
  console.log(`Calculating the ${nth} Fibonacci number asynchronously:`);
  const result = await asyncFibonacci(nth);
  console.log(result);
})();
