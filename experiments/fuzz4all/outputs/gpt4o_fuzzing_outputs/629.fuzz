```javascript
class DeferredPromise {
  constructor() {
    this.promise = new Promise((resolve, reject) => {
      this.resolve = resolve;
      this.reject = reject;
    });
  }
}

const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return response.json();
};

const complexFunction = async (url) => {
  const deferred = new DeferredPromise();

  const timeout = setTimeout(() => {
    deferred.reject(new Error('Request timed out'));
  }, 5000);

  try {
    const data = await fetchData(url);
    clearTimeout(timeout);
    deferred.resolve(data);
  } catch (error) {
    clearTimeout(timeout);
    deferred.reject(error);
  }

  return deferred.promise;
};

(async () => {
  const url = 'https://jsonplaceholder.typicode.com/posts/1';

  try {
    const data = await complexFunction(url);
    console.log('Data received:', data);
  } catch (error) {
    console.error('Error:', error);
  }

  const arr = [1, 2, 3, 4, 5];
  const evenSquares = arr.flatMap((num) => (num % 2 === 0 ? [num ** 2] : []));
  console.log('Even squares:', evenSquares);

  const map = new Map([
    ['a', 1],
    ['b', 2],
    ['c', 3],
  ]);

  const doubledValues = [...map.values()].map((value) => value * 2);
  console.log('Doubled Map values:', doubledValues);
})();
```