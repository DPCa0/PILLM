class EventEmitter {
  constructor() {
    this.events = {};
  }

  on(event, listener) {
    if (!this.events[event]) {
      this.events[event] = [];
    }
    this.events[event].push(listener);
  }

  emit(event, ...args) {
    if (this.events[event]) {
      this.events[event].forEach(listener => listener(...args));
    }
  }
}

function* fibonacci() {
  let [prev, curr] = [0, 1];
  while (true) {
    [prev, curr] = [curr, prev + curr];
    yield curr;
  }
}

const asyncFibonacci = async function* (count) {
  const fibGen = fibonacci();
  for (let i = 0; i < count; i++) {
    yield new Promise(resolve => setTimeout(() => resolve(fibGen.next().value), 100));
  }
};

(async () => {
  const emitter = new EventEmitter();
  emitter.on('fibonacci', num => {
    console.log(`Fibonacci number: ${num}`);
  });

  for await (const num of asyncFibonacci(10)) {
    emitter.emit('fibonacci', num);
  }
})();
```