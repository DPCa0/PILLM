```javascript
 
 

const fetch = require('node-fetch');  

 
const API_URL = 'https://jsonplaceholder.typicode.com/posts';

 
async function fetchPosts() {
    const response = await fetch(API_URL);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    return data;
}

 
async function getProcessedPosts() {
    try {
        const posts = await fetchPosts();
        const [firstPost, secondPost, ...otherPosts] = posts;  
        
         
        const processedPosts = await Promise.all(
            otherPosts.map(async (post, index) => {
                const additionalData = await simulateAdditionalDataFetch(post.id);
                return {
                    ...post,  
                    additionalData,  
                    postIndex: index + 2  
                };
            })
        );
        
        return [firstPost, secondPost, ...processedPosts];
    } catch (error) {
        console.error('Error fetching posts:', error);
    }
}

 
async function simulateAdditionalDataFetch(postId) {
    return new Promise(resolve => {
        setTimeout(() => {
            resolve({ info: `Extra data for post ${postId}` });
        }, Math.random() * 1000);
    });
}

 
getProcessedPosts().then(result => console.log(result));
```