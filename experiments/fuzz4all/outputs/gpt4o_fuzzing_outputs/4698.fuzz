```javascript
class AsyncProcessor {
  constructor(data) {
    this.data = data;
  }

  async processData() {
    try {
      const results = await Promise.all(this.data.map(this._asyncOperation));
      const formattedResults = results.flatMap(result => result);
      return this._filterAndSortResults(formattedResults);
    } catch (error) {
      console.error("Error processing data:", error);
    }
  }

  async _asyncOperation(item) {
     
    const delay = Math.floor(Math.random() * 500) + 100;
    return new Promise((resolve) => 
      setTimeout(() => resolve([item * 2, item + 1]), delay)
    );
  }

  _filterAndSortResults(results) {
     
    return Array.from(new Set(results))
      .filter(num => num % 2 === 0)
      .sort((a, b) => a - b);
  }
}

(async function run() {
  const processor = new AsyncProcessor([1, 2, 3, 4, 5]);
  const results = await processor.processData();
  console.log('Processed Results:', results);
})();
```