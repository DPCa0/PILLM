```javascript
class User {
  #name;
  #age;

  constructor(name, age) {
    this.#name = name;
    this.#age = age;
  }

  getProfile() {
    return `${this.#name}, Age: ${this.#age}`;
  }

  static async fetchData() {
    const response = await fetch('https://jsonplaceholder.typicode.com/users');
    return response.json();
  }
}

const processData = async () => {
  try {
    const usersData = await User.fetchData();
    const users = usersData.map(user => new User(user.name, user.age || 'N/A'));

    const youngUsers = users
      .filter(user => user.#age !== 'N/A' && user.#age < 30)
      .map(user => user.getProfile());
    
    console.log('Young Users:', youngUsers);

    const userPromise = Promise.all(users.map(user =>
      new Promise((resolve, reject) => {
        setTimeout(() => resolve(user.getProfile()), Math.random() * 1000);
      })
    ));
    
    userPromise.then(results => {
      console.log('All User Profiles:', results);
    });

  } catch (error) {
    console.error('Error fetching data:', error);
  }
};

(async () => {
  await processData();
})();
```