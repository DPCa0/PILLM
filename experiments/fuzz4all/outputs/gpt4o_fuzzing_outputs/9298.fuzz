```javascript
class Matrix {
    constructor(data) {
        this.data = data;
    }

    static fromArray(arr) {
        return new Matrix(arr);
    }

    get(row, col) {
        return this.data[row][col];
    }

    map(callback) {
        return new Matrix(this.data.map((row, i) =>
            row.map((val, j) => callback(val, i, j))
        ));
    }

    reduce(callback, initialValue) {
        return this.data.reduce((acc, row, i) => 
            row.reduce((accRow, val, j) => 
                callback(accRow, val, i, j), acc), initialValue
        );
    }

    *[Symbol.iterator]() {
        for (const row of this.data) {
            for (const val of row) {
                yield val;
            }
        }
    }

    toString() {
        return this.data.map(row => row.join(', ')).join('\n');
    }
}

 
async function performOperations() {
    const matrix = Matrix.fromArray([
        [1, 2, 3],
        [4, 5, 6],
        [7, 8, 9]
    ]);

    const transform = async (x, i, j) => {
        await new Promise(resolve => setTimeout(resolve, 100));
        return x * 2 + i - j;
    };

    const newMatrix = await Promise.all(
        matrix.map((value, i, j) => transform(value, i, j)).data.map(row => Promise.all(row))
    ).then(data => new Matrix(data));

    console.log(taggedTemplate`Transformed Matrix:\n${newMatrix}`);
}

function taggedTemplate(strings, ...values) {
    return strings.reduce((result, str, i) => result + str + (values[i] || ''), '');
}

performOperations();
```