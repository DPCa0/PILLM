print('Hello, world!');
```javascript
 

 
const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

 
async function* asyncGenerator() {
    for (let i = 1; i <= 5; i++) {
        await sleep(1000);  
        yield i;
    }
}

 
const handler = {
    get: function(target, prop, receiver) {
        if (prop in target) {
            return target[prop];
        } else {
            console.warn(`Property ${prop} does not exist on target`);
            return 'Unknown Property';
        }
    }
};

 
const targetObject = { name: 'Advanced JS', version: '1.0' };
const proxyObject = new Proxy(targetObject, handler);

 
async function demonstrateFeatures() {
    console.log(`Project: ${proxyObject.name}, Version: ${proxyObject.version}`);
    console.log(`Non-existent property: ${proxyObject.nonExistent}`);
    
    console.log('Async generator values:');
    for await (const value of asyncGenerator()) {
        console.log(value);
    }
}

 
demonstrateFeatures();
```