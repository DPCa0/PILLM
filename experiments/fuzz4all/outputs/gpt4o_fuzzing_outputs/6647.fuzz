```javascript
 
function fetchData(url) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (url === "https://api.example.com/data") {
                resolve({ data: [1, 2, 3, 4, 5] });
            } else {
                reject(new Error("Invalid URL"));
            }
        }, 1000);
    });
}

 
const arrayHandler = {
    get(target, property) {
        if (typeof target[property] === 'function') {
            return function (...args) {
                console.log(`Array operation: ${property} with arguments:`, args);
                return target[property].apply(this, args);
            }
        }
        return Reflect.get(target, property);
    }
};

 
async function main() {
    try {
        const response = await fetchData("https://api.example.com/data");
        const proxiedArray = new Proxy(response.data, arrayHandler);

         
        proxiedArray.push(6);
        const mappedArray = proxiedArray.map(x => x * 2);
        console.log("Mapped Array:", mappedArray);

         
        const templateTag = (strings, ...values) => {
            return strings.reduce((result, str, i) => `${result}${str}${values[i] ? `<strong>${values[i]}</strong>` : ''}`, '');
        };
        const message = templateTag`Fetched and processed data: ${mappedArray}`;
        console.log(message);

    } catch (error) {
        console.error("Error fetching data:", error);
    }
}

 
main();
```