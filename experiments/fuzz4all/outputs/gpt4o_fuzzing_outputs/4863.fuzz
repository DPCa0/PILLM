async function* fetchUserData(userIds) {
    for (let id of userIds) {
        try {
             
            const response = await fetch(`https: 
            const data = await response.json();
            yield data;  
        } catch (error) {
            console.error(`Failed to fetch user ${id}:`, error);
        }
    }
}

 
const userIds = new Proxy([1, 2, 3, 4, 5], {
    get(target, prop) {
        console.log(`Accessing element ${prop}`);
        return Reflect.get(target, prop);
    },
    set(target, prop, value) {
        console.log(`Setting element ${prop} to ${value}`);
        return Reflect.set(target, prop, value);
    }
});

 
const getUserEmail = (user) => user?.email ?? 'No email available';

 
(async () => {
    for await (let user of fetchUserData(userIds)) {
        console.log(`Name: ${user.name}, Email: ${getUserEmail(user)}`);
    }
})();

 
import('https://cdnjs.cloudflare.com/ajax/libs/lodash.js/4.17.21/lodash.min.js').then(({ default: _ }) => {
    const names = ['Alice', 'Bob', 'Alice', 'Eve'];
    const uniqueNames = _.uniq(names);
    console.log('Unique names:', uniqueNames);
});
