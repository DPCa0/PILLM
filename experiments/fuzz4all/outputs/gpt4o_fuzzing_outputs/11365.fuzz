```javascript
class Matrix {
  constructor(data) {
    this.data = data;
  }

  static fromFunction(rows, cols, func) {
    return new Matrix(Array.from({ length: rows }, (_, i) => 
      Array.from({ length: cols }, (_, j) => func(i, j))
    ));
  }

  map(func) {
    return new Matrix(this.data.map((row, i) => row.map((value, j) => func(value, i, j))));
  }

  multiply(other) {
    if (this.data[0].length !== other.data.length) {
      throw new Error('Columns of A must match rows of B');
    }
    const result = Matrix.fromFunction(this.data.length, other.data[0].length, (i, j) =>
      this.data[i].reduce((sum, _, k) => sum + this.data[i][k] * other.data[k][j], 0)
    );
    return result;
  }

  toString() {
    return this.data.map(row => row.join(' ')).join('\n');
  }
}

const identity = Matrix.fromFunction(3, 3, (i, j) => (i === j ? 1 : 0));
const rotation = Matrix.fromFunction(3, 3, (i, j) =>
  i === j ? Math.cos(Math.PI / 4) : i < j ? -Math.sin(Math.PI / 4) : Math.sin(Math.PI / 4)
);

const result = identity.multiply(rotation);

console.log(result.toString());
```