```javascript
class Matrix {
    constructor(rows, cols, fill = 0) {
        this.data = Array.from({ length: rows }, () => Array(cols).fill(fill));
    }

    static identity(size) {
        return new Matrix(size, size).map((v, i, j) => (i === j ? 1 : 0));
    }

    map(fn) {
        this.data = this.data.map((row, i) => row.map((val, j) => fn(val, i, j)));
        return this;
    }

    [Symbol.iterator]() {
        let row = 0, col = 0;
        return {
            next: () => {
                if (row < this.data.length && col < this.data[0].length) {
                    const value = this.data[row][col];
                    col++;
                    if (col >= this.data[0].length) {
                        col = 0;
                        row++;
                    }
                    return { value, done: false };
                }
                return { done: true };
            }
        };
    }

    *entries() {
        for (let i = 0; i < this.data.length; i++) {
            for (let j = 0; j < this.data[i].length; j++) {
                yield [i, j, this.data[i][j]];
            }
        }
    }

    async transform(fn) {
        await Promise.all(this.data.map((row, i) => {
            return Promise.all(row.map((val, j) => {
                return new Promise((resolve) => {
                    setTimeout(() => {
                        this.data[i][j] = fn(val, i, j);
                        resolve();
                    }, Math.random() * 100);
                });
            }));
        }));
        return this;
    }

    toString() {
        return this.data.map(row => row.join('\t')).join('\n');
    }
}

 
(async () => {
    const mat = Matrix.identity(3);
    console.log('Original Matrix:\n', mat.toString());

    await mat.transform((val, i, j) => val + i + j);
    console.log('Transformed Matrix:\n', mat.toString());

    console.log('Iterating over matrix entries:');
    for (const [i, j, val] of mat.entries()) {
        console.log(`Matrix[${i}][${j}] = ${val}`);
    }
})();
```