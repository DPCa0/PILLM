print('Hello, world!');
```javascript
 
const fetchData = async () => {
  return new Promise((resolve) =>
    setTimeout(() => resolve(['apple', 'banana', 'orange']), 1000)
  );
};

 
const handler = {
  get: (target, property) => {
    if (property in target) {
      console.log(`Accessing ${property} of array`);
      return target[property];
    }
    return undefined;
  },
};

 
(async () => {
  try {
    const data = await fetchData();
    const proxiedData = new Proxy(data, handler);
    
     
    const firstFruit = proxiedData?.[0] ?? 'No fruits available';
    const thirdFruit = proxiedData?.[2] ?? 'No third fruit';

    console.log('First fruit:', firstFruit);
    console.log('Third fruit:', thirdFruit);

     
    const [first, ...rest] = proxiedData;
    console.log('Destructured first fruit:', first);
    console.log('Rest of the fruits:', rest);

     
    const upperCaseFruits = proxiedData.map(
      (fruit) => `${fruit.charAt(0).toUpperCase() + fruit.slice(1)}`
    );
    console.log('Capitalized fruits:', upperCaseFruits);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();
```