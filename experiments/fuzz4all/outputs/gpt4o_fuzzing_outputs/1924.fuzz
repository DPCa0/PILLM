```javascript
 

 
function fetchData(endpoint) {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            if (endpoint === "users") {
                resolve([
                    { id: 1, name: "Alice" },
                    { id: 2, name: "Bob" },
                ]);
            } else {
                reject("Endpoint not found");
            }
        }, 2000);
    });
}

 
async function getUserData() {
    try {
        const users = await fetchData("users");
        return users;
    } catch (error) {
        console.error(error);
    }
}

 
function* userGenerator(users) {
    for (let user of users) {
        yield `User ID: ${user.id}, Name: ${user.name}`;
    }
}

 
async function main() {
    const users = await getUserData();

    if (users) {
         
        const [firstUser, ...otherUsers] = users;

        console.log(`First User: ${firstUser.name}`);

         
        const newUser = { id: 3, name: "Charlie" };
        const updatedUsers = [...users, newUser];

        console.log("All Users:");
        updatedUsers.forEach((user) => console.log(user.name));

         
        const generator = userGenerator(updatedUsers);
        console.log("User Details:");
        for (let userDetail of generator) {
            console.log(userDetail);
        }

         
        console.log(`Total Users: ${updatedUsers.length}`);
    }
}

main();
```