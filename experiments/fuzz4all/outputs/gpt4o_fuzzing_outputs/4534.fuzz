```javascript
 

 
export function calculate(...numbers) {
  return numbers.reduce((acc, num) => acc + num, 0);
}

 
import { calculate } from './module.js';

async function fetchData(url) {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  const data = await response.json();
  return data;
}

(async () => {
  try {
    const url = 'https://jsonplaceholder.typicode.com/todos/1';
    const { userId, id, title } = await fetchData(url);
    console.log(`User ID: ${userId}, ID: ${id}, Title: ${title}`);

    const sum = calculate(1, 2, 3, 4, 5);
    console.log(`Sum: ${sum}`);
  } catch (error) {
    console.error('Error:', error);
  }
})();
```

Note: For this script to run correctly, it needs to be executed in an environment that supports ES6 modules and fetch (like modern browsers). The `main.js` and `module.js` should be in the same directory or update the import path accordingly.