```javascript
(async () => {
  const getData = async () => {
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    if (!response.ok) throw new Error('Network response was not ok');
    return await response.json();
  };

  const processData = (posts) => {
    const mappedPosts = posts.map(({ id, title, body }) => ({
      id,
      title: title.toUpperCase(),
      snippet: body.slice(0, 50) + '...',
    }));
    const filteredPosts = mappedPosts.filter(({ id }) => id % 2 === 0);
    return filteredPosts.reduce((acc, { id, title }) => {
      acc[id] = title;
      return acc;
    }, {});
  };

  const logResults = (result) => {
    for (const [id, title] of Object.entries(result)) {
      console.log(`Post ID: ${id}, Title: ${title}`);
    }
  };

  try {
    const data = await getData();
    const result = processData(data);
    logResults(result);
  } catch (error) {
    console.error('Error fetching or processing data:', error);
  }
})();
```