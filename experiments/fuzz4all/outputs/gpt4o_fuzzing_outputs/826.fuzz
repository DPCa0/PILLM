```javascript
class Matrix {
  constructor(rows, cols, fill = 0) {
    this.rows = rows;
    this.cols = cols;
    this.data = Array.from({ length: rows }, () => Array(cols).fill(fill));
  }

  static fromArray(arr) {
    const m = new Matrix(arr.length, arr[0].length);
    m.map((_, i, j) => arr[i][j]);
    return m;
  }

  map(fn) {
    this.data = this.data.map((row, i) => row.map((val, j) => fn(val, i, j)));
    return this;
  }

  static multiply(m1, m2) {
    if (m1.cols !== m2.rows) throw new Error('Columns of A must match rows of B.');
    const result = new Matrix(m1.rows, m2.cols);
    result.map((_, i, j) => {
      let sum = 0;
      for (let k = 0; k < m1.cols; k++) {
        sum += m1.data[i][k] * m2.data[k][j];
      }
      return sum;
    });
    return result;
  }

  toString() {
    return this.data.map(row => row.join(' ')).join('\n');
  }
}

const A = Matrix.fromArray([
  [1, 2, 3],
  [4, 5, 6]
]);

const B = Matrix.fromArray([
  [7, 8],
  [9, 10],
  [11, 12]
]);

try {
  const C = Matrix.multiply(A, B);
  console.log(C.toString());
} catch (error) {
  console.error(error.message);
}
```