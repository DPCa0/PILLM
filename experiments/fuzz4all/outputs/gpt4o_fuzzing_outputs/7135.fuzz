```javascript
 
async function fetchDataAndProcess() {
   
  const response = await fetch('https://api.example.com/data');
  const data = await response.json();

   
  const { results, ...metadata } = data;
  const processedResults = results.map(({ id, ...rest }) => ({
    id,
    ...rest,
    processed: true,
  }));

   
  const uniqueIds = new Set(processedResults.map(item => item.id));

   
  const resultMap = new Map();
  processedResults.forEach(item => resultMap.set(item.id, item));

   
  console.log(`Fetched ${uniqueIds.size} unique items from API:`);
  console.log([...resultMap.entries()]);

   
  await new Promise(resolve => setTimeout(resolve, 1000));  
  console.log('Further processing complete');
}

 
(async () => {
  try {
    await fetchDataAndProcess();
  } catch (error) {
    console.error(`Error fetching or processing data: ${error.message}`);
  }
})();
```