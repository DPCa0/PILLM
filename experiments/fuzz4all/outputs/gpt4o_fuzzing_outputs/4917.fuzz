print('Hello, world!');
```javascript
 

const delay = ms => new Promise(res => setTimeout(res, ms));

function* generatorFunction() {
  yield 'Hello';
  yield 'from';
  yield 'the';
  yield 'generator!';
}

const asyncIterable = {
  [Symbol.asyncIterator]: async function* () {
    yield 'Hello,';
    await delay(1000);
    yield 'async';
    await delay(1000);
    yield 'world!';
  }
};

const personHandler = {
  get(target, property) {
    if (property in target) {
      return target[property];
    }
    return `Property ${property} does not exist.`;
  }
};

const person = new Proxy({ name: 'John Doe', age: 30 }, personHandler);

async function displayMessages() {
  console.log('--- Generator Example ---');
  const gen = generatorFunction();
  let genResult;
  while (!(genResult = gen.next()).done) {
    console.log(genResult.value);
  }

  console.log('--- Async Iterator Example ---');
  for await (const message of asyncIterable) {
    console.log(message);
  }

  console.log('--- Proxy Example ---');
  console.log(`Name: ${person.name}`);
  console.log(`Age: ${person.age}`);
  console.log(person.nonExistentProp);   
}

displayMessages();
```