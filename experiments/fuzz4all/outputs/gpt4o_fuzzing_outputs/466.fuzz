async function fetchData(url) {
   
  const data = await new Promise((resolve, reject) => {
    setTimeout(() => {
      resolve({ user: 'John Doe', age: 30, city: 'New York' });
    }, 1000);
  });
  
  return data;
}

 
(async function() {
  try {
    const { user, age, city } = await fetchData('https://api.example.com/data');
    console.log(`User: ${user}, Age: ${age}, City: ${city}`);

     
    const userInfo = `
      Name: ${user}
      Age: ${age}
      City: ${city}
    `;
    console.log(userInfo);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();

 
const numbers = [1, 2, 3, 4, 5];
const squared = numbers.map(num => num ** 2);
console.log('Squared Numbers:', squared);

 
const duplicates = [1, 2, 2, 3, 4, 4, 5];
const unique = [...new Set(duplicates)];
console.log('Unique Numbers:', unique);

 
function* fibonacci(n) {
  let [prev, curr] = [0, 1];
  for (let i = 0; i < n; i++) {
    yield curr;
    [prev, curr] = [curr, prev + curr];
  }
}

console.log('Fibonacci Series:');
for (const num of fibonacci(5)) {
  console.log(num);
}
