```javascript
class Matrix {
  constructor(data) {
    this.data = data;
  }

  static from(size, fn) {
    return new Matrix(Array.from({ length: size }, (_, i) => 
      Array.from({ length: size }, (_, j) => fn(i, j))
    ));
  }

  *[Symbol.iterator]() {
    for (let row of this.data) yield* row;
  }

  map(fn) {
    return new Matrix(this.data.map((row, i) => row.map((v, j) => fn(v, i, j))));
  }

  reduce(fn, initialValue) {
    return this.data.reduce((acc, row, i) => 
      row.reduce((acc, v, j) => fn(acc, v, i, j), acc)
    , initialValue);
  }

  toString() {
    return this.data.map(row => row.join(' ')).join('\n');
  }
}

const size = 3;
const identityMatrix = Matrix.from(size, (i, j) => (i === j ? 1 : 0));
const doubledMatrix = identityMatrix.map(v => v * 2);

console.log('Identity Matrix:\n', identityMatrix.toString());
console.log('\nDoubled Matrix:\n', doubledMatrix.toString());

const sum = [...doubledMatrix].reduce((a, b) => a + b, 0);
console.log('\nSum of elements in Doubled Matrix:', sum);
```