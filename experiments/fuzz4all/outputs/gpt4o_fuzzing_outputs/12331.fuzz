Certainly! Here's a JavaScript program using advanced features such as async/await, Promises, generators, destructuring, and the Spread operator:

```javascript
 
const delay = ms => new Promise(resolve => setTimeout(resolve, ms));

 
async function* fetchUserData(userIds) {
    for (const id of userIds) {
        await delay(100);  
        yield { id, name: `User${id}` };
    }
}

 
async function processUsers() {
    const userIds = [1, 2, 3, 4, 5];
    
     
    const userData = [];
    for await (const user of fetchUserData(userIds)) {
        userData.push(user);
    }
    
     
    const [{ id: firstUserId, name: firstUserName }, ...otherUsers] = userData;
    
    console.log(`First User - ID: ${firstUserId}, Name: ${firstUserName}`);
    console.log("Other Users:", otherUsers);
}

 
(async () => {
    await processUsers();
})();
```

This script demonstrates complex JavaScript features in a compact program, illustrating modern programming paradigms in a practical way.