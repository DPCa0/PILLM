import { promises as fsPromises } from 'fs';
import EventEmitter from 'events';

 
(async () => {
   
  const [file1, file2] = await Promise.all([
    fsPromises.readFile('file1.txt', 'utf-8'),
    fsPromises.readFile('file2.txt', 'utf-8'),
  ]);

   
  const mergedContent = `Combined Content:\n${[...file1.split('\n'), ...file2.split('\n')].join('\n')}`;

   
  class Logger extends EventEmitter {
    log(message) {
      this.emit('log', message);
    }
  }

  const logger = new Logger();
  const handler = {
    get: (target, property) => {
      if (property in target) {
        console.log(`Accessing ${property}`);
        return target[property];
      } else {
        return `Property ${property} does not exist`;
      }
    },
  };

   
  const proxyLogger = new Proxy(logger, handler);

  proxyLogger.on('log', (message) => console.log(`LOG: ${message}`));
  proxyLogger.log('Starting to save the merged content.');

   
  const uniqueLines = new Set(mergedContent.split('\n').filter((line) => line.trim() !== ''));

   
  const lineOccurrences = new Map();
  for (const line of uniqueLines) {
    lineOccurrences.set(line, (lineOccurrences.get(line) || 0) + 1);
  }

  lineOccurrences.forEach((value, key) => {
    proxyLogger.log(`Line: "${key}" occurs ${value} time(s)`);
  });

   
  await fsPromises.writeFile('merged.txt', [...uniqueLines].join('\n'));
  proxyLogger.log('Content successfully saved to "merged.txt".');
})();
