print('Hello, world!');
```javascript
 

 
const fetchData = () => new Promise((resolve) => {
    setTimeout(() => resolve({ status: 200, data: { name: 'Alice', age: 30 } }), 1000);
});

 
const loggingProxy = (target) => new Proxy(target, {
    get: (obj, prop) => {
        console.log(`Getting property: ${prop}`);
        return obj[prop];
    },
    set: (obj, prop, value) => {
        console.log(`Setting property: ${prop} to ${value}`);
        obj[prop] = value;
        return true;
    }
});

(async () => {
    try {
         
        const response = await fetchData();
        const { status, data: { name, ...rest } } = response;

        console.log(`Status: ${status}`);
        console.log(`Name: ${name}`);
        console.log(`Rest of the data:`, rest);

         
        const proxyData = loggingProxy(rest);
        
         
        proxyData.age = 31;
        console.log(`Updated Age: ${proxyData.age}`);

    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```