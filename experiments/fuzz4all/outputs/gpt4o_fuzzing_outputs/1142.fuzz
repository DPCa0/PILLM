```javascript
class Deferred {
    constructor() {
        this.promise = new Promise((resolve, reject) => {
            this.resolve = resolve;
            this.reject = reject;
        });
    }
}

async function complexAsyncOperation() {
    const deferred1 = new Deferred();
    const deferred2 = new Deferred();
    
    const result1 = deferred1.promise.then(value => `Processed: ${value}`);
    const result2 = deferred2.promise.then(value => value * 2);
    
    setTimeout(() => deferred1.resolve('Data'), Math.random() * 2000);
    setTimeout(() => deferred2.resolve(42), Math.random() * 2000);
    
    const [finalResult1, finalResult2] = await Promise.all([result1, result2]);
    return { finalResult1, finalResult2 };
}

function* generateNumbers(limit) {
    let num = 0;
    while (num < limit) {
        yield num++;
    }
}

(async function execute() {
    const { finalResult1, finalResult2 } = await complexAsyncOperation();
    console.log('Async results:', finalResult1, finalResult2);

    const numbers = Array.from(generateNumbers(5));
    const doubledNumbers = numbers.map(n => n * 2);
    
    console.log('Generated Numbers:', numbers);
    console.log('Doubled Numbers:', doubledNumbers);

    const proxyHandler = {
        get: (target, prop) => {
            return prop in target ? target[prop] : `Property ${prop} doesn't exist`;
        }
    };

    const proxy = new Proxy({ name: 'JavaScript', year: 1995 }, proxyHandler);
    console.log('Proxy Example:', proxy.name, proxy.year, proxy.language);
})();
```