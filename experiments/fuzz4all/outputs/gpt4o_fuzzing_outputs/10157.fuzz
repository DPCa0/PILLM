async function* asyncCounter(limit) {
  let count = 0;
  while (count < limit) {
    await new Promise(resolve => setTimeout(resolve, 100));  
    yield count++;
  }
}

 
function createLoggingObject(initialObject) {
  return new Proxy(initialObject, {
    get(target, property) {
      console.log(`Getting property: ${property}`);
      return target[property];
    },
    set(target, property, value) {
      console.log(`Setting property: ${property} to ${value}`);
      target[property] = value;
      return true;
    }
  });
}

 
const uniqueKey = Symbol('unique');
const complexMap = new Map();
complexMap.set(uniqueKey, { data: 'Unique Data' });

const logObject = createLoggingObject({ name: 'JavaScript', version: 2023 });

 
(async () => {
  console.log(`Unique key data:`, complexMap.get(uniqueKey).data);

  for await (let number of asyncCounter(5)) {
    console.log(`Async counter value: ${number}`);
  }

  console.log(`Object name before update: ${logObject.name}`);
  logObject.name = 'Node.js';
  console.log(`Object name after update: ${logObject.name}`);
})();
```