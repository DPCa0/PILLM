class ReactiveStore {
    constructor(initialState = {}) {
        this.state = new Proxy(initialState, {
            set: (target, key, value) => {
                if (target[key] !== value) {
                    target[key] = value;
                    this.subscribers.forEach(sub => sub());
                }
                return true;
            }
        });
        this.subscribers = new Set();
    }

    subscribe(subscriber) {
        this.subscribers.add(subscriber);
        return () => this.subscribers.delete(subscriber);
    }

    update(updater) {
        const newState = updater(this.state);
        Object.keys(newState).forEach(key => {
            this.state[key] = newState[key];
        });
    }
}

async function fetchData(url) {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    return response.json();
}

function createAsyncComponent(url) {
    let data = null;
    let error = null;
    const store = new ReactiveStore({ loading: true, data, error });

    const fetchDataAndUpdateStore = async () => {
        try {
            data = await fetchData(url);
            store.update(() => ({ loading: false, data, error: null }));
        } catch (err) {
            error = err;
            store.update(() => ({ loading: false, data: null, error }));
        }
    };

    fetchDataAndUpdateStore();

    return (render) => {
        const unsubscribe = store.subscribe(() => render(store.state));
        render(store.state);
        return unsubscribe;
    };
}

 
const render = ({ loading, data, error }) => {
    if (loading) {
        console.log('Loading...');
    } else if (error) {
        console.error('Error:', error);
    } else {
        console.log('Data:', data);
    }
};

const asyncComponent = createAsyncComponent('https://api.example.com/data');
asyncComponent(render);
```