class AsyncManager {
  constructor(tasks) {
    this.tasks = tasks;
  }
  
  async executeTasks() {
    const results = await Promise.allSettled(this.tasks.map(task => task()));
    return results.map(result => result.status === 'fulfilled' ? result.value : 'Error');
  }
}

const getData = async (id) => {
  const response = await fetch(`https: 
  if (!response.ok) throw new Error('Network response was not ok');
  const data = await response.json();
  return data.title;
};

const delayedTask = (message, delay) => 
  new Promise((resolve) => setTimeout(() => resolve(message), delay));

(async () => {
  const manager = new AsyncManager([
    () => getData(1),
    () => delayedTask('This took some time', 2000),
    () => getData(2),
    () => delayedTask('Another delayed message', 1000),
    () => getData(100)   
  ]);

  const results = await manager.executeTasks();
  results.forEach((result, index) => console.log(`Task ${index + 1}: ${result}`));
})();
```