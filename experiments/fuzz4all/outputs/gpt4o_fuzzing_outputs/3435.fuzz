```javascript
const fetchData = async (url) => {
  const response = await fetch(url);
  if (!response.ok) throw new Error('Network response was not ok');
  return response.json();
};

const processUserData = ({ name, email }) => {
  const username = name.toLowerCase().replace(/\s/g, '_');
  const emailProvider = email.split('@')[1];
  return { username, emailProvider };
};

const main = async () => {
  try {
    const users = await fetchData('https://jsonplaceholder.typicode.com/users');
    const processedUsers = users.map(processUserData);

    const groupedByProvider = processedUsers.reduce((acc, { emailProvider, username }) => {
      if (!acc[emailProvider]) acc[emailProvider] = [];
      acc[emailProvider].push(username);
      return acc;
    }, {});

    console.log(groupedByProvider);
  } catch (error) {
    console.error('Error fetching or processing data:', error);
  }
};

main();
```