```javascript
 

class UserService {
  constructor() {
    this.users = new Map();
  }

  addUser(id, name, email) {
    this.users.set(id, { name, email });
  }

  getUser(id) {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (this.users.has(id)) {
          resolve(this.users.get(id));
        } else {
          reject(new Error("User not found"));
        }
      }, 1000);
    });
  }
}

(async function displayUserInfo() {
  const userService = new UserService();
  userService.addUser(1, "Alice", "alice@example.com");
  userService.addUser(2, "Bob", "bob@example.com");

  try {
    const user = await userService.getUser(1);
    console.log(`User Info:\nName: ${user.name}\nEmail: ${user.email}`);
  } catch (error) {
    console.error(error);
  }

  try {
    const user = await userService.getUser(3);
    console.log(`User Info:\nName: ${user.name}\nEmail: ${user.email}`);
  } catch (error) {
    console.error(error.message);
  }
})();
```