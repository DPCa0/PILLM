```javascript
class DataProcessor {
  #privateData = new WeakMap();

  constructor(data) {
    this.#privateData.set(this, this.#processData(data));
  }

  #processData(data) {
    return data.map(({ id, value }) => ({ id, squaredValue: value ** 2 }));
  }

  *getDataGenerator() {
    for (const item of this.#privateData.get(this)) {
      yield item;
    }
  }

  async fetchData(url) {
    const response = await fetch(url);
    const data = await response.json();
    return this.#processData(data);
  }

  static async withFetchedData(url) {
    const instance = new DataProcessor([]);
    instance.#privateData.set(instance, await instance.fetchData(url));
    return instance;
  }
}

(async () => {
  const url = 'https://api.example.com/data';
  const processor = await DataProcessor.withFetchedData(url);

  for (const item of processor.getDataGenerator()) {
    console.log(item);
  }
})();
```