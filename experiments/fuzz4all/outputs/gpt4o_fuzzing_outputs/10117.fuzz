print('Hello, world!');
```javascript
 
async function* fetchDataGenerator() {
  const delay = ms => new Promise(resolve => setTimeout(resolve, ms));
  for (let i = 1; i <= 3; i++) {
    await delay(1000);
    yield `Data chunk ${i}`;
  }
}

 
function createMultiplier(factor) {
  return function(number) {
    return number * factor;
  };
}

const multiplyByTwo = createMultiplier(2);

 
const handler = {
  get: function(target, property) {
    return property in target ? target[property] : `Property ${property} not found`;
  }
};

const dynamicObject = new Proxy({}, handler);
dynamicObject.existingProp = 'I exist';

 
function logMethod(target, propertyKey, descriptor) {
  const originalMethod = descriptor.value;
  descriptor.value = function(...args) {
    console.log(`Call to ${propertyKey} with args: ${args}`);
    return originalMethod.apply(this, args);
  };
}

class Calculator {
  @logMethod
  add(a, b) {
    return a + b;
  }

  @logMethod
  subtract(a, b) {
    return a - b;
  }
}

 
(async () => {
  console.log('--- Fetching Data with Async Generators ---');
  for await (const data of fetchDataGenerator()) {
    console.log(data);
  }

  console.log('\n--- Multiplying using Closures ---');
  console.log(multiplyByTwo(5));  

  console.log('\n--- Dynamic Object Access with Proxy ---');
  console.log(dynamicObject.existingProp);  
  console.log(dynamicObject.nonExistingProp);  

  console.log('\n--- Method Logging with Decorators ---');
  const calculator = new Calculator();
  console.log(calculator.add(4, 3));  
  console.log(calculator.subtract(10, 5));  
})();
```