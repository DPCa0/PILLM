```javascript
 

 
const fetchData = () => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            const data = Math.random() > 0.2 ? { value: 'Success' } : null;
            data ? resolve(data) : reject(new Error('Failed to fetch data'));
        }, 1000);
    });
};

 
async function* dataGenerator() {
    for (let i = 0; i < 5; i++) {
        try {
            const data = await fetchData();
            yield data.value;
        } catch (error) {
            yield error.message;
        }
    }
}

 
const processData = (first, ...rest) => {
    console.log(`Processing: ${first}`);
    if (rest.length) {
        console.log('Additional data:', ...rest);
    }
};

 
(async () => {
    const gen = dataGenerator();
    const results = [];
    
    for await (const data of gen) {
        results.push(data);
    }

     
    const uniqueResults = Array.from(new Set(results));

     
    processData(...uniqueResults);
})();
```