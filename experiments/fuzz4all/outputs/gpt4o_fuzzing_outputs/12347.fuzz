const delay = (ms) => new Promise(resolve => setTimeout(resolve, ms));

 
async function fetchDataAndLog() {
    const urls = [
        'https://jsonplaceholder.typicode.com/posts/1',
        'https://jsonplaceholder.typicode.com/posts/2',
        'https://jsonplaceholder.typicode.com/posts/3'
    ];
    
     
    const fetchPromises = urls.map(async url => {
        const response = await fetch(url);
        const data = await response.json();
        return data;
    });

    try {
         
        const results = await Promise.all(fetchPromises);

         
        const clonedResults = [...results];

         
        const titles = clonedResults.map(({ id, title }) => ({ id, title }));

         
        await delay(1000);
        console.log('Fetched Titles:', titles);
    } catch (error) {
        console.error('Error fetching data:', error);
    }
}

 
function* idGenerator() {
    let id = 1;
    while (true) {
        yield id++;
    }
}

const generateId = idGenerator();

 
const handler = {
    get(target, prop, receiver) {
        if (prop in target) {
            console.log(`Getting property '${prop}': ${target[prop]}`);
            return Reflect.get(...arguments);
        }
        throw new ReferenceError(`Property '${prop}' does not exist.`);
    },
    set(target, prop, value, receiver) {
        console.log(`Setting property '${prop}' to ${value}`);
        return Reflect.set(...arguments);
    }
};

const user = new Proxy({ name: 'John Doe', age: 25 }, handler);

 
function tag(strings, ...values) {
    return strings.reduce((acc, str, i) => acc + str + (values[i] ? `<<${values[i]}>>` : ''), '');
}

const name = "Alice";
const message = tag`Hello, ${name}! Welcome to the future of Java