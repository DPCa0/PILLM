print('Hello, world!');
```javascript
class Person {
    constructor(name, age) {
        this.name = name;
        this.age = age;
    }

    async greet() {
        const greeting = await this.fetchGreeting();
        console.log(`${greeting}, ${this.name}!`);
    }

    fetchGreeting() {
        return new Promise((resolve) => {
            setTimeout(() => resolve('Hello'), 1000);
        });
    }
}

const createProxy = (person) => {
    return new Proxy(person, {
        get(target, prop, receiver) {
            if (prop === 'age') {
                return Reflect.get(target, prop, receiver) + ' years old';
            }
            return Reflect.get(target, prop, receiver);
        },
        set(target, prop, value) {
            if (prop === 'age' && typeof value !== 'number') {
                throw new TypeError('Age must be a number');
            }
            return Reflect.set(target, prop, value);
        }
    });
};

(async () => {
    const bob = createProxy(new Person('Bob', 30));
    await bob.greet();

    console.log(`Bob is ${bob.age}.`);
    
    try {
        bob.age = 'thirty-one';
    } catch (error) {
        console.error(error.message);
    }
})();
```