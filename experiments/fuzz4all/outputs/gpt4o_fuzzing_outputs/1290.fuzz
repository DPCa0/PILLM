class EventEmitter {
    constructor() {
        this.events = new Map();
    }

    on(event, listener) {
        if (!this.events.has(event)) {
            this.events.set(event, []);
        }
        this.events.get(event).push(listener);
    }

    emit(event, ...args) {
        if (this.events.has(event)) {
            this.events.get(event).forEach(listener => listener(...args));
        }
    }
}

const asyncAdd = async (a, b) => {
    return await new Promise(resolve => {
        setTimeout(() => resolve(a + b), 1000);
    });
};

const logger = async function* (messages) {
    for (const message of messages) {
        yield await new Promise(resolve => setTimeout(() => resolve(message), 500));
    }
};

(async () => {
    const emitter = new EventEmitter();
    
    emitter.on('result', result => {
        console.log(`Result is: ${result}`);
    });

    const result = await asyncAdd(5, 10);
    emitter.emit('result', result);

    const messages = logger(["Starting process...", "Processing data...", "Process complete."]);
    
    for await (const msg of messages) {
        console.log(msg);
    }
})();
```