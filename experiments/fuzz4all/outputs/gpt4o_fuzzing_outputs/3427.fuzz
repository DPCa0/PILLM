```javascript
 
function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
}

 
async function advancedFeatureDemo() {
    console.log('Starting advanced feature demo...');

     
    const person = { name: 'Alice', age: 30, job: 'Developer' };
    const { name, ...otherDetails } = person;
    console.log(`Name: ${name}`);
    console.log(`Other Details:`, otherDetails);

     
    const user = { profile: { email: null } };
    console.log(`User Email: ${user.profile?.email ?? 'Email not available'}`);

     
    (async () => {
        const { add } = await import('./mathUtils.js');
        console.log(`Addition: 2 + 3 = ${add(2, 3)}`);
    })();

     
    await delay(2000);
    console.log('Finished delay...');

     
    const numbers = [1, 2, 3, 4, 5];
    const squaredEvenNumbers = numbers
        .map(num => num * num)
        .filter(num => num % 2 === 0);
    console.log('Squared Even Numbers:', squaredEvenNumbers);

    const sum = numbers.reduce((acc, val) => acc + val, 0);
    console.log('Sum of Numbers:', sum);

    console.log('Advanced feature demo complete.');
}

 
advancedFeatureDemo();
```