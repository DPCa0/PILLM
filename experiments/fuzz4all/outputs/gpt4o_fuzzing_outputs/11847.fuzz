```javascript
 

class DataProcessor {
  constructor(data) {
    this.data = data;
  }

   
  *processData() {
    for (const item of this.data) {
      yield this.transform(item);
    }
  }

   
  transform(item) {
    const handler = {
      apply(target, thisArg, args) {
        console.log(`Transforming item: ${args[0]}`);
        return target(...args);
      }
    };

    const transformationFunction = (x) => ({
      ...x,
      transformedValue: x.value * 2
    });

    const proxy = new Proxy(transformationFunction, handler);
    return proxy(item);
  }

   
  async fetchData() {
    const response = await fetch('https://jsonplaceholder.typicode.com/posts');
    const posts = await response.json();
    return posts.slice(0, 5);
  }

   
  static async createWithFetchedData() {
    const processor = new DataProcessor([]);
    const data = await processor.fetchData();
    processor.data = data.map(post => ({ id: post.id, value: post.id }));
    return processor;
  }
}

(async () => {
   
  const processor = await DataProcessor.createWithFetchedData();

   
  for (const transformedItem of processor.processData()) {
    console.log(transformedItem);
  }
})();
```