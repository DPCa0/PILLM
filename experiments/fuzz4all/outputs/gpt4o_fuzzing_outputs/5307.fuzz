```javascript
 

const fetchData = (url) => {
    return new Promise((resolve, reject) => {
        setTimeout(() => {
            const data = {
                userId: 1,
                id: 101,
                title: "Advanced JavaScript",
                body: "Understanding advanced JavaScript features is crucial for modern development."
            };
            resolve(data);
        }, 1000);
    });
};

const processData = async (url) => {
    try {
        const data = await fetchData(url);
        const { title, body } = data;
        return `Title: ${title}\nBody: ${body}`;
    } catch (error) {
        throw new Error('Data processing failed');
    }
};

const handler = {
    get: (target, property) => {
        if (property in target) {
            return target[property];
        } else {
            console.warn(`Property ${property} does not exist on target`);
            return null;
        }
    },
    set: (target, property, value) => {
        if (typeof value === 'string') {
            target[property] = value;
            console.log(`Set ${property} to ${value}`);
            return true;
        } else {
            console.error(`Invalid type for ${property}: ${typeof value}`);
            return false;
        }
    }
};

(async () => {
    const dataProxy = new Proxy({}, handler);
    const url = "https://example.com/api/data";
    const processedData = await processData(url);

    dataProxy.processedData = processedData;
    console.log(dataProxy.processedData);

     
    dataProxy.invalidProperty = 12345;
})();
```