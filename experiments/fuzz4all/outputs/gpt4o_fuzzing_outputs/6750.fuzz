```javascript
 
const fetchUserData = async () => {
  try {
     
    const response = await fetch('https://jsonplaceholder.typicode.com/users');
    const users = await response.json();

     
    const processedData = users
      .filter(user => user.address.geo.lat < 0)  
      .map(user => ({  
        id: user.id,
        name: user.name,
        email: user.email,
        company: user.company.name
      }))
      .reduce((acc, user) => {  
        acc[user.email] = user;
        return acc;
      }, {});

    console.log('Processed Data:', processedData);
  } catch (error) {
    console.error('Error fetching user data:', error);
  }
};

 
function* userGenerator(usersObject) {
  for (const email in usersObject) {
    yield usersObject[email];
  }
}

 
fetchUserData().then(() => {
  const usersObject = {
    'sincere@april.biz': { id: 1, name: 'Leanne Graham', email: 'sincere@april.biz', company: 'Romaguera-Crona' },
    'shanna@melissa.tv': { id: 2, name: 'Ervin Howell', email: 'shanna@melissa.tv', company: 'Deckow-Crist' }
  };

  const gen = userGenerator(usersObject);
  
  for (let user of gen) {
    console.log('Generated User:', user);
  }
});
```