print('Hello, world!');
```javascript
 

 
(async () => {
  const { createRequire } = await import('module');
  const require = createRequire(import.meta.url);
  const fs = require('fs').promises;

   
  const fetchData = () => {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (Math.random() > 0.2) {
          resolve({ data: 'Sample Data', status: 200 });
        } else {
          reject(new Error('Failed to fetch data'));
        }
      }, 1000);
    });
  };

   
  const processAsyncTasks = async () => {
    try {
      const fileData = await fs.readFile('./sample.txt', 'utf-8');
      console.log('File content:', fileData);

      const { data, status } = await fetchData();
      console.log(`Fetched Data: ${data}, Status: ${status}`);
    } catch (error) {
      console.error('An error occurred:', error.message);
    }
  };

   
  const user = {
    name: 'John Doe',
    details: { email: 'john@example.com' }
  };

  const {
    name = 'Anonymous',
    details: { email = 'no-email@example.com' }
  } = user;

  console.log(`User: ${name}, Email: ${email}`);

   
  processAsyncTasks();
})();
```

Make sure to create a file named `sample.txt` in the same directory containing some text to read the file successfully.