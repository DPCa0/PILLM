```javascript
 
const fetchData = async (url) => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      if (url === 'https://api.example.com/data') {
        resolve({ data: [1, 2, 3, 4, 5] });
      } else {
        reject('Invalid URL');
      }
    }, 1000);
  });
};

 
(async () => {
  try {
     
    const { data } = await fetchData('https://api.example.com/data');

     
    const squaredData = data.map(num => num ** 2).filter(num => num > 10);
    const result = `Squared numbers greater than 10: ${squaredData.join(', ')}`;

     
    const styledLog = (strings, ...values) => {
      return strings.reduce((acc, str, i) => `${acc}%c${str}${values[i] || ''}`, '');
    };

    console.log(styledLog`Result: ${result}`, 'color: green; font-weight: bold');
  } catch (error) {
    console.error('Error:', error);
  }
})();
```