```javascript
 
 

class Event {
  constructor(name, capacity) {
    this.name = name;
    this.capacity = capacity;
    this.bookedTickets = 0;
  }
  
  get availableTickets() {
    return this.capacity - this.bookedTickets;
  }
  
  bookTicket(numberOfTickets) {
    return new Promise((resolve, reject) => {
      setTimeout(() => {
        if (numberOfTickets > this.availableTickets) {
          reject(`Not enough tickets available for ${this.name}`);
        } else {
          this.bookedTickets += numberOfTickets;
          resolve(`Successfully booked ${numberOfTickets} tickets for ${this.name}`);
        }
      }, 1000);
    });
  }
}

 
const delay = ms => new Promise(res => setTimeout(res, ms));

 
(async () => {
  try {
    const concert = new Event('Concert', 100);
    console.log(`Initial available tickets for ${concert.name}: ${concert.availableTickets}`);

    const bookingResults = await Promise.all([
      concert.bookTicket(30),
      concert.bookTicket(50),
      concert.bookTicket(25)  
    ]);

    bookingResults.forEach(result => console.log(result));
  } catch (error) {
    console.error(error);
  } finally {
    await delay(500);  
    console.log('Booking process completed.');
  }
})();
```