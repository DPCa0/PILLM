```javascript
class FibonacciSequence {
  constructor(maxValue) {
    this.maxValue = maxValue;
    this[Symbol.iterator] = function* () {
      let a = 0, b = 1;
      while (a <= this.maxValue) {
        yield a;
        [a, b] = [b, a + b];
      }
    };
  }
}

const fibonacci = new FibonacciSequence(1000);
const fibArray = [...fibonacci];
console.log(`Fibonacci numbers up to 1000: ${fibArray.join(', ')}`);

const asyncTimeout = (ms) => new Promise(resolve => setTimeout(resolve, ms));

async function fetchData() {
  console.log('Fetching data...');
  await asyncTimeout(2000);
  console.log('Data fetched!');
}

(async () => {
  try {
    const response = await fetch('https://jsonplaceholder.typicode.com/todos/1');
    const data = await response.json();
    console.log('Fetched Todo:', data);
  } catch (error) {
    console.error('Error fetching data:', error);
  }
})();

fetchData();

const symbolUsage = Symbol('unique');
const symbolObject = {
  [symbolUsage]: 'This is a unique symbol'
};

console.log(`Symbol value: ${symbolObject[symbolUsage]}`);
```