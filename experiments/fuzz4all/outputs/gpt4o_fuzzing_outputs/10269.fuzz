```javascript
class AsyncQueue {
    constructor() {
        this.queue = [];
        this.processing = false;
    }

    enqueue(promise) {
        this.queue.push(promise);
        this.processNext();
    }

    async processNext() {
        if (this.processing || this.queue.length === 0) return;
        
        this.processing = true;
        const promise = this.queue.shift();
        try {
            const result = await promise();
            console.log('Processed:', result);
        } catch (error) {
            console.error('Error:', error);
        } finally {
            this.processing = false;
            this.processNext();
        }
    }
}

const delayedResolve = (value, delay) => () => new Promise((resolve) => {
    setTimeout(() => resolve(value), delay);
});

const delayedReject = (reason, delay) => () => new Promise((_, reject) => {
    setTimeout(() => reject(reason), delay);
});

const queue = new AsyncQueue();

queue.enqueue(delayedResolve('Task 1', 1000));
queue.enqueue(delayedReject('Error on Task 2', 1500));
queue.enqueue(delayedResolve('Task 3', 500));
queue.enqueue(delayedResolve('Task 4', 2000));

 
const handler = {
    get(target, prop, receiver) {
        if (prop === 'enqueue') {
            return function(...args) {
                console.log(`Enqueuing task at ${new Date().toLocaleTimeString()}`);
                return Reflect.apply(target[prop], target, args);
            };
        }
        return Reflect.get(target, prop, receiver);
    }
};

const proxiedQueue = new Proxy(queue, handler);

proxiedQueue.enqueue(delayedResolve('Task 5', 1200));
proxiedQueue.enqueue(delayedReject('Error on Task 6', 800));
```