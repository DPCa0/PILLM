```javascript
class AsyncMatrix {
    constructor(rows, cols, fill = 0) {
        this.matrix = Array.from({ length: rows }, () => Array(cols).fill(fill));
    }

    async fillMatrix(asyncFunc) {
        const promises = this.matrix.map((row, i) =>
            Promise.all(row.map((_, j) => asyncFunc(i, j)))
        );
        this.matrix = await Promise.all(promises);
    }

    async reduceMatrix(reduceFunc, initialValue) {
        return this.matrix.flat().reduce(reduceFunc, initialValue);
    }
}

const fetchRandom = async () => {
    const response = await fetch('https://www.randomnumberapi.com/api/v1.0/random');
    const data = await response.json();
    return data[0];
};

const main = async () => {
    const matrix = new AsyncMatrix(3, 3);
    
    await matrix.fillMatrix(async (i, j) => {
        console.log(`Fetching random number for position (${i}, ${j})`);
        return fetchRandom();
    });
    
    console.log('Matrix filled with random numbers:', matrix.matrix);
    
    const sum = await matrix.reduceMatrix((acc, val) => acc + val, 0);
    console.log('Sum of all numbers in the matrix:', sum);
};

main().catch(error => console.error('Error:', error));
```