```javascript
 

 
async function fetchUserData(url) {
  try {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    
    const { results: [user] } = await response.json();  
    return user;
  } catch (error) {
    console.error('Error fetching user data:', error);
  }
}

 
async function* asyncUserGenerator(urls) {
  for (const url of urls) {
    yield await fetchUserData(url);
  }
}

 
const userLogger = new Proxy({}, {
  get: (target, prop) => {
    console.log(`Getting value of ${prop}`);
    return Reflect.get(target, prop);
  },
  set: (target, prop, value) => {
    console.log(`Setting value of ${prop} to ${value}`);
    return Reflect.set(target, prop, value);
  }
});

 
(async function() {
  const urls = [
    'https://randomuser.me/api/',
    'https://randomuser.me/api/',
    'https://randomuser.me/api/'
  ];

  for await (const user of asyncUserGenerator(urls)) {
    Object.assign(userLogger, user);  
    console.log(userLogger.name?.first, userLogger.name?.last);  
  }
})();
