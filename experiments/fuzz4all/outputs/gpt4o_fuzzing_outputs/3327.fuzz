print('Hello, world!');
```javascript
(async () => {
   
  const fetchData = async (url) => {
    const response = await fetch(url);
    const data = await response.json();
    const { title, completed } = data;
    return { title, completed };
  };

   
  const logHandler = {
    get: (target, prop) => {
      console.log(`Property '${prop}' has been accessed`);
      return target[prop];
    },
    set: (target, prop, value) => {
      console.log(`Property '${prop}' has been set to '${value}'`);
      target[prop] = value;
      return true;
    }
  };

   
  const todoItem = {
    title: "Untitled",
    completed: false
  };

   
  const proxiedTodoItem = new Proxy(todoItem, logHandler);

   
  async function* fetchTodos(urls) {
    for (const url of urls) {
      yield await fetchData(url);
    }
  }

   
  const todoURLs = [
    "https://jsonplaceholder.typicode.com/todos/1",
    "https://jsonplaceholder.typicode.com/todos/2"
  ];

   
  const todosIterator = fetchTodos(todoURLs);
  for await (const todo of todosIterator) {
    const { title, completed } = todo;
    proxiedTodoItem.title = title;
    proxiedTodoItem.completed = completed;
  }

   
  const todoMap = new Map();
  todoMap.set(proxiedTodoItem.title, proxiedTodoItem.completed);

  const uniqueTodos = new Set(todoMap.keys());
  console.log(`Unique todo titles: ${[...uniqueTodos].join(', ')}`);
})();
```