```javascript
 
const uniqueID = Symbol('id');

 
const createValidatedObject = (initialData) => {
    return new Proxy(initialData, {
        set(target, prop, value) {
            if (typeof value !== 'string') {
                throw new TypeError('Values must be strings');
            }
            target[prop] = value;
            return true;
        }
    });
};

 
const privateData = new WeakMap();

class ComplexObject {
    constructor(data) {
        this[uniqueID] = Symbol('objectUniqueID');
        this.data = createValidatedObject(data);
        privateData.set(this, { secret: 'HiddenValue' });
    }

    *dataIterator() {
        for (const key of Object.keys(this.data)) {
            yield [key, this.data[key]];
        }
    }

    getSecret() {
        return privateData.get(this).secret;
    }
}

 
async function fetchData(url) {
    const response = await fetch(url);
    if (!response.ok) {
        throw new Error('Network response was not ok');
    }
    const data = await response.json();
    return data;
}

 
const object = new ComplexObject({ name: 'Alice', profession: 'Developer' });

(async () => {
    try {
        const apiData = await fetchData('https://jsonplaceholder.typicode.com/users/1');
        console.log(`Fetched user: ${apiData.name}`);

        console.log('Object Data:');
        for (let [key, value] of object.dataIterator()) {
            console.log(`${key}: ${value}`);
        }

        console.log(`Secret: ${object.getSecret()}`);

    } catch (error) {
        console.error(`An error occurred: ${error.message}`);
    }
})();
```