```javascript
 

class Matrix {
  constructor(rows, cols) {
    this.rows = rows;
    this.cols = cols;
    this.data = Array.from({ length: rows }, () => Array(cols).fill(0));
  }
  
  static async multiply(a, b) {
    if (a.cols !== b.rows) throw new Error('Columns of A must match rows of B');
    let result = new Matrix(a.rows, b.cols);

    const promises = [];
    for (let i = 0; i < result.rows; i++) {
      for (let j = 0; j < result.cols; j++) {
        promises.push((async () => {
          let sum = 0;
          for (let k = 0; k < a.cols; k++) {
            sum += a.data[i][k] * b.data[k][j];
          }
          result.data[i][j] = sum;
        })());
      }
    }
    await Promise.all(promises);
    return result;
  }
}

(async () => {
  const [[a1, a2], [b1, b2]] = [[1, 2], [3, 4]];  
  const m1 = new Matrix(2, 2);
  const m2 = new Matrix(2, 2);
  m1.data = [[a1, a2], [b1, b2]];
  m2.data = [[5, 6], [7, 8]];

  const result = await Matrix.multiply(m1, m2);
  console.log('Matrix Multiplication Result:', result.data);
})();
