print('Hello, world!');
```javascript
class Animal {
  constructor(name) {
    this.name = name;
  }
  speak() {
    console.log(`${this.name} makes a noise.`);
  }
}

class Dog extends Animal {
  speak() {
    super.speak();
    console.log(`${this.name} barks.`);
  }
}

const proxyHandler = {
  get: function(target, property) {
    if (property in target) {
      return target[property];
    } else {
      console.log(`Property '${property}' doesn't exist.`);
    }
  },
};

const dog = new Dog('Rex');
const proxyDog = new Proxy(dog, proxyHandler);

const asyncExample = async () => {
  const delayedMessage = new Promise((resolve, reject) => {
    setTimeout(() => resolve('Hello from the future!'), 1000);
  });

  const message = await delayedMessage;
  console.log(message);
};

const iterable = {
  [Symbol.iterator]: function* () {
    yield 1;
    yield 2;
    yield 3;
  },
};

for (const value of iterable) {
  console.log(value);
}

proxyDog.speak();
proxyDog.fly;   

(async () => {
  await asyncExample();
})();

console.log([...iterable]);   
```