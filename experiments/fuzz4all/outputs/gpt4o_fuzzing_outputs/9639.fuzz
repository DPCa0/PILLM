```javascript
 
const randomDelay = () => new Promise(resolve => setTimeout(resolve, Math.random() * 1000));

 
async function* generateRandomNumbers(count) {
    for (let i = 0; i < count; i++) {
        await randomDelay();
        yield Math.floor(Math.random() * 100);
    }
}

 
(async function displayNumbers() {
    const numbers = [];
    for await (let number of generateRandomNumbers(5)) {
        console.log(`Generated number: ${number}`);
        numbers.push(number);
    }

     
    const [max, min, sum] = [
        Math.max(...numbers),
        Math.min(...numbers),
        numbers.reduce((a, b) => a + b, 0)
    ];
    console.log(`Max: ${max}, Min: ${min}, Sum: ${sum}`);

     
    const stats = {
        max,
        min,
        sum,
        average() {
            return sum / numbers.length;
        }
    };

     
    console.log(`Statistics: Max = ${stats.max}, Min = ${stats.min}, Sum = ${stats.sum}, Avg = ${stats.average().toFixed(2)}`);
})();
```