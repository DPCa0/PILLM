```javascript
class Fibonacci {
  constructor() {
    this.memo = new Map([[0, 0], [1, 1]]);
  }
  compute(n) {
    if (!this.memo.has(n)) {
      this.memo.set(n, this.compute(n - 1) + this.compute(n - 2));
    }
    return this.memo.get(n);
  }
}

const fibonacciGen = function* (max) {
  const fib = new Fibonacci();
  for (let i = 0; i <= max; i++) {
    yield fib.compute(i);
  }
};

const asyncPrintFib = async (n) => {
  console.log(`Calculating Fibonacci series up to ${n}...`);
  for await (const num of fibonacciGen(n)) {
    await new Promise((resolve) => setTimeout(resolve, 100));  
    console.log(num);
  }
};

(async () => {
  try {
    await asyncPrintFib(10);
  } catch (error) {
    console.error('Error occurred:', error);
  }
})();
```