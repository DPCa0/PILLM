```javascript
 

 
function fetchData() {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      resolve({ data: "Advanced JavaScript Data" });
    }, 1000);
  });
}

 
const handler = {
  get: function(target, property, receiver) {
    if (property in target) {
      return target[property];
    } else {
      throw new Error(`Property ${property} doesn't exist`);
    }
  }
};

 
async function processData() {
  try {
    console.log("Fetching data...");
    let response = await fetchData();
     
    const proxyResponse = new Proxy(response, handler);

    console.log(proxyResponse.data);  

    console.log(proxyResponse.nonExistentProperty);  
  } catch (error) {
    console.error("Error:", error.message);
  }
}

processData();
```