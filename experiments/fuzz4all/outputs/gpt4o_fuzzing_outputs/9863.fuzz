```javascript
class DataProcessor {
  static async *fetchData(urls) {
    for (const url of urls) {
      const response = await fetch(url);
      if (response.ok) {
        yield response.json();
      } else {
        yield Promise.reject(`Failed to fetch data from ${url}`);
      }
    }
  }
}

(async () => {
  const urls = [
    'https://api.example.com/data1',
    'https://api.example.com/data2',
    'https://api.example.com/data3',
  ];
  
  try {
    const processData = async ({ name, value }) => {
      const dataValue = await value;
      console.log(`Processing: ${name}`, dataValue);
      return dataValue;
    };

    const promises = [];
    for await (const data of DataProcessor.fetchData(urls)) {
      promises.push(processData({ name: 'Item', value: data }));
    }

    const results = await Promise.all(promises);
    console.log('All data processed:', results);
  } catch (error) {
    console.error('Error processing data:', error);
  }
})();
```