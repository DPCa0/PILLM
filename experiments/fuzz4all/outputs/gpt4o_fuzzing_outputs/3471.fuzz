```javascript
class Matrix {
  constructor(rows, cols) {
    this.data = Array.from({ length: rows }, () => Array(cols).fill(0));
  }

  static from(array) {
    const matrix = new Matrix(array.length, array[0].length);
    matrix.map((_, i, j) => array[i][j]);
    return matrix;
  }

  map(fn) {
    return new Matrix(this.data.length, this.data[0].length).map((_, i, j) => {
      this.data[i][j] = fn(this.data[i][j], i, j);
      return this.data[i][j];
    });
  }

  add(matrixB) {
    return this.map((value, i, j) => value + matrixB.data[i][j]);
  }

  multiply(matrixB) {
    if (this.data[0].length !== matrixB.data.length) {
      throw new Error('Matrix dimensions must match for multiplication.');
    }
    return new Matrix(this.data.length, matrixB.data[0].length).map((_, i, j) =>
      this.data[i].reduce((sum, el, k) => sum + el * matrixB.data[k][j], 0)
    );
  }

  toString() {
    return this.data.map(row => row.join(' ')).join('\n');
  }
}

 
const handler = {
  get(target, prop, receiver) {
    if (prop in target) {
      return Reflect.get(target, prop, receiver);
    } else {
      console.warn(`Property ${prop} doesn't exist on the matrix object.`);
      return undefined;
    }
  }
};

const matrixA = Matrix.from([
  [1, 2, 3],
  [4, 5, 6]
]);
const matrixB = Matrix.from([
  [7, 8],
  [9, 10],
  [11, 12]
]);

const proxiedMatrixA = new Proxy(matrixA, handler);
const proxiedMatrixB = new Proxy(matrixB, handler);

try {
  const resultMatrix = proxiedMatrixA.multiply(proxiedMatrixB);
  console.log('Result of matrix multiplication:\n', resultMatrix.toString());
} catch (error) {
  console.error(error.message);
}

console.log(proxiedMatrixA.nonExistentProp);
```