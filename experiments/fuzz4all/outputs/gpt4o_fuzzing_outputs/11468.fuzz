```javascript
const fetchData = async (url) => {
    const response = await fetch(url);
    if (!response.ok) throw new Error('Network response was not ok');
    const data = await response.json();
    return data;
};

class DataProcessor {
    constructor(data) {
        this.data = data;
    }

    filterData(criteria) {
        return this.data.filter(item => Object.keys(criteria).every(key => item[key] === criteria[key]));
    }

    async processDataAsync(callback) {
        try {
            const result = await callback(this.data);
            console.log('Processed data:', result);
        } catch (error) {
            console.error('Error processing data:', error);
        }
    }
}

(async () => {
    const url = 'https://jsonplaceholder.typicode.com/posts';
    try {
        const rawData = await fetchData(url);
        
        const processor = new DataProcessor(rawData);
        const filteredData = processor.filterData({ userId: 1 });

        processor.processDataAsync(async (data) => {
             
            return new Promise((resolve) => {
                setTimeout(() => {
                    resolve(data.map(item => ({ id: item.id, title: item.title })));
                }, 1000);
            });
        });

    } catch (error) {
        console.error('Error fetching data:', error);
    }
})();
```