```javascript
 

class DataService {
    constructor(data) {
        this.data = data;
    }
    
    async fetchData() {
         
        return new Promise((resolve) => {
            setTimeout(() => resolve(this.data), 1000);
        });
    }
}

async function* dataProcessor(service) {
    const data = await service.fetchData();
    
     
    for (const { id, value } of data) {
        yield { id, result: value * 2 };
    }
}

(async () => {
    const sampleData = [
        { id: 1, value: 10 },
        { id: 2, value: 20 },
        { id: 3, value: 30 }
    ];

    const service = new DataService(sampleData);
    
    for await (const processedItem of dataProcessor(service)) {
        console.log(`Processed ID: ${processedItem.id}, Result: ${processedItem.result}`);
    }
})();
```