```javascript
 

 
const fetchData = async () => {
  return new Promise((resolve, reject) => {
    setTimeout(() => {
      resolve({
        id: 1,
        name: 'Advanced JavaScript',
        topics: ['Async/Await', 'Promises', 'Destructuring', 'Spread Operator'],
      });
    }, 1000);
  });
};

const processTopics = ({ topics }) => {
   
  const [firstTopic, ...restTopics] = topics;
  return `First Topic: ${firstTopic}\nOther Topics: ${restTopics.join(', ')}`;
};

 
(async () => {
  try {
    const data = await fetchData();
    
     
    const { name } = data;
    console.log(`Course Name: ${name}`);
    
    const topicsSummary = processTopics(data);
    console.log(topicsSummary);
  } catch (error) {
    console.error('An error occurred:', error);
  }
})();
```