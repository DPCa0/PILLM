```javascript
 

 
const createValidatedObject = (obj, validator) => {
    return new Proxy(obj, {
        set(target, property, value) {
            if (validator[property]) {
                if (!validator[property](value)) {
                    throw new Error(`Invalid value ${value} for property ${property}`);
                }
            }
            target[property] = value;
            return true;
        }
    });
};

const personValidator = {
    age: value => typeof value === 'number' && value > 0,
    name: value => typeof value === 'string' && value.length > 0,
};

const person = createValidatedObject({}, personValidator);

 
Reflect.set(person, 'name', 'Alice');
Reflect.set(person, 'age', 30);

try {
    Reflect.set(person, 'age', -5);
} catch (e) {
    console.error(e.message);
}

 
const hiddenProperty = Symbol('hidden');

const obj = {
    visible: 'I am visible',
    [hiddenProperty]: 'I am hidden',
};

 
const [first, second, ...rest] = [1, 2, 3, 4, 5];

 
function* fibonacci(limit) {
    let [prev, curr] = [0, 1];
    for (let i = 0; i < limit; i++) {
        yield curr;
        [prev, curr] = [curr, prev + curr];
    }
}

const fibGen = fibonacci(5);
for (const num of fibGen) {
    console.log(num);
}

 
const asyncFunction = async () => {
    try {
        const response = await fetch('https://jsonplaceholder.typicode.com/posts/1');
        const data = await response.json();
        console.log(data);
    } catch (error) {
        console.error('Fetch error:', error);
    }
};

asyncFunction();
